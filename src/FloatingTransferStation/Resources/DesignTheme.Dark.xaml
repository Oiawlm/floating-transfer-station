<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
  <SolidColorBrush x:Key="WindowShellBrush" Color="#CC202021" />
  <SolidColorBrush x:Key="WindowShellOpaqueBrush" Color="#202021" />
  <SolidColorBrush x:Key="TabRailBrush" Color="#2B2B2C" />
  <SolidColorBrush x:Key="CardBrush" Color="#2D2D2E" />
  <SolidColorBrush x:Key="BorderBrush" Color="#414143" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C8C8CA" />
  <SolidColorBrush x:Key="AccentBrush" Color="#9C8CFF" />
  <SolidColorBrush x:Key="DangerBrush" Color="#FF8A7A" />
  <SolidColorBrush x:Key="HeaderBrush" Color="#272728" />
  <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#343436" />
  <SolidColorBrush x:Key="HoverBorderBrush" Color="#505053" />
  <SolidColorBrush x:Key="SelectedCardBrush" Color="#343054" />
  <SolidColorBrush x:Key="SelectedCardBorderBrush" Color="#7A6DF2" />
  <SolidColorBrush x:Key="ActiveCategoryBrush" Color="#3A3560" />
  <SolidColorBrush x:Key="DropTargetBrush" Color="#322E52" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#505054" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6E6E74" />
  <SolidColorBrush x:Key="StatusSurfaceBrush" Color="#282829" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
  <DropShadowEffect x:Key="CardShadowEffect"
                    BlurRadius="8"
                    ShadowDepth="2"
                    Direction="270"
                    Opacity="0.35"
                    Color="#000000"
                    po:Freeze="True" />
</ResourceDictionary>
