<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
  <SolidColorBrush x:Key="WindowShellBrush" Color="#F7F8FA" />
  <SolidColorBrush x:Key="TabRailBrush" Color="#EFF1F4" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BorderBrush" Color="#E2E5EA" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1D1D1F" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5F6368" />
  <SolidColorBrush x:Key="AccentBrush" Color="#6D5DFB" />
  <SolidColorBrush x:Key="DangerBrush" Color="#D92D20" />
  <SolidColorBrush x:Key="HeaderBrush" Color="#FBFBFC" />
  <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#F4F5F7" />
  <SolidColorBrush x:Key="HoverBorderBrush" Color="#C9CDD5" />
  <SolidColorBrush x:Key="SelectedCardBrush" Color="#F3F1FF" />
  <SolidColorBrush x:Key="SelectedCardBorderBrush" Color="#8B7CF6" />
  <SolidColorBrush x:Key="ActiveCategoryBrush" Color="#E7E4FF" />
  <SolidColorBrush x:Key="DropTargetBrush" Color="#EAE7FF" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B8BDC7" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#969CA7" />
  <SolidColorBrush x:Key="StatusSurfaceBrush" Color="#FCFCFD" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
  <DropShadowEffect x:Key="CardShadowEffect"
                    BlurRadius="8"
                    ShadowDepth="2"
                    Direction="270"
                    Opacity="0.12"
                    Color="#1D1D1F"
                    po:Freeze="True" />
</ResourceDictionary>
