<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:FloatingTransferStation.Converters"
                    xmlns:design="clr-namespace:FloatingTransferStation.Design;assembly=FloatingTransferStation.Core"
                    xmlns:models="clr-namespace:FloatingTransferStation.Models;assembly=FloatingTransferStation.Core"
                    xmlns:views="clr-namespace:FloatingTransferStation.Views"
                    xmlns:controls="clr-namespace:FloatingTransferStation.Controls">
  <!-- 颜色画刷与卡片阴影定义在 Resources/DesignTheme.Light.xaml 与 DesignTheme.Dark.xaml，
       由 DesignThemeManager 在运行时整体替换；本字典内一律以 DynamicResource 引用。 -->
  <FontFamily x:Key="InterfaceFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
  <GridLength x:Key="CardOperationColumnWidth">30</GridLength>
  <!-- 文字卡正文右侧排他内缩（派生资源，唯一数值来源）：四列 CardOperationColumnWidth
       （备注/置顶/选择/删除按钮条）+ 4 DIP 间隙。对半分区的内容视觉层全宽、按钮悬停才淡入，
       正文不内缩就会与角按钮条争用同一批像素（1.20.0 两列，1.24.0 三列，1.29.0 随添加
       备注按钮扩为四列）；命中层与图片卡不受影响。静态值（不随悬停派生）：按钮显隐
       若牵动正文回流会造成布局抖动，已否决按卡动态内缩。 -->
  <Thickness x:Key="CardTextReservedRightInset" Left="0" Top="0" Right="124" Bottom="0" />
  <CornerRadius x:Key="ShellCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="HeaderActionCornerRadius">7</CornerRadius>
  <CornerRadius x:Key="PinButtonCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="SelectedCountBadgeCornerRadius">7</CornerRadius>
  <converters:BooleanOrConverter x:Key="BooleanOrConverter" />
  <converters:NonEmptyTextConverter x:Key="NonEmptyTextConverter" />

  <ControlTemplate x:Key="TransparentThumbTemplate" TargetType="Thumb">
    <Border Background="{TemplateBinding Background}" />
  </ControlTemplate>

  <Style x:Key="WindowShellStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource WindowShellBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadius}" />
  </Style>

  <Style x:Key="WindowShellOutlineStyle" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1,1,0,1" />
    <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadius}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="HeaderSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
    <Setter Property="CornerRadius" Value="11,0,0,0" />
  </Style>

  <Style x:Key="RailSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource TabRailBrush}" />
  </Style>

  <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="HeaderActionsHostStyle" TargetType="StackPanel">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ActionSurface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource HeaderActionCornerRadius}">
            <Grid>
              <Border x:Name="HoverLayer"
                      Background="{DynamicResource HoverSurfaceBrush}"
                      BorderBrush="{DynamicResource HoverBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource HeaderActionCornerRadius}"
                      Opacity="0"
                      IsHitTestVisible="False"
                      views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                      views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                      views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
              <Border x:Name="PressedLayer"
                      Background="{DynamicResource ActiveCategoryBrush}"
                      CornerRadius="{StaticResource HeaderActionCornerRadius}"
                      Opacity="0"
                      IsHitTestVisible="False"
                      views:FadeAnimation.IsActive="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                      views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                      views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.PressFeedbackMs}" />
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 两窗共享的主题控件样式（单一事实来源）：主窗与设置窗都 merge 本字典，
       颜色一律走 DynamicResource 主题键，随 DesignTheme.*.xaml 整本替换重解析。
       样式不放 DesignTheme.*.xaml——那是会被整本替换的纯颜色字典，放样式等于双份。 -->

  <!-- 常规文字输入框：纯 Setter 版（默认模板自带 PART_ContentHost，不自绘）。
       Foreground/CaretBrush/SelectionBrush 补齐主题缺口；SelectionTextBrush 有意不设：
       沿用系统默认的「强调色选区 + 白字」语义（与 OnAccentBrush 约定一致），
       主题样式若再固定选区文字颜色，深浅两套强调色下必有一套对比失效。 -->
  <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 常规操作按钮（设置窗原 SettingsActionButtonStyle 提升，两窗共用）：
       自绘模板脱离 Aero2 系统画刷，禁用态压暗。 -->
  <Style x:Key="ThemedActionButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 导航按钮（复盘 ‹ › 等）：动作按钮的小方块形态。Focusable 必须为 True——
       键盘可达性与既有回归（复盘失焦恢复收起）都依赖按钮能接收焦点，
       与头部动作按钮（装饰性、不可聚焦）不同。 -->
  <Style x:Key="ThemedNavButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedActionButtonStyle}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Focusable" Value="True" />
  </Style>

  <!-- 搜索类型 chip（ToggleButton）：Aero2 默认模板用系统画刷渲染 chrome、
       忽略主题 Background，必须自绘模板；选中态进入主题强调体系。 -->
  <Style x:Key="ThemedFilterChipStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="5">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 常规下拉框（设置窗原 ThemedComboBoxStyle 提升，两窗共用）：
       命中层必须置顶、PART_Popup 与 IsDropDownOpen 双向同步，注释见模板内。 -->
  <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemSurface"
                        Background="Transparent"
                        Padding="10,7"
                        CornerRadius="4"
                        Margin="4,2">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  Margin="10,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />
                <Path Grid.Column="1"
                      Data="M 0 0 L 4 4 L 8 0"
                      Stroke="{DynamicResource SecondaryTextBrush}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False" />
              </Grid>
            </Border>
            <!-- 命中层必须在最顶：不透明 Surface 在上会拦截全部鼠标命中，
                 ToggleButton 收不到点击、下拉无法用鼠标打开。 -->
            <ToggleButton Focusable="False"
                          ClickMode="Press"
                          Background="Transparent"
                          BorderThickness="0"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <!-- PART_Popup + 双向 IsOpen：StaysOpen=False 自行关闭时由部件名与绑定同步回 IsDropDownOpen，
                 避免关闭后状态失步（下次点击变成空操作、需点第二次）。 -->
            <Popup x:Name="PART_Popup"
                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False">
              <Border Background="{DynamicResource HeaderBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Margin="0,3,0,0"
                      MinWidth="{TemplateBinding ActualWidth}">
                <ScrollViewer MaxHeight="150">
                  <ItemsPresenter Margin="2" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CategoryTabContainerStyle" TargetType="Border">
    <Setter Property="Margin" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CategoryActiveLayerStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="views:CategoryFeedbackAnimation.IsActive" Value="{Binding IsActive}" />
    <Setter Property="views:CategoryFeedbackAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
  </Style>

  <Style x:Key="CategoryDropTargetLayerStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource DropTargetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="views:FadeAnimation.IsActive" Value="{Binding IsDropTarget}" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
  </Style>

  <Style x:Key="CategoryActiveMarkerStyle" TargetType="Border">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="22" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="0,2,2,0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="views:CategoryFeedbackAnimation.IsActive" Value="{Binding IsActive}" />
    <Setter Property="views:CategoryFeedbackAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
  </Style>

  <Style x:Key="CategoryDefaultMarkerStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,3,4,0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Panel.ZIndex" Value="1" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsDefaultCapture}" Value="True">
        <Setter Property="Opacity" Value="1" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CategoryLabelTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsEditingName}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsActive}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CategoryNameEditorStyle" TargetType="TextBox">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="5" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="False" />
    <Setter Property="ToolTip" Value="编辑分类名称" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsEditingName}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 卡片就地编辑器（1.22.0 起编辑器移入卡片 DataTemplate 原位切换，取代浮层）：
       与显示态 TextBlock 同度量——FontSize 14、Wrap、Display 像素对齐、
       InterfaceFontFamily、零内边距，宽度经同样的 CardTextReservedRightInset 右避让
      （显示态的同一内缩只在文字态触发，而编辑仅对文字态开放，条件天然一致）；
       背景默认卡片底色、实例上绑定卡面实际底色（跟随选中态），不透明盖写同区域
       显示文本（显示态保持可见、卡片高度恒定不随草稿塌缩，也不盖邻卡；全文超出
       有界预览时编辑态以 MaxHeight=100 为共同上限，卡片至多长到显示态同款上限）；
       无独立圆角/阴影。行距取输入字体自然度量——TextBox 不暴露
       LineHeight/LineStackingStrategy（WPF 平台约束），多行编辑的行距与显示态存在
       ≤1.5px/行的字体度量差，水平度量与宽度完全一致。滚动条 Hidden：溢出内容可滚
       但不占内容宽，编辑态换行宽度与显示态一致。可见性由条目 IsEditing 驱动（状态
       挂在条目上，虚拟化回收不错乱）。焦点提示在卡片级 accent 细环（模板内
       CardEditingRingLayer），不在文字盒上加边。 -->
  <Style x:Key="CardTextEditorStyle" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="False" />
    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
    <Setter Property="MaxHeight" Value="100" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsEditing}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 备注编辑器（1.28.0，契约 #22）：度量与备注显示行同族（字号 12、行高 20、
       最多 2 行 MaxHeight=40），MaxLength=120 是备注上限唯一来源（模型侧不重复
       钳制）。CardBrush 不透明衬底=编辑器盖写先例：覆盖正文前 1-2 行（备注编辑
       由交互条进入），卡片高度不变（截断卡正文区 DesiredHeight=100 ≥ 40）。
       可见性由条目 IsEditingNote 驱动（状态挂条目，虚拟化回收不错乱），键位与
       失焦经窗口级路由事件挂接，与正文编辑器共用同一会话机器。 -->
  <Style x:Key="CardNoteEditorStyle" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="False" />
    <Setter Property="MaxLength" Value="120" />
    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="MaxHeight" Value="40" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="AutomationProperties.Name" Value="备注" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsEditingNote}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 备注点击面（1.28.0，契约 #22）：已有备注的卡片上覆盖备注行左半的透明
       命中面（卡片模板命中层之上=真实输入可点，契约 #13；命中层让位会顶下
       右上三钮破坏 #19 几何，故在按钮层实现）。唯一备注编辑入口：左键绝不
       toggle 选中；右键语义与既有命中层分区一致（面只出现在左半位置）。无
       视觉（备注文本由下方显示行承载，ToolTip=全文借面显示——显示行自身
       IsHitTestVisible=false 承载不了悬停）。仅备注存在且无会话进行中可命中。 -->
  <Style x:Key="CardNoteEntryHitStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Note, Converter={StaticResource NonEmptyTextConverter}}" Value="True" />
          <Condition Binding="{Binding IsEditingNote}" Value="False" />
          <Condition Binding="{Binding IsEditing}" Value="False" />
          <Condition Binding="{Binding DataContext.IsSearchActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 备注幽灵入口（1.28.0，契约 #22）已于 1.29.0 移除：添加备注入口整件迁入
       卡片右上操作条最左列（NoteButtonStyle，见删除钮样式之后的备注钮节）——
       幽灵标签与正文文字重叠的根因（同格叠加盖写）随入口移除而消除；
       备注显示行、点击面与编辑会话语义零变化。 -->

  <Style x:Key="BoardListStyle" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4" />
  </Style>

  <Style x:Key="BoardListItemStyle" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 卡片根容器：承载外距、分区起始于普通区的额外上距与悬停上浮（渲染位移），
       自身不携带 Effect，避免整棵子树进入 Effect 中间位图。 -->
  <Style x:Key="CardRootStyle" TargetType="Grid">
    <Setter Property="Margin" Value="12,4" />
    <Setter Property="views:LiftAnimation.IsActive"
            Value="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
    <Setter Property="views:LiftAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding StartsNormalRegion}" Value="True">
        <Setter Property="Margin" Value="12,10,12,4" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 阴影层：不承载内容、不参与命中，仅以与卡片同形状的不透明底把投影绘制在
       文字子树之外——带 Effect 的元素会把整个子树渲染进中间位图并强制关闭
       ClearType（卡片正文发糊主因）。 -->
  <Style x:Key="CardShadowLayerStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="Effect" Value="{DynamicResource CardShadowEffect}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="CardContainerStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsKeyboardFocusWithin}"
                   Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SelectionButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Visible" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="views:FadeAnimation.IsActive">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource BooleanOrConverter}">
          <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType={x:Type ListBoxItem}}" />
          <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType={x:Type ListBoxItem}}" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Width="30" Height="30" Background="Transparent">
            <Border x:Name="SelectionSurface"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="{DynamicResource SecondaryTextBrush}"
                    BorderThickness="1.5"
                    CornerRadius="5" />
            <Border x:Name="SelectionHoverRing"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="5"
                    Opacity="0"
                    IsHitTestVisible="False"
                    views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                    views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                    views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
            <Border x:Name="SelectionSelectedFill"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="5"
                    Opacity="0"
                    IsHitTestVisible="False"
                    views:FadeAnimation.IsActive="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                    views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                    views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FadeVisibilityMs}" />
            <Path x:Name="SelectionCheck"
                  Width="9"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M1,3.5 L3.5,6 L8,1"
                  Stroke="{DynamicResource OnAccentBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Stretch="Fill"
                  Opacity="0"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FadeVisibilityMs}"
                  views:FadeAnimation.ManageVisibility="True" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}"
                   Value="True">
        <Setter Property="IsHitTestVisible" Value="True" />
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}"
                   Value="True">
        <Setter Property="IsHitTestVisible" Value="True" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 卡片操作条图标按钮的共享模板（1.24.0 自置顶按钮模板提取，删除按钮共用）：
       悬停表面/按压表面/悬停强调色为通用交互反馈，可见性由各样式层的状态矩阵
       触发器（FadeAnimation.IsActive + IsHitTestVisible）驱动。 -->
  <ControlTemplate x:Key="CardIconButtonTemplate" TargetType="Button">
    <Border x:Name="CardIconButtonSurface"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource PinButtonCornerRadius}">
      <Grid>
        <Border x:Name="HoverLayer"
                Background="{DynamicResource HoverSurfaceBrush}"
                CornerRadius="{StaticResource PinButtonCornerRadius}"
                Opacity="0"
                IsHitTestVisible="False"
                views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
        <Border x:Name="PressedLayer"
                Background="{DynamicResource ActiveCategoryBrush}"
                CornerRadius="{StaticResource PinButtonCornerRadius}"
                Opacity="0"
                IsHitTestVisible="False"
                views:FadeAnimation.IsActive="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.PressFeedbackMs}" />
        <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- 状态徽章模板（1.24.0，契约 #19）：选中已置顶卡片的置顶钮换用本模板——
       纯展示、无悬停/按压反馈；按钮保持启用且可命中（禁用元素在 WPF 下不可
       命中，点击会穿透到右半选择手势），点击的语义失效由
       ToggleCardPinAsync 的状态矩阵守卫统一实现（真实输入与合成/UIA 路径
       共用同一条守卫）。 -->
  <ControlTemplate x:Key="CardStatusBadgeTemplate" TargetType="Button">
    <Border Background="Transparent"
            CornerRadius="{StaticResource PinButtonCornerRadius}">
      <ContentPresenter HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
    </Border>
  </ControlTemplate>

  <!-- 卡片操作按钮可见性状态矩阵（契约 #19，唯一权威=docs/design-contracts.md）：
       信号 = (悬停 IsMouseOver, 选中 IsSelected, 置顶 IsPinned)。
       置顶钮：可见/可命中 = IsPinned ∨ (悬停 ∧ 未选中)；
               选中时换纯展示徽章模板并以次文字色呈现（点击由
               ToggleCardPinAsync 守卫失效——不改置顶、不改选中）；
               ToolTip 随选中态指向批量入口（触发器排在 IsPinned 之后，
               徽章态文案生效）。 -->
  <Style x:Key="PinButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Visible" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ToolTip" Value="置顶" />
    <Setter Property="AutomationProperties.Name" Value="置顶或取消置顶" />
    <Setter Property="Template" Value="{StaticResource CardIconButtonTemplate}" />
    <Setter Property="views:FadeAnimation.IsActive" Value="False" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsPinned}" Value="True">
        <Setter Property="views:FadeAnimation.IsActive" Value="True" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="ToolTip" Value="取消置顶" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
          <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="False" />
        </MultiDataTrigger.Conditions>
        <Setter Property="views:FadeAnimation.IsActive" Value="True" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
        <Setter Property="Template" Value="{StaticResource CardStatusBadgeTemplate}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="ToolTip" Value="多选中，用顶部按钮操作" />
        <Setter Property="AutomationProperties.Name" Value="已置顶状态徽章（多选中，用顶部按钮操作）" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 删除钮（1.24.0 新增）：可见/可命中 = 悬停 ∧ 未选中——仅未选中卡片悬停时
       淡入，选中卡片一律隐藏（含悬停时），删除走单卡撤销管线；语义实现见
       MainWindow.CardGestures 的 OperationsDelete 会话与 DeleteSingleCardAsync。 -->
  <Style x:Key="DeleteButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Visible" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ToolTip" Value="删除" />
    <Setter Property="Template" Value="{StaticResource CardIconButtonTemplate}" />
    <Setter Property="views:FadeAnimation.IsActive" Value="False" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
          <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="False" />
        </MultiDataTrigger.Conditions>
        <Setter Property="views:FadeAnimation.IsActive" Value="True" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 添加备注钮（1.29.0，契约 #22 修订，记录 Issue #98）：卡片右上操作条最左列
       （备注|置顶|选择|删除），聊天气泡 16×16 Path 自 1.28.0 幽灵入口迁移复用，
       ToolTip/AutomationName 沿用幽灵样式既有值。可见性=幽灵入口七条件原样迁移
       （无备注 ∧ 正文截断 ∧ 卡片悬停 ∧ 无正文编辑 ∧ 无备注编辑 ∧ 文字卡 ∧ 非搜索态；
       ElementName=CardPreviewText 与条目属性绑定同模板 namescope 原样可用）。
       隐藏必须是布局塌缩语义：基态 Visibility=Collapsed + 列定义 Auto——不可见时
       列宽归零、按钮条贴右缘回落三钮几何（禁止纯 Opacity 隐藏：opacity 不释放
       布局会让置顶/选择/删除三钮漂移）；FadeAnimation.ManageVisibility 承载
       激活即 Visible、失活动画完成后 Collapsed、动效关闭立即切。 -->
  <Style x:Key="NoteButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ToolTip" Value="添加备注" />
    <Setter Property="AutomationProperties.Name" Value="备注" />
    <Setter Property="Template" Value="{StaticResource CardIconButtonTemplate}" />
    <Setter Property="views:FadeAnimation.IsActive" Value="False" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
    <Setter Property="views:FadeAnimation.ManageVisibility" Value="True" />
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Note, Converter={StaticResource NonEmptyTextConverter}}" Value="False" />
          <Condition Binding="{Binding IsTruncated, ElementName=CardPreviewText}" Value="True" />
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
          <Condition Binding="{Binding IsEditing}" Value="False" />
          <Condition Binding="{Binding IsEditingNote}" Value="False" />
          <Condition Binding="{Binding Kind}" Value="{x:Static models:BoardItemKind.Text}" />
          <Condition Binding="{Binding DataContext.IsSearchActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
        </MultiDataTrigger.Conditions>
        <Setter Property="views:FadeAnimation.IsActive" Value="True" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="StatusOverlayStyle" TargetType="Border">
    <Setter Property="Margin" Value="12" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Background" Value="{DynamicResource StatusSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="views:FadeAnimation.IsActive"
            Value="{Binding StatusText, Converter={StaticResource NonEmptyTextConverter}}" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
    <Setter Property="views:FadeAnimation.ManageVisibility" Value="True" />
  </Style>

  <Style x:Key="StatusTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CompactStatusPopupStyle" TargetType="Border">
    <Setter Property="MaxWidth" Value="260" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="views:FadeAnimation.IsActive"
            Value="{Binding StatusText, Converter={StaticResource NonEmptyTextConverter}}" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
  </Style>

  <Style x:Key="HeaderThumbStyle" TargetType="Thumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeNS" />
    <Setter Property="Template" Value="{StaticResource TransparentThumbTemplate}" />
  </Style>

  <Style x:Key="WidthResizeThumbStyle" TargetType="Thumb">
    <Setter Property="Width" Value="7" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template" Value="{StaticResource TransparentThumbTemplate}" />
  </Style>

  <Style x:Key="HeightResizeThumbStyle" TargetType="Thumb">
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Cursor" Value="SizeNS" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template" Value="{StaticResource TransparentThumbTemplate}" />
  </Style>

  <Style x:Key="TransparentScrollRepeatButtonStyle" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SlimScrollThumbStyle" TargetType="Thumb">
    <Setter Property="Width" Value="4" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <Border x:Name="ThumbSurface"
                    Background="{TemplateBinding Background}"
                    CornerRadius="2" />
            <Border x:Name="ThumbHoverLayer"
                    Width="6"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource ScrollThumbHoverBrush}"
                    CornerRadius="3"
                    Opacity="0"
                    IsHitTestVisible="False"
                    views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                    views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                    views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Width="8" Background="Transparent">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="True"
                   Orientation="Vertical">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                              Style="{StaticResource TransparentScrollRepeatButtonStyle}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SlimScrollThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                              Style="{StaticResource TransparentScrollRepeatButtonStyle}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- BoardList 专用 overlay ScrollViewer 模板（keyed；经 MainWindow.xaml BoardList.Resources
       的作用域隐式样式挂接，仅作用于该列表内部生成的 ScrollViewer）。单格叠加：垂直滚动条
       与内容同格、右缘悬浮其上，不占布局列——viewport 几何与滚动条可见性解耦，卡片几何
       不再随滚动条出现/消失漂移（默认模板的 Auto 独立列 + 系统滚动条宽度下限是漂移
       根因，出现/消失会在全宽与全宽−17.33 DIP 间跳变；条带 MinWidth/MinHeight=0 压掉
       主题 ScrollBar 样式的系统尺寸下限，瘦条宽 8 由既有隐式 ScrollBar 样式给出）。
       三个 PART_* 命名部件与
       透传绑定缺一不可：CanContentScroll 是虚拟化与键盘滚动的生命线；两向 ScrollBarVisibility
       保留 Auto 语义（需要时才出现，只是不再改变 viewport 宽）；不引入自动隐藏定时器。 -->
  <Style x:Key="OverlayScrollViewerStyle" TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                    CanHorizontallyScroll="False"
                                    CanVerticallyScroll="False"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Content="{TemplateBinding Content}"
                                    Margin="{TemplateBinding Padding}" />
            <ScrollBar x:Name="PART_VerticalScrollBar"
                       Orientation="Vertical"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Stretch"
                       MinWidth="0"
                       Minimum="0"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            <ScrollBar x:Name="PART_HorizontalScrollBar"
                       Orientation="Horizontal"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Bottom"
                       MinHeight="0"
                       Minimum="0"
                       Maximum="{TemplateBinding ScrollableWidth}"
                       ViewportSize="{TemplateBinding ViewportWidth}"
                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate DataType="{x:Type models:BoardItem}">
    <Grid Style="{StaticResource CardRootStyle}">
      <Border Style="{StaticResource CardShadowLayerStyle}" />
      <Border Style="{StaticResource CardContainerStyle}">
        <Grid Background="Transparent">
          <Border x:Name="CardHoverFillLayer"
                  Background="{DynamicResource HoverSurfaceBrush}"
                  CornerRadius="7"
                  Opacity="0"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
          <Border x:Name="CardHoverRingLayer"
                  BorderBrush="{DynamicResource HoverBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Margin="-1"
                  Opacity="0"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
          <Border x:Name="CardSelectedFillLayer"
                  Background="{DynamicResource SelectedCardBrush}"
                  CornerRadius="7"
                  Opacity="0"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FadeVisibilityMs}" />
          <Border x:Name="CardSelectedRingLayer"
                  BorderBrush="{DynamicResource SelectedCardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Margin="-1"
                  Opacity="0"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FadeVisibilityMs}" />
          <!-- 编辑环（1.22.0）：就地编辑的焦点提示=accent 细环，绑定条目 IsEditing——
               会话在窗口内焦点迁移期间持续（契约：焦点迁移不终结编辑），环与之一致；
               迟于选中环声明，两者同为编辑/选中叠加时编辑环在上。 -->
          <Border x:Name="CardEditingRingLayer"
                  BorderBrush="{DynamicResource AccentBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Margin="-1"
                  Opacity="0"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsEditing}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FadeVisibilityMs}" />

          <!-- 1.18.0 对半分区：内容视觉层全宽在下（图片/文字横贯整卡），
               其上叠加两列 * /* 的命中层（CardGestureZones）承载左右对半的
               手势判定——区域=元素身份，星号布局自动对半实际宽度（DPI 无关）。
               右半右上角保留既有置顶/选择按钮（命中层子元素，按钮命中走按钮分支）。
               卡片 12px 边缘环带不经过命中层，仍按默认归左半（贴边点击承载拖拽）。
               1.28.0 起网格分两行：行 0=备注显示行（Note 非空时占行撑高卡片），
               行 1=内容视觉层；命中层与备注可点元素跨两行（备注行区域手势
               分区不变：左半无选择语义、右半 toggle/复制）。 -->
          <Grid Margin="12" Background="Transparent">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 备注显示行（1.28.0，契约 #22）：在流纯展示（IsHitTestVisible=false，
                 点击由上方备注交互条承接）——Note 非空时占行撑高卡片，常显不随
                 hover 变化、无高度跳变；正文后来变短仍常显（备注是用户数据，不随
                 正文变短而消失）。次级文字色、字号 12、最多 2 行（MaxHeight=40 +
                 省略号，与正文同一限高机制）；右让位复用 CardTextReservedRightInset
                 （#16 派生资源，不发明第二个数值）；浅/深主题走主题字典画刷。
                 布局必须是 Grid（Auto 图标列 + * 文本列）：水平 StackPanel 会给
                 子元素无限宽度约束，Wrap/省略号/MaxHeight 全部失效（T7 评审 B1）。 -->
            <Grid x:Name="NoteDisplayRow"
                  Grid.Row="0"
                  Margin="{StaticResource CardTextReservedRightInset}"
                  IsHitTestVisible="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Note, Converter={StaticResource NonEmptyTextConverter}}"
                                 Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Viewbox Grid.Column="0"
                       Width="16"
                       Height="16"
                       Margin="0,2,5,0"
                       VerticalAlignment="Top">
                <Path Data="M3,2.75 L13,2.75 C13.9665,2.75 14.75,3.5335 14.75,4.5 L14.75,9.5 C14.75,10.4665 13.9665,11.25 13,11.25 L8.2,11.25 L5.35,13.9 C5.05,14.18 4.75,14.06 4.75,13.6 L4.75,11.25 L3,11.25 C2.0335,11.25 1.25,10.4665 1.25,9.5 L1.25,4.5 C1.25,3.5335 2.0335,2.75 3,2.75 Z"
                      Stroke="{DynamicResource SecondaryTextBrush}"
                      StrokeThickness="1.3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
              </Viewbox>
              <TextBlock Grid.Column="1"
                         Text="{Binding Note}"
                         FontFamily="{StaticResource InterfaceFontFamily}"
                         FontSize="12"
                         FontWeight="Normal"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         TextOptions.TextFormattingMode="Display"
                         TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis"
                         LineHeight="20"
                         LineStackingStrategy="BlockLineHeight"
                         MaxHeight="40" />
            </Grid>

            <Grid Grid.Row="1" Background="Transparent">
              <controls:AsyncThumbnailImage Height="120"
                     SourcePath="{Binding ImageAbsolutePath}"
                     Stretch="Uniform">
                <Image.Style>
                  <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}"
                                   Value="{x:Static models:BoardItemKind.Image}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Image.Style>
              </controls:AsyncThumbnailImage>

              <!-- 1.28.0：TrimAwareTextBlock（Decorator 承载——TextBlock.MeasureOverride
                   密封不可子类化，见控件实现）暴露 IsTruncated（渲染布局事实），是
                   「添加备注」入口的唯一判据（1.29.0 起入口在右上操作条）；MaxHeight=100
                   只声明在承载元素上（限高唯一来源，子元素不得重复声明）。文字卡可见性
                   与右让位触发器上移到承载元素（布局属性），子 TextBlock 只承载文字排版。 -->
              <controls:TrimAwareTextBlock x:Name="CardPreviewText" MaxHeight="100">
                <controls:TrimAwareTextBlock.Style>
                  <Style TargetType="controls:TrimAwareTextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}"
                                   Value="{x:Static models:BoardItemKind.Text}">
                        <Setter Property="Visibility" Value="Visible" />
                        <!-- 仅文字态右侧内缩：为右上角操作按钮条预留排他空间（派生资源，
                             见 CardTextReservedRightInset），换行与省略在按钮条左缘之前完成。 -->
                        <Setter Property="Margin"
                                Value="{StaticResource CardTextReservedRightInset}" />
                      </DataTrigger>
                      <!-- 编辑期间显示态保持可见（不隐藏、高度恒定）：编辑器以卡片底色
                           不透明盖写同一区域，两态像素重合，卡片高度不随草稿塌缩。 -->
                    </Style.Triggers>
                  </Style>
                </controls:TrimAwareTextBlock.Style>
                <TextBlock Text="{Binding PreviewText}"
                           FontFamily="{StaticResource InterfaceFontFamily}"
                           FontSize="14"
                           FontWeight="Normal"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextOptions.TextFormattingMode="Display"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           LineHeight="20"
                           LineStackingStrategy="BlockLineHeight" />
              </controls:TrimAwareTextBlock>
            </Grid>

            <Grid Grid.RowSpan="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0"
                    Background="Transparent"
                    Tag="{x:Static views:CardGestureZones.ContentZone}" />

              <Grid Grid.Column="1"
                    Background="Transparent"
                    Tag="{x:Static views:CardGestureZones.OperationsZone}">
                <Grid HorizontalAlignment="Right"
                      VerticalAlignment="Top">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{StaticResource CardOperationColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource CardOperationColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource CardOperationColumnWidth}" />
                  </Grid.ColumnDefinitions>

                  <!-- 添加备注钮（1.29.0，契约 #22 修订）：最左列，几何向左生长——
                       置顶/选择/删除三钮位置与三钮时代逐像素一致；聊天气泡几何自
                       幽灵入口迁移。可见性七条件与塌缩语义见 NoteButtonStyle，
                       点击复用 NoteStripCommand 参数路由（手势层与 UIA 路径零改动）。 -->
                  <Button x:Name="CardOperationNoteButton"
                          Grid.Column="0"
                          Style="{StaticResource NoteButtonStyle}"
                          Tag="{Binding}"
                          CommandParameter="{x:Static views:CardGestureZones.NoteStripCommand}">
                    <Viewbox Width="16" Height="16">
                      <Path Data="M3,2.75 L13,2.75 C13.9665,2.75 14.75,3.5335 14.75,4.5 L14.75,9.5 C14.75,10.4665 13.9665,11.25 13,11.25 L8.2,11.25 L5.35,13.9 C5.05,14.18 4.75,14.06 4.75,13.6 L4.75,11.25 L3,11.25 C2.0335,11.25 1.25,10.4665 1.25,9.5 L1.25,4.5 C1.25,3.5335 2.0335,2.75 3,2.75 Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            Stretch="Uniform" />
                    </Viewbox>
                  </Button>

                  <Button Grid.Column="1"
                          Style="{StaticResource PinButtonStyle}"
                          Tag="{Binding}"
                          CommandParameter="{x:Static views:CardGestureZones.TogglePinCommand}">
                    <Viewbox Width="16" Height="16">
                      <Path Data="M10.1221,3.13715 C10.7326,1.91616 12.3599,1.65208 13.3251,2.61737 L17.382,6.67419 C18.3472,7.63947 18.0832,9.26676 16.8622,9.87726 L13.4037,11.6065 C13.0751,11.7708 12.8183,12.0499 12.6818,12.391 L11.2459,15.981 C10.9792,16.6476 10.1179,16.8244 9.61027,16.3167 L7,13.7064 L3.70711,16.9993 L3,17 L3,16.2922 L6.29289,12.9993 L3.68262,10.3891 C3.17498,9.88142 3.35177,9.02011 4.01834,8.75348 L7.60829,7.3175 C7.94939,7.18106 8.22855,6.92419 8.39285,6.5956 L10.1221,3.13715 Z M12.618,3.32447 C12.1354,2.84183 11.3167,2.97387 11.0165,3.58437 L9.28727,7.04282 C9.01345,7.59046 8.54818,8.01858 7.97968,8.24598 L4.38973,9.68196 L10.3174,15.6096 L11.7534,12.0197 C11.9808,11.4512 12.4028,10.9859 12.9565,10.7121 L16.415,8.98283 C17.1575,8.67758 17.2895,7.86394 16.6749,7.3813 L12.618,3.32447 Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            Stretch="Uniform" />
                    </Viewbox>
                  </Button>

                  <Button Grid.Column="2"
                          Style="{StaticResource SelectionButtonStyle}"
                          Tag="{Binding}"
                          CommandParameter="{x:Static views:CardGestureZones.ToggleSelectionCommand}"
                          ToolTip="选择"
                          AutomationProperties.Name="选择" />

                  <!-- 删除钮（1.24.0）：垃圾桶图标与头部垃圾桶按钮同一几何（16×16 网格
                       规范），前景随共享模板的悬停强调色；可见性矩阵见 DeleteButtonStyle。 -->
                  <Button Grid.Column="3"
                          Style="{StaticResource DeleteButtonStyle}"
                          Tag="{Binding}"
                          CommandParameter="{x:Static views:CardGestureZones.DeleteCardCommand}"
                          AutomationProperties.Name="删除">
                    <Viewbox Width="16" Height="16">
                      <Path Data="M8.5,4 L11.5,4 C11.5,3.17157 10.8284,2.5 10,2.5 C9.17157,2.5 8.5,3.17157 8.5,4 Z M7.5,4 C7.5,2.61929 8.61929,1.5 10,1.5 C11.3807,1.5 12.5,2.61929 12.5,4 L17.5,4 C17.7761,4 18,4.22386 18,4.5 C18,4.77614 17.7761,5 17.5,5 L16.4456,5 L15.2521,15.3439 C15.0774,16.8576 13.7957,18 12.2719,18 L7.72813,18 C6.20431,18 4.92256,16.8576 4.7479,15.3439 L3.55437,5 L2.5,5 C2.22386,5 2,4.77614 2,4.5 C2,4.22386 2.22386,4 2.5,4 L7.5,4 Z M5.74131,15.2292 C5.85775,16.2384 6.71225,17 7.72813,17 L12.2719,17 C13.2878,17 14.1422,16.2384 14.2587,15.2292 L15.439,5 L4.56101,5 Z M8.5,7.5 C8.77614,7.5 9,7.72386 9,8 L9,14 C9,14.2761 8.77614,14.5 8.5,14.5 C8.22386,14.5 8,14.2761 8,14 L8,8 C8,7.72386 8.22386,7.5 8.5,7.5 Z M12,8 C12,7.72386 11.7761,7.5 11.5,7.5 C11.2239,7.5 11,7.72386 11,8 L11,14 C11,14.2239 11.2239,14.5 11.5,14.5 C11.7761,14.5 12,14.2761 12,14 L12,8 Z"
