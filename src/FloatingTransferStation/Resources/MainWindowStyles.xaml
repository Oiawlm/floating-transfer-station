  </Style>

  <!-- 卡片就地编辑器（1.22.0 起编辑器移入卡片 DataTemplate 原位切换，取代浮层）：
       与显示态 TextBlock 同度量——FontSize 14、Wrap、Display 像素对齐、
       InterfaceFontFamily、零内边距，宽度经同样的 CardTextReservedRightInset 右避让
      （显示态的同一内缩只在文字态触发，而编辑仅对文字态开放，条件天然一致）；
       背景默认卡片底色、实例上绑定卡面实际底色（跟随选中态），不透明盖写同区域
       显示文本（显示态保持可见、卡片高度恒定不随草稿塌缩，也不盖邻卡；全文超出
       有界预览时编辑态以 MaxHeight=100 为共同上限，卡片至多长到显示态同款上限）；
       无独立圆角/阴影。行距与显示态同源：TextBlock.LineHeight/LineStackingStrategy
       以附加属性设在 TextBox 上生效（TextBox 自身不暴露这两个属性，但文本宿主按
       TextBlock 附加属性排版），值引用 CardTextLineHeight 单一资源——双击光标锚点
       的就近行映射要求两态行带逐像素对齐。滚动条 Hidden：溢出内容可滚
       但不占内容宽，编辑态换行宽度与显示态一致。可见性由条目 IsEditing 驱动（状态
       挂在条目上，虚拟化回收不错乱）。焦点提示在卡片级 accent 细环（模板内
       CardEditingRingLayer），不在文字盒上加边。 -->
  <Style x:Key="CardTextEditorStyle" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="{x:Static design:DesignTokens.CardTextFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource CardTextLineHeight}" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="AcceptsReturn" Value="False" />
    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
    <Setter Property="MaxHeight" Value="{DynamicResource CardTextPreviewMaxHeight}" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsEditing}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 备注编辑器（1.28.0，契约 #22；2026-10-12 起落位行 0 备注行原位同格）：
       度量与备注显示行同族（字号 12、行高 20、最多 2 行 MaxHeight=40），
       MaxLength=120 是备注上限唯一来源（模型侧不重复钳制）。CardBrush 不透明
       衬底=编辑器盖写先例：同格盖写备注显示文字（与显示 TextBlock 结构化同列
       对齐，见模板备注行 Grid 注释），显示态保持可见、卡片高度只随行 0 有界
       增长（≤2 行/40px）。行距经 TextBlock.LineHeight/LineStackingStrategy 附加
       属性进 TextBoxView（Inherits=true），与显示行精确同行距、消除字体度量差
       ——只在编辑器样式本地设置，不得提升到容器级（防继承泄漏），值引用
       CardTextLineHeight 单一资源（与正文编辑态/两处显示态同源，值不变仍为 20）。
       可见性由条目 IsEditingNote 驱动（状态挂条目，虚拟化回收不错乱），键位与
       失焦经窗口级路由事件挂接，与正文编辑器共用同一会话机器。 -->
  <Style x:Key="CardNoteEditorStyle" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextBlock.LineHeight" Value="{DynamicResource CardTextLineHeight}" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="False" />
    <Setter Property="MaxLength" Value="120" />
    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="MaxHeight" Value="{DynamicResource CardNoteMaxHeight}" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="AutomationProperties.Name" Value="备注" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsEditingNote}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 备注点击面（1.28.0，契约 #22）：已有备注的卡片上覆盖备注行左半的透明
       命中面（卡片模板命中层之上=真实输入可点，契约 #13；命中层让位会顶下
       右上三钮破坏 #19 几何，故在按钮层实现）。唯一备注编辑入口：左键绝不
       toggle 选中；右键语义与既有命中层分区一致（面只出现在左半位置）。无
       视觉（备注文本由下方显示行承载，ToolTip=全文借面显示——显示行自身
       IsHitTestVisible=false 承载不了悬停）。仅备注存在且无会话进行中可命中。 -->
  <Style x:Key="CardNoteEntryHitStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Note, Converter={StaticResource NonEmptyTextConverter}}" Value="True" />
          <Condition Binding="{Binding IsEditingNote}" Value="False" />
          <Condition Binding="{Binding IsEditing}" Value="False" />
          <Condition Binding="{Binding DataContext.IsSearchActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 备注幽灵入口（1.28.0，契约 #22）已于 1.29.0 移除：添加备注入口整件迁入
       卡片右上操作条（NoteButtonStyle，见删除钮样式之后的备注钮节；1.33.0 起固定
       于两列网格右下格 (1,1)，Issue #103）——幽灵标签与正文文字重叠的根因（同格
       叠加盖写）随入口移除而消除；备注显示行、点击面与编辑会话语义零变化。 -->

  <Style x:Key="BoardListStyle" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4" />
  </Style>

  <Style x:Key="BoardListItemStyle" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <!-- 根 Grid 背景透传：保持既有整条容器可命中（含分隔行 0 的间隙带）。 -->
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 置顶分区分隔元素（契约 #27）：宿主在容器模板行 0，与卡片同轴参与布局。
                 两轴正交——「边界可见性」由下方模板触发器按 StartsNormalRegion 驱动
                 （基态塌缩；Recycling 复用下触发器随 DataContext 重评，禁止代码后置
                 逐容器设状态）；「四态外观」由 Style 槽位资源经 DynamicResource 承载
                 （MainWindow 按偏好换装）。None 态以零高+空描边实现零渲染——即使
                 触发器命中也无任何像素与布局占位，边界卡外距与既有间距完全一致。 -->
            <Line x:Name="PinnedDivider"
                  Grid.Row="0"
                  X1="0" Y1="0" X2="1" Y2="0"
                  Stretch="Fill"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True"
                  IsHitTestVisible="False"
                  Visibility="Collapsed"
                  Style="{DynamicResource PinnedDividerActiveStyle}" />
            <Border Grid.Row="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding StartsNormalRegion}" Value="True">
              <Setter TargetName="PinnedDivider" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 置顶分区分隔的四态外观（契约 #27，默认实线）：槽位资源 PinnedDividerActiveStyle
       的候选样式集，MainWindow 按偏好把其中之一装进窗口级槽位（唯一换装管线
       ApplyPreferences）。行 0 与行 1 的呼吸空间：上方 4 DIP（末张置顶卡下距）
       + 8 DIP 上边距、下方 2 DIP 下边距 + 10 DIP（边界卡既有上距），两侧各
       12 DIP（Fluent Divider 节奏）；左右 12 DIP 与卡片外距对齐。None 态零高
       +空描边，触发器命中也不渲染（「无」= 升级前的纯间距观感）。 -->
  <Style x:Key="PinnedDividerNoneStyle" TargetType="Line">
    <Setter Property="Height" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Stroke" Value="{x:Null}" />
  </Style>

  <Style x:Key="PinnedDividerSolidStyle" TargetType="Line">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="12,8,12,2" />
    <Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>

  <Style x:Key="PinnedDividerDashedStyle" TargetType="Line">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="12,8,12,2" />
    <Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="4 3" />
  </Style>

  <Style x:Key="PinnedDividerAccentBarStyle" TargetType="Line">
    <Setter Property="Height" Value="2" />
    <Setter Property="Margin" Value="12,8,12,2" />
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>

  <!-- 槽位资源默认值（=Solid）：模板在未经 MainWindow 换装时也自洽，
       运行时由 ApplyPreferences 在窗口级装槽覆盖（同名键窗口级优先）。 -->
  <Style x:Key="PinnedDividerActiveStyle" TargetType="Line" BasedOn="{StaticResource PinnedDividerSolidStyle}" />

  <!-- 卡片根容器：承载外距、分区起始于普通区的额外上距与悬停上浮（渲染位移），
       自身不携带 Effect，避免整棵子树进入 Effect 中间位图。 -->
  <Style x:Key="CardRootStyle" TargetType="Grid">
    <Setter Property="Margin" Value="12,4" />
    <Setter Property="views:LiftAnimation.IsActive"
            Value="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
    <Setter Property="views:LiftAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding StartsNormalRegion}" Value="True">
        <Setter Property="Margin" Value="12,10,12,4" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 阴影层：不承载内容、不参与命中，仅以与卡片同形状的不透明底把投影绘制在
       文字子树之外——带 Effect 的元素会把整个子树渲染进中间位图并强制关闭
       ClearType（卡片正文发糊主因）。 -->
  <Style x:Key="CardShadowLayerStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="Effect" Value="{DynamicResource CardShadowEffect}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="CardContainerStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsKeyboardFocusWithin}"
                   Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SelectionButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Visible" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="views:FadeAnimation.IsActive">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource BooleanOrConverter}">
          <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType={x:Type ListBoxItem}}" />
          <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType={x:Type ListBoxItem}}" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Width="30" Height="30" Background="Transparent">
            <Border x:Name="SelectionSurface"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="{DynamicResource SecondaryTextBrush}"
                    BorderThickness="1.5"
                    CornerRadius="5" />
            <Border x:Name="SelectionHoverRing"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="5"
                    Opacity="0"
                    IsHitTestVisible="False"
                    views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                    views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                    views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
            <Border x:Name="SelectionSelectedFill"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="5"
                    Opacity="0"
                    IsHitTestVisible="False"
                    views:FadeAnimation.IsActive="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                    views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                    views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FadeVisibilityMs}" />
            <Path x:Name="SelectionCheck"
                  Width="9"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M1,3.5 L3.5,6 L8,1"
                  Stroke="{DynamicResource OnAccentBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Stretch="Fill"
                  Opacity="0"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FadeVisibilityMs}"
                  views:FadeAnimation.ManageVisibility="True" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}"
                   Value="True">
        <Setter Property="IsHitTestVisible" Value="True" />
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}"
                   Value="True">
        <Setter Property="IsHitTestVisible" Value="True" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 卡片操作条图标按钮的共享模板（1.24.0 自置顶按钮模板提取，删除按钮共用）：
       悬停表面/按压表面/悬停强调色为通用交互反馈，可见性由各样式层的状态矩阵
       触发器（FadeAnimation.IsActive + IsHitTestVisible）驱动。 -->
  <ControlTemplate x:Key="CardIconButtonTemplate" TargetType="Button">
    <Border x:Name="CardIconButtonSurface"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource PinButtonCornerRadius}">
      <Grid>
        <Border x:Name="HoverLayer"
                Background="{DynamicResource HoverSurfaceBrush}"
                CornerRadius="{StaticResource PinButtonCornerRadius}"
                Opacity="0"
                IsHitTestVisible="False"
                views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
        <Border x:Name="PressedLayer"
                Background="{DynamicResource ActiveCategoryBrush}"
                CornerRadius="{StaticResource PinButtonCornerRadius}"
                Opacity="0"
                IsHitTestVisible="False"
                views:FadeAnimation.IsActive="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.PressFeedbackMs}" />
        <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- 状态徽章模板（1.24.0，契约 #19）：选中已置顶卡片的置顶钮换用本模板——
       纯展示、无悬停/按压反馈；按钮保持启用且可命中（禁用元素在 WPF 下不可
       命中，点击会穿透到右半选择手势），点击的语义失效由
       ToggleCardPinAsync 的状态矩阵守卫统一实现（真实输入与合成/UIA 路径
       共用同一条守卫）。 -->
  <ControlTemplate x:Key="CardStatusBadgeTemplate" TargetType="Button">
    <Border Background="Transparent"
            CornerRadius="{StaticResource PinButtonCornerRadius}">
      <ContentPresenter HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
    </Border>
  </ControlTemplate>

  <!-- 卡片操作按钮可见性状态矩阵（契约 #19，唯一权威=docs/design-contracts.md）：
       信号 = (悬停 IsMouseOver, 选中 IsSelected, 置顶 IsPinned)。
       置顶钮：可见/可命中 = IsPinned ∨ (悬停 ∧ 未选中)；
               选中时换纯展示徽章模板并以次文字色呈现（点击由
               ToggleCardPinAsync 守卫失效——不改置顶、不改选中）；
               ToolTip 随选中态指向批量入口（触发器排在 IsPinned 之后，
               徽章态文案生效）。 -->
  <Style x:Key="PinButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Visible" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ToolTip" Value="置顶" />
    <Setter Property="AutomationProperties.Name" Value="置顶或取消置顶" />
    <Setter Property="Template" Value="{StaticResource CardIconButtonTemplate}" />
    <Setter Property="views:FadeAnimation.IsActive" Value="False" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsPinned}" Value="True">
        <Setter Property="views:FadeAnimation.IsActive" Value="True" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="ToolTip" Value="取消置顶" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
          <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="False" />
        </MultiDataTrigger.Conditions>
        <Setter Property="views:FadeAnimation.IsActive" Value="True" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
        <Setter Property="Template" Value="{StaticResource CardStatusBadgeTemplate}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="ToolTip" Value="多选中，用顶部按钮操作" />
        <Setter Property="AutomationProperties.Name" Value="已置顶状态徽章（多选中，用顶部按钮操作）" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 删除钮（1.24.0 新增）：可见/可命中 = 悬停 ∧ 未选中——仅未选中卡片悬停时
       淡入，选中卡片一律隐藏（含悬停时），删除走单卡撤销管线；语义实现见
       MainWindow.CardGestures 的 OperationsDelete 会话与 DeleteSingleCardAsync。 -->
  <Style x:Key="DeleteButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Visible" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ToolTip" Value="删除" />
    <Setter Property="Template" Value="{StaticResource CardIconButtonTemplate}" />
    <Setter Property="views:FadeAnimation.IsActive" Value="False" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
          <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="False" />
        </MultiDataTrigger.Conditions>
        <Setter Property="views:FadeAnimation.IsActive" Value="True" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 添加备注钮（1.29.0 迁入操作条，记录 Issue #98；1.33.0 随 Issue #103 固定于
       操作网格右下格 (1,1)）：聊天气泡 16×16 Path 自 1.28.0 幽灵入口迁移复用，
       ToolTip/AutomationName 沿用幽灵样式既有值。可见性=幽灵入口七条件的
       「正文截断 ∨ 偏好开启」豁免（2026-10-22 修订，Issue #211）：MultiDataTrigger
       是纯 AND，豁免=两条同 Setter 组的 MultiDataTrigger 并集（WPF 原生 OR）——
       触发器 1 为原七条件逐字原样（默认行为路径）；触发器 2 去掉 IsTruncated、
       补窗口祖先 DataContext.ShortCardNotesEnabled=True（照 IsSearchActive 先例，
       偏好经 ApplyPreferences 喂值）。共同六条件：无备注 ∧ 卡片悬停 ∧ 无正文
       编辑 ∧ 无备注编辑 ∧ 文字卡 ∧ 非搜索态（ElementName=CardPreviewText 与条目
       属性绑定同模板 namescope 原样可用）。
       隐藏必须是格子固定预留、可见性塌缩语义：基态 Visibility=Collapsed + 网格
       绝对行列——不可见时 (1,1) 格子留空、其余按钮几何逐像素不动（禁止纯 Opacity
       隐藏：opacity 不释放命中）；FadeAnimation.ManageVisibility 承载激活即
       Visible、失活动画完成后 Collapsed、动效关闭立即切。 -->
  <Style x:Key="NoteButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ToolTip" Value="添加备注" />
    <Setter Property="AutomationProperties.Name" Value="备注" />
    <Setter Property="Template" Value="{StaticResource CardIconButtonTemplate}" />
    <Setter Property="views:FadeAnimation.IsActive" Value="False" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
    <Setter Property="views:FadeAnimation.ManageVisibility" Value="True" />
    <Style.Triggers>
      <!-- 触发器 1：默认路径（正文截断门槛，1.28.0 起原七条件逐字原样）。 -->
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Note, Converter={StaticResource NonEmptyTextConverter}}" Value="False" />
          <Condition Binding="{Binding IsTruncated, ElementName=CardPreviewText}" Value="True" />
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
          <Condition Binding="{Binding IsEditing}" Value="False" />
          <Condition Binding="{Binding IsEditingNote}" Value="False" />
          <Condition Binding="{Binding Kind}" Value="{x:Static models:BoardItemKind.Text}" />
          <Condition Binding="{Binding DataContext.IsSearchActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
        </MultiDataTrigger.Conditions>
        <Setter Property="views:FadeAnimation.IsActive" Value="True" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </MultiDataTrigger>
      <!-- 触发器 2：短卡备注开关豁免截断（2026-10-22，Issue #211）——六条件
           （去 IsTruncated）＋ 偏好开启，Setter 组与触发器 1 逐字相同；
           两条触发器同 Setter 组并集 = OR，接力期间属性值连续无闪烁。 -->
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Note, Converter={StaticResource NonEmptyTextConverter}}" Value="False" />
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
          <Condition Binding="{Binding IsEditing}" Value="False" />
          <Condition Binding="{Binding IsEditingNote}" Value="False" />
          <Condition Binding="{Binding Kind}" Value="{x:Static models:BoardItemKind.Text}" />
          <Condition Binding="{Binding DataContext.IsSearchActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
          <Condition Binding="{Binding DataContext.ShortCardNotesEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="views:FadeAnimation.IsActive" Value="True" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <!-- AI 整理钮（1.41.0，契约 #29）：可见性七条件＝备注钮七条件减「无备注」
       （备注与 AI 正交）：AI 整理总开关 ∧ 正文截断 ∧ 卡片悬停 ∧ 无正文编辑 ∧
       无备注编辑 ∧ 文字卡 ∧ 非搜索态（ElementName=CardPreviewText 与条目绑定同模板
       namescope 原样可用；偏好经窗口祖先 DataContext 绑定消费，ApplyPreferences
       唯一管线喂值，关＝AI 钮不再出现）。隐藏同备注钮家族语义：基态 Collapsed +
       FadeAnimation.ManageVisibility（禁纯 Opacity 隐藏），所在追加网格行随之
       塌缩（短卡高度不变、其余按钮零漂移，#16/#19）。忙态（IsAiOrganizing）
       图标换旋转弧；按钮保持 IsEnabled=true——禁用元素在 WPF 下不可命中，点击
       会穿透成右半选择手势（#19 先例），防抖由入口守卫（IsAiOrganizing 即丢弃）。 -->
  <Style x:Key="AiOrganizeButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ToolTip" Value="AI 整理" />
    <Setter Property="AutomationProperties.Name" Value="AI 整理" />
    <Setter Property="Template" Value="{StaticResource CardIconButtonTemplate}" />
    <Setter Property="views:FadeAnimation.IsActive" Value="False" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
    <Setter Property="views:FadeAnimation.ManageVisibility" Value="True" />
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding DataContext.AiOrganizeEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
          <Condition Binding="{Binding IsTruncated, ElementName=CardPreviewText}" Value="True" />
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
          <Condition Binding="{Binding IsEditing}" Value="False" />
          <Condition Binding="{Binding IsEditingNote}" Value="False" />
          <Condition Binding="{Binding Kind}" Value="{x:Static models:BoardItemKind.Text}" />
          <Condition Binding="{Binding DataContext.IsSearchActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
        </MultiDataTrigger.Conditions>
        <Setter Property="views:FadeAnimation.IsActive" Value="True" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <!-- AI 整理钮的常态图标（星光 motif）：忙态让位给旋转弧。 -->
  <Style x:Key="AiOrganizeIdleIconStyle" TargetType="Viewbox">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsAiOrganizing}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- AI 整理钮的忙态图标（弧线）：只在整理在途出现；旋转由窗口层驱动
       （尊重「界面动效」关闭＝静态弧线），变换实例由窗口层代码创建——模板
       内联 Freezable 会在密封期冻结，冻结对象不可承载动画。 -->
  <Style x:Key="AiOrganizeBusyIconStyle" TargetType="Viewbox">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsAiOrganizing}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>


  <!-- 快捷启动瓦片右键上下文菜单（#30 修订，Issue #176）：查看态/编辑态瓦片右键
       出「删除/上移/下移/重命名」四项（Win11 开始菜单先例；上移/下移＝WCAG 2.5.7
       拖动单指针替代，与契约 #21 标签顺序行同源）。主题画刷全部 DynamicResource
       （契约 #28 活切换同族）。-->
  <ControlTemplate x:Key="LauncherContextMenuTemplate" TargetType="ContextMenu">
    <Border Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource HeaderActionCornerRadius}"
            Padding="4">
      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
    </Border>
  </ControlTemplate>

  <Style x:Key="LauncherTileContextMenuStyle" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource StatusSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template" Value="{StaticResource LauncherContextMenuTemplate}" />
  </Style>

  <Style x:Key="LauncherContextMenuItemStyle" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="28,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="MenuItemSurface"
                  Background="Transparent"
                  CornerRadius="{StaticResource PinButtonCornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="MenuItemSurface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 删除项：危险语义色（与 × 删除钮一致）。 -->
  <Style x:Key="LauncherContextMenuDangerItemStyle" TargetType="MenuItem"
         BasedOn="{StaticResource LauncherContextMenuItemStyle}">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- 菜单分组分隔线（#30 修订 2026-10-18：删除独立分组）。 -->
  <Style x:Key="LauncherContextMenuSeparatorStyle" TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="8,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Background="{TemplateBinding Background}"
                  Height="{TemplateBinding Height}"
                  Margin="{TemplateBinding Margin}"
                  CornerRadius="0.5" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 对话框壳（#30 修订 2026-10-18，Issue #186 D8）：一个壳，多窗复用（URL 输入/
       已安装应用选择器/编辑目标）。不透明 DialogSurfaceBrush（两主题字典）＋1px
       边框＋表面级圆角 8；圆角与阴影唯一来源=DWM（DwmWindowEffects，WindowChrome
       GlassFrameThickness=0——撤透明背景/Margin 6 假圆角/DropShadowEffect 三件套）；
       内容内边距 24。个别环境系统圆角/阴影缺失时回退为直角+边框（可用性兜底，
       禁止第二套假阴影）。 -->
  <Style x:Key="DialogShellStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource DialogSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SurfaceCornerRadius}" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <!-- 启动瓦片图标槽占位字形（#30）：仅在图标未到达（IconImage.Tag 为 null＝
       提取/favicon 抓取在途或失败）时可见，图标回填即整层收起——透明底图标
       不再透出底层字形轮廓。两个图标模板（应用/网页）共用；显隐用布局塌缩。 -->
  <Style x:Key="LauncherTileIconPlaceholderStyle" TargetType="TextBlock">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, ElementName=IconImage}" Value="{x:Null}">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 启动瓦片右上勾选钮（#30 修订 2026-10-18，Issue #186）：多选入口，视觉复用
       SelectionButtonStyle（30×30 命中、16×16 环 r5、悬停环/选中填充/对勾），
       绑定面按瓦片改写——瓦片非 ListBoxItem，可见性=悬停(瓦片)∨IsSelected∨
       IsKeyboardFocused 三者或（悬停∨选中∨键盘聚焦可见，#13 族）；命中区完全
       落在瓦片内。卡片 SelectionButtonStyle 行为零改动。 -->
  <Style x:Key="LauncherTileSelectionButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Visible" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="AutomationProperties.Name" Value="选择启动项" />
    <Setter Property="ToolTip" Value="选择" />
    <Setter Property="views:FadeAnimation.IsActive">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource BooleanOrConverter}">
          <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType={x:Type Border}}" />
          <Binding Path="IsSelected" />
          <Binding Path="IsKeyboardFocused" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Width="30" Height="30" Background="Transparent">
            <Border x:Name="SelectionSurface"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="{DynamicResource SecondaryTextBrush}"
                    BorderThickness="1.5"
                    CornerRadius="{StaticResource SelectionRingCornerRadius}" />
            <Border x:Name="SelectionHoverRing"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="{StaticResource SelectionRingCornerRadius}"
                    Opacity="0"
                    IsHitTestVisible="False"
                    views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                    views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                    views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
            <Border x:Name="SelectionSelectedFill"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="{StaticResource SelectionRingCornerRadius}"
                    Opacity="0"
                    IsHitTestVisible="False"
                    views:FadeAnimation.IsActive="{Binding IsSelected}"
                    views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                    views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FadeVisibilityMs}" />
            <Path x:Name="SelectionCheck"
                  Width="9"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M1,3.5 L3.5,6 L8,1"
                  Stroke="{DynamicResource OnAccentBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Stretch="Fill"
                  Opacity="0"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsSelected}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FadeVisibilityMs}"
                  views:FadeAnimation.ManageVisibility="True" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="IsHitTestVisible" Value="True" />
      </MultiDataTrigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="IsHitTestVisible" Value="True" />
      </Trigger>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter Property="IsHitTestVisible" Value="True" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- AI 追加按钮行（1.41.0，#16/#19 修订）：命中层右列改垂直 StackPanel——
       基座 2×2 网格原样（恒 64）＋本追加网格（两列×CardOperationColumnWidth、
       单 30 DIP 按钮行、上缘 4 DIP 间隔）。只在截断文字卡出现：正文恒钳
       MaxHeight=100 ≥ 追加后网格总高 98，任何卡高度零跳变；短卡/图片卡整行
       塌缩（短卡下限 64 不变、其余按钮零漂移）。显隐由截断布局事实驱动
       （IsTruncated 唯一权威，TrimAwareTextBlock），不随悬停派生——悬停只
       控制行内按钮的淡入淡出，追加行自身常在，高度稳定；AI 整理总开关关闭时
       追加行整行塌缩（截断卡回到无 AI 行的旧布局，不留 34 DIP 空带）。 -->
  <Style x:Key="CardAiAppendRowStyle" TargetType="Grid">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding DataContext.AiOrganizeEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
          <Condition Binding="{Binding IsTruncated, ElementName=CardPreviewText}" Value="True" />
          <Condition Binding="{Binding Kind}" Value="{x:Static models:BoardItemKind.Text}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="StatusOverlayStyle" TargetType="Border">
    <Setter Property="Margin" Value="12" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Background" Value="{DynamicResource StatusSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="views:FadeAnimation.IsActive"
            Value="{Binding StatusText, Converter={StaticResource NonEmptyTextConverter}}" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
    <Setter Property="views:FadeAnimation.ManageVisibility" Value="True" />
  </Style>

  <Style x:Key="StatusTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CompactStatusPopupStyle" TargetType="Border">
    <Setter Property="MaxWidth" Value="260" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="views:FadeAnimation.IsActive"
            Value="{Binding StatusText, Converter={StaticResource NonEmptyTextConverter}}" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
  </Style>

  <Style x:Key="HeaderThumbStyle" TargetType="Thumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeNS" />
    <Setter Property="Template" Value="{StaticResource TransparentThumbTemplate}" />
  </Style>

  <Style x:Key="WidthResizeThumbStyle" TargetType="Thumb">
    <Setter Property="Width" Value="7" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template" Value="{StaticResource TransparentThumbTemplate}" />
  </Style>

  <Style x:Key="HeightResizeThumbStyle" TargetType="Thumb">
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Cursor" Value="SizeNS" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template" Value="{StaticResource TransparentThumbTemplate}" />
  </Style>

  <Style x:Key="TransparentScrollRepeatButtonStyle" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SlimScrollThumbStyle" TargetType="Thumb">
    <Setter Property="Width" Value="4" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <Border x:Name="ThumbSurface"
                    Background="{TemplateBinding Background}"
                    CornerRadius="2" />
            <Border x:Name="ThumbHoverLayer"
                    Width="6"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource ScrollThumbHoverBrush}"
                    CornerRadius="3"
                    Opacity="0"
                    IsHitTestVisible="False"
                    views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                    views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                    views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Width="8" Background="Transparent">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="True"
                   Orientation="Vertical">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                              Style="{StaticResource TransparentScrollRepeatButtonStyle}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SlimScrollThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                              Style="{StaticResource TransparentScrollRepeatButtonStyle}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- BoardList 专用 overlay ScrollViewer 模板（keyed；经 MainWindow.xaml BoardList.Resources
       的作用域隐式样式挂接，仅作用于该列表内部生成的 ScrollViewer）。单格叠加：垂直滚动条
       与内容同格、右缘悬浮其上，不占布局列——viewport 几何与滚动条可见性解耦，卡片几何
       不再随滚动条出现/消失漂移（默认模板的 Auto 独立列 + 系统滚动条宽度下限是漂移
       根因，出现/消失会在全宽与全宽−17.33 DIP 间跳变；条带 MinWidth/MinHeight=0 压掉
       主题 ScrollBar 样式的系统尺寸下限，瘦条宽 8 由既有隐式 ScrollBar 样式给出）。
       三个 PART_* 命名部件与
       透传绑定缺一不可：CanContentScroll 是虚拟化与键盘滚动的生命线；两向 ScrollBarVisibility
       保留 Auto 语义（需要时才出现，只是不再改变 viewport 宽）；不引入自动隐藏定时器。 -->
  <Style x:Key="OverlayScrollViewerStyle" TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                    CanHorizontallyScroll="False"
                                    CanVerticallyScroll="False"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Content="{TemplateBinding Content}"
                                    Margin="{TemplateBinding Padding}" />
            <ScrollBar x:Name="PART_VerticalScrollBar"
                       Orientation="Vertical"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Stretch"
                       MinWidth="0"
                       Minimum="0"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            <ScrollBar x:Name="PART_HorizontalScrollBar"
                       Orientation="Horizontal"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Bottom"
                       MinHeight="0"
                       Minimum="0"
                       Maximum="{TemplateBinding ScrollableWidth}"
                       ViewportSize="{TemplateBinding ViewportWidth}"
                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate DataType="{x:Type models:BoardItem}">
    <Grid Style="{StaticResource CardRootStyle}">
      <Border Style="{StaticResource CardShadowLayerStyle}" />
      <Border Style="{StaticResource CardContainerStyle}">
        <Grid Background="Transparent">
          <Border x:Name="CardHoverFillLayer"
                  Background="{DynamicResource HoverSurfaceBrush}"
                  CornerRadius="7"
                  Opacity="0"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
          <Border x:Name="CardHoverRingLayer"
                  BorderBrush="{DynamicResource HoverBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Margin="-1"
                  Opacity="0"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
          <Border x:Name="CardSelectedFillLayer"
                  Background="{DynamicResource SelectedCardBrush}"
                  CornerRadius="7"
                  Opacity="0"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FadeVisibilityMs}" />
          <Border x:Name="CardSelectedRingLayer"
                  BorderBrush="{DynamicResource SelectedCardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Margin="-1"
                  Opacity="0"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FadeVisibilityMs}" />
          <!-- 编辑环（1.22.0）：就地编辑的焦点提示=accent 细环，绑定条目 IsEditing——
               会话在窗口内焦点迁移期间持续（契约：焦点迁移不终结编辑），环与之一致；
               迟于选中环声明，两者同为编辑/选中叠加时编辑环在上。 -->
          <Border x:Name="CardEditingRingLayer"
                  BorderBrush="{DynamicResource AccentBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Margin="-1"
                  Opacity="0"
                  IsHitTestVisible="False"
                  views:FadeAnimation.IsActive="{Binding IsEditing}"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FadeVisibilityMs}" />

          <!-- 1.18.0 对半分区：内容视觉层全宽在下（图片/文字横贯整卡），
               其上叠加两列 * /* 的命中层（CardGestureZones）承载左右对半的
               手势判定——区域=元素身份，星号布局自动对半实际宽度（DPI 无关）。
               右半右上角保留既有置顶/选择按钮（命中层子元素，按钮命中走按钮分支）。
               卡片 12px 边缘环带不经过命中层，仍按默认归左半（贴边点击承载拖拽）。
               1.28.0 起网格分两行：行 0=备注行（Note 非空或备注编辑期占行，
               2026-10-12 起编辑器原位同格、置于本模板声明序末尾——见下方备注行
               Grid），行 1=内容视觉层；命中层与备注可点元素跨两行（备注行区域
               手势分区不变：左半无选择语义、右半 toggle/复制）。 -->
          <Grid Margin="12" Background="Transparent">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" Background="Transparent">
              <controls:AsyncThumbnailImage Height="120"
                     SourcePath="{Binding ImageAbsolutePath}"
                     Stretch="Uniform">
                <Image.Style>
                  <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}"
                                   Value="{x:Static models:BoardItemKind.Image}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Image.Style>
              </controls:AsyncThumbnailImage>

              <!-- 1.28.0：TrimAwareTextBlock（Decorator 承载——TextBlock.MeasureOverride
                   密封不可子类化，见控件实现）暴露 IsTruncated（渲染布局事实），是
                   「添加备注」入口的唯一判据（1.29.0 起入口在右上操作条）；MaxHeight=100
                   只声明在承载元素上（限高唯一来源，子元素不得重复声明）。文字卡可见性
                   与右让位触发器上移到承载元素（布局属性），子 TextBlock 只承载文字排版。 -->
              <controls:TrimAwareTextBlock x:Name="CardPreviewText"
                                            MaxHeight="{DynamicResource CardTextPreviewMaxHeight}">
                <controls:TrimAwareTextBlock.Style>
                  <Style TargetType="controls:TrimAwareTextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}"
                                   Value="{x:Static models:BoardItemKind.Text}">
                        <Setter Property="Visibility" Value="Visible" />
                        <!-- 仅文字态右侧内缩：为右上角操作按钮条预留排他空间（派生资源，
                             见 CardTextReservedRightInset），换行与省略在按钮条左缘之前完成。 -->
                        <Setter Property="Margin"
                                Value="{StaticResource CardTextReservedRightInset}" />
                      </DataTrigger>
                      <!-- 编辑期间显示态保持可见（不隐藏、高度恒定）：编辑器以卡片底色
                           不透明盖写同一区域，两态像素重合，卡片高度不随草稿塌缩。 -->
                    </Style.Triggers>
                  </Style>
                </controls:TrimAwareTextBlock.Style>
                <TextBlock Text="{Binding PreviewText}"
                           FontFamily="{DynamicResource InterfaceFontFamily}"
                           FontSize="{x:Static design:DesignTokens.CardTextFontSize}"
                           FontWeight="Normal"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextOptions.TextFormattingMode="Display"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           LineHeight="{DynamicResource CardTextLineHeight}"
                           LineStackingStrategy="BlockLineHeight" />
              </controls:TrimAwareTextBlock>
            </Grid>

            <Grid Grid.RowSpan="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0"
                    Background="Transparent"
                    Tag="{x:Static views:CardGestureZones.ContentZone}" />

              <Grid Grid.Column="1"
                    Background="Transparent"
                    Tag="{x:Static views:CardGestureZones.OperationsZone}">
                <!-- 右列 1.41.0 起为垂直 StackPanel（右上锚定）：基座操作网格原样
                     ＋ AI 追加行网格（见 CardAiAppendRowStyle——只在截断文字卡
                     显形，短卡整行塌缩、正文恒钳 100 ≥ 98，任何卡高度零跳变）。 -->
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                <!-- 操作按钮网格（1.33.0，Issue #103）：固定两列 × 按钮行、列与按钮行
                     均为绝对 30 DIP（复用 CardOperationColumnWidth 单一来源），右上角
                     锚定，行优先序 选择|删除|置顶|备注（此后新增按钮按行优先向下
                     占格——追加「按钮行 + 间隔行」后左→右）。格子固定：按钮隐藏
                     （备注钮七条件门槛、三信号矩阵显隐）时格子留空、其余按钮零漂移
                     （绝对行列下 Collapsed 天然留空；UniformGrid/定宽 WrapPanel 不
                     保证隐藏留空，均被排除）。行间隙 4 DIP 是独立间隔行（T7 评审
                     P1：30 行装不下 30 钮 + 4 边距，Margin 过约束使间隙不可靠），
                     按钮行物理行号为 0/2，网格宽恒 2×30、高 64。 -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource CardOperationColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource CardOperationColumnWidth}" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource CardOperationColumnWidth}" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="{StaticResource CardOperationColumnWidth}" />
                  </Grid.RowDefinitions>

                  <!-- 选择钮：按钮行 0 左格 (0,0)。可见性矩阵见 SelectionButtonStyle。 -->
                  <Button Grid.Row="0"
                          Grid.Column="0"
                          Style="{StaticResource SelectionButtonStyle}"
                          Tag="{Binding}"
                          CommandParameter="{x:Static views:CardGestureZones.ToggleSelectionCommand}"
                          ToolTip="选择"
                          AutomationProperties.Name="选择" />

                  <!-- 删除钮（1.24.0）：垃圾桶图标与头部垃圾桶按钮同一几何（16×16 网格
                       规范），前景随共享模板的悬停强调色；按钮行 0 右格 (0,1)，可见性
                       矩阵见 DeleteButtonStyle。 -->
                  <Button Grid.Row="0"
                          Grid.Column="1"
                          Style="{StaticResource DeleteButtonStyle}"
                          Tag="{Binding}"
                          CommandParameter="{x:Static views:CardGestureZones.DeleteCardCommand}"
                          AutomationProperties.Name="删除">
                    <Viewbox Width="16" Height="16">
                      <Path Data="M8.5,4 L11.5,4 C11.5,3.17157 10.8284,2.5 10,2.5 C9.17157,2.5 8.5,3.17157 8.5,4 Z M7.5,4 C7.5,2.61929 8.61929,1.5 10,1.5 C11.3807,1.5 12.5,2.61929 12.5,4 L17.5,4 C17.7761,4 18,4.22386 18,4.5 C18,4.77614 17.7761,5 17.5,5 L16.4456,5 L15.2521,15.3439 C15.0774,16.8576 13.7957,18 12.2719,18 L7.72813,18 C6.20431,18 4.92256,16.8576 4.7479,15.3439 L3.55437,5 L2.5,5 C2.22386,5 2,4.77614 2,4.5 C2,4.22386 2.22386,4 2.5,4 L7.5,4 Z M5.74131,15.2292 C5.85775,16.2384 6.71225,17 7.72813,17 L12.2719,17 C13.2878,17 14.1422,16.2384 14.2587,15.2292 L15.439,5 L4.56101,5 Z M8.5,7.5 C8.77614,7.5 9,7.72386 9,8 L9,14 C9,14.2761 8.77614,14.5 8.5,14.5 C8.22386,14.5 8,14.2761 8,14 L8,8 C8,7.72386 8.22386,7.5 8.5,7.5 Z M12,8 C12,7.72386 11.7761,7.5 11.5,7.5 C11.2239,7.5 11,7.72386 11,8 L11,14 C11,14.2239 11.2239,14.5 11.5,14.5 C11.7761,14.5 12,14.2761 12,14 L12,8 Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            Stretch="Uniform" />
                    </Viewbox>
                  </Button>

                  <!-- 置顶钮：按钮行 1 左格 (1,0)（物理行 2，行 1 为 4 DIP 间隔行）。
                       可见性矩阵见 PinButtonStyle。 -->
                  <Button Grid.Row="2"
                          Grid.Column="0"
                          Style="{StaticResource PinButtonStyle}"
                          Tag="{Binding}"
                          CommandParameter="{x:Static views:CardGestureZones.TogglePinCommand}">
                    <Viewbox Width="16" Height="16">
                      <Path Data="M10.1221,3.13715 C10.7326,1.91616 12.3599,1.65208 13.3251,2.61737 L17.382,6.67419 C18.3472,7.63947 18.0832,9.26676 16.8622,9.87726 L13.4037,11.6065 C13.0751,11.7708 12.8183,12.0499 12.6818,12.391 L11.2459,15.981 C10.9792,16.6476 10.1179,16.8244 9.61027,16.3167 L7,13.7064 L3.70711,16.9993 L3,17 L3,16.2922 L6.29289,12.9993 L3.68262,10.3891 C3.17498,9.88142 3.35177,9.02011 4.01834,8.75348 L7.60829,7.3175 C7.94939,7.18106 8.22855,6.92419 8.39285,6.5956 L10.1221,3.13715 Z M12.618,3.32447 C12.1354,2.84183 11.3167,2.97387 11.0165,3.58437 L9.28727,7.04282 C9.01345,7.59046 8.54818,8.01858 7.97968,8.24598 L4.38973,9.68196 L10.3174,15.6096 L11.7534,12.0197 C11.9808,11.4512 12.4028,10.9859 12.9565,10.7121 L16.415,8.98283 C17.1575,8.67758 17.2895,7.86394 16.6749,7.3813 L12.618,3.32447 Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            Stretch="Uniform" />
                    </Viewbox>
                  </Button>

                  <!-- 添加备注钮：按钮行 1 右格 (1,1)（物理行 2）。可见性七条件与塌缩
                       语义见 NoteButtonStyle，点击复用 NoteStripCommand 参数路由
                       （手势层与 UIA 路径零改动）。 -->
                  <Button x:Name="CardOperationNoteButton"
                          Grid.Row="2"
                          Grid.Column="1"
                          Style="{StaticResource NoteButtonStyle}"
                          Tag="{Binding}"
                          CommandParameter="{x:Static views:CardGestureZones.NoteStripCommand}">
                    <Viewbox Width="16" Height="16">
                      <Path Data="M3,2.75 L13,2.75 C13.9665,2.75 14.75,3.5335 14.75,4.5 L14.75,9.5 C14.75,10.4665 13.9665,11.25 13,11.25 L8.2,11.25 L5.35,13.9 C5.05,14.18 4.75,14.06 4.75,13.6 L4.75,11.25 L3,11.25 C2.0335,11.25 1.25,10.4665 1.25,9.5 L1.25,4.5 C1.25,3.5335 2.0335,2.75 3,2.75 Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            Stretch="Uniform" />
                    </Viewbox>
                  </Button>
                </Grid>

                  <!-- AI 整理钮（1.41.0）：追加按钮行左格 (2,0)（上缘 4 DIP 间隔、
                       单 30 DIP 按钮行），右格固定留空（后续按钮按行优先左→右）。
                       追加行几何与显隐见 CardAiAppendRowStyle；按钮可见性六条件、
                       忙态图标与防抖语义见 AiOrganizeButtonStyle。点击意图经
                       AiOrganizeCommand 参数路由（手势层与 UIA 路径共用实现）。 -->
                  <Grid Style="{StaticResource CardAiAppendRowStyle}"
                        Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{StaticResource CardOperationColumnWidth}" />
                      <ColumnDefinition Width="{StaticResource CardOperationColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="{StaticResource CardOperationColumnWidth}" />
                    </Grid.RowDefinitions>

                    <Button x:Name="CardOperationAiOrganizeButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource AiOrganizeButtonStyle}"
                            Tag="{Binding}"
                            CommandParameter="{x:Static views:CardGestureZones.AiOrganizeCommand}">
                      <Grid>
                        <Viewbox Width="16" Height="16"
                                 Style="{StaticResource AiOrganizeIdleIconStyle}">
                          <Path Data="M9.5,1.8 L11.2,7.3 L16.7,9 L11.2,10.7 L9.5,16.2 L7.8,10.7 L2.3,9 L7.8,7.3 Z M14.8,12.3 L15.4,14.1 L17.2,14.7 L15.4,15.3 L14.8,17.1 L14.2,15.3 L12.4,14.7 L14.2,14.1 Z"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                Stretch="Uniform" />
                        </Viewbox>
                        <Viewbox x:Name="CardAiBusyIcon"
                                 Width="16" Height="16"
                                 Style="{StaticResource AiOrganizeBusyIconStyle}">
                          <Path Data="M 9,1.5 A 7.5,7.5 0 1 1 1.5,9"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                StrokeThickness="1.8"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                        </Viewbox>
                      </Grid>
                    </Button>
                  </Grid>
                </StackPanel>
              </Grid>
            </Grid>

            <!-- 就地编辑器（1.22.0）：位于命中层之上（声明序在其后），可见性由
                 条目 IsEditing 驱动（Collapsed 时不参与命中，手势层不受影响）。
                 卡面底色不透明盖写同区域显示文本（放置光标/选择即点编辑器；卡面
                 底色为常量 CardBrush，选中着色来自独立叠加层）。样式与显示态
                 TextBlock 同度量，见 CardTextEditorStyle。键位与失焦处理经窗口级
                 路由事件挂接（ResourceDictionary 不能声明事件处理器，
                 MainWindow.CardTextEditing 按 OriginalSource 过滤）。1.28.0 起
                 模板内有正文/备注两个编辑器，定位按模板名（FindCardEditor）。 -->
            <TextBox x:Name="CardTextEditor"
                     Grid.Row="1"
                     Style="{StaticResource CardTextEditorStyle}"
                     Margin="{StaticResource CardTextReservedRightInset}"
                     Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- 备注交互条（1.28.0，契约 #22；1.29.0 入口迁往右侧按钮组）：备注
                 点击面与编辑器位于命中层之上（声明序在其后——命中陷阱红线：备注
                 可点元素若在透明命中层之下，真实鼠标点击会被拦截、只有合成/UIA
                 可达）。按态互斥：
                 ① 点击面（行 0 左半容器内拉伸=恰好盖住备注行左半）：已有
                    备注的编辑入口，左键绝不 toggle 选中（独立意图 OperationsNote，
                    滑离释放取消，不进双击窗）；ToolTip 借面显示备注全文。
                 ② 添加备注钮（1.33.0 起固定于右上操作网格右下格 (1,1)，
                    CardOperationNoteButton，见上方操作网格）：无备注∧正文截断∧
                    卡片悬停∧无会话进行中才淡入可点，NoteButtonStyle；幽灵标签
                    入口已删除（重叠根因消除）。
                 ③ 备注编辑器（行 0 备注行原位，见下方备注行 Grid）：IsEditingNote
                    驱动，CardNoteEditorStyle。
                 右键语义零改动：备注元素只承接左键会话（Down 沿 OriginalSource
                 祖先链识别 NoteStripCommand），右键按既有命中层分区——点击面
                 只在左半位置、右上按钮条右键复制语义不变（1.24.0 同规）。 -->
            <Grid Grid.Row="0" Background="{x:Null}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="CardNoteEntryButton"
                      Grid.Column="0"
                      Style="{StaticResource CardNoteEntryHitStyle}"
                      Tag="{Binding}"
                      CommandParameter="{x:Static views:CardGestureZones.NoteStripCommand}"
                      ToolTip="{Binding Note}" />
            </Grid>

            <!-- 备注行（1.28.0 引入；2026-10-12 起行 0 自身两列、编辑器原位同格，
                 契约 #22）：行 0 = Auto 图标列 + * 内容列，声明序在本模板最后——
                 备注可点元素（编辑器）必须渲染在命中层与备注交互条之上（z 序
                 不变量，真实输入可点，契约 #13/#22）；显示子树（图标/显示文字）
                 IsHitTestVisible=false，点击由下方备注交互条承接。
                 内容列同格叠加备注显示 TextBlock（先声明）与 CardNoteEditor（后
                 声明=渲染在上）：编辑器以 CardBrush 不透明盖写同一格，两态像素
                 重合、无高度跳变；编辑框左缘与备注文字左缘的像素对齐由结构保证
                 （同列同格，Auto 图标列同时约束两态），不发明硬编码偏移。
                 可见性单规则：行 = Note 非空 ∨ IsEditingNote——同时覆盖「编辑
                 已有备注」（图标保持可见）与「无备注卡添加备注」（行 0 有界长高
                 ≤2 行/40px，提交/取消后回落）两态，不做 per-case 触发器；显示
                 文字仅 Note 非空；编辑器仅 IsEditingNote（样式内单点驱动）。
                 行高 = max(显示行, 编辑器) ≤ 40（Auto 行，不预留 MinHeight、
                 不锁行高）。右让位复用 CardTextReservedRightInset（#16 派生
                 资源，不发明第二个数值）。布局必须是 Grid：水平 StackPanel 会给
                 子元素无限宽度约束，Wrap/省略号/MaxHeight 全部失效（T7 评审 B1）。 -->
            <Grid x:Name="NoteDisplayRow"
                  Grid.Row="0"
                  Margin="{StaticResource CardTextReservedRightInset}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Note, Converter={StaticResource NonEmptyTextConverter}}"
                                 Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEditingNote}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Viewbox Grid.Column="0"
                       Width="16"
                       Height="16"
                       Margin="0,2,5,0"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False">
                <Path Data="M3,2.75 L13,2.75 C13.9665,2.75 14.75,3.5335 14.75,4.5 L14.75,9.5 C14.75,10.4665 13.9665,11.25 13,11.25 L8.2,11.25 L5.35,13.9 C5.05,14.18 4.75,14.06 4.75,13.6 L4.75,11.25 L3,11.25 C2.0335,11.25 1.25,10.4665 1.25,9.5 L1.25,4.5 C1.25,3.5335 2.0335,2.75 3,2.75 Z"
                      Stroke="{DynamicResource SecondaryTextBrush}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
              </Viewbox>
              <TextBlock Grid.Column="1"
                         Text="{Binding Note}"
                         FontFamily="{DynamicResource InterfaceFontFamily}"
                         FontSize="12"
                         FontWeight="Normal"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         TextOptions.TextFormattingMode="Display"
                         TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis"
                         LineHeight="{DynamicResource CardTextLineHeight}"
                         LineStackingStrategy="BlockLineHeight"
                         MaxHeight="{DynamicResource CardNoteMaxHeight}"
                         IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Note, Converter={StaticResource NonEmptyTextConverter}}"
                                   Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBox x:Name="CardNoteEditor"
                       Grid.Column="1"
                       Style="{StaticResource CardNoteEditorStyle}"
                       Text="{Binding DraftNote, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
