<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:FloatingTransferStation.Converters"
                    xmlns:design="clr-namespace:FloatingTransferStation.Design;assembly=FloatingTransferStation.Core"
                    xmlns:models="clr-namespace:FloatingTransferStation.Models;assembly=FloatingTransferStation.Core"
                    xmlns:views="clr-namespace:FloatingTransferStation.Views"
                    xmlns:controls="clr-namespace:FloatingTransferStation.Controls"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- 颜色画刷与卡片阴影定义在 Resources/DesignTheme.Light.xaml 与 DesignTheme.Dark.xaml，
       由 DesignThemeManager 在运行时整体替换；本字典内一律以 DynamicResource 引用。 -->
  <!-- 默认界面字体（数值唯一来源=DesignTokens.InterfaceFontFamily，锁定测试镜像）：
       全部消费者（六个窗口根 + 本字典样式）一律 DynamicResource 引用本键——
       用户自定义字体（偏好 InterfaceFont）经 InterfaceFontManager 以窗口级槽位
       覆盖本值，即时生效；图标字体（Segoe Fluent Icons）是独立字面量，不随本键变化。 -->
  <FontFamily x:Key="InterfaceFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
  <GridLength x:Key="CardOperationColumnWidth">30</GridLength>
  <!-- 文字卡正文右侧排他内缩（派生资源，唯一数值来源）：两列 CardOperationColumnWidth
       （固定两列按钮网格横向占地，Issue #103）+ 4 DIP 正文-网格水平缓冲（与网格内
       部的纵向行间隙无关）。对半分区的内容视觉层全宽、按钮悬停才淡入，正文不内缩
       就会与角按钮网格争用同一批像素（1.20.0 两列横排 64，1.24.0 三列 94，1.29.0
       四列 124，1.33.0 回归右上两列网格 64——横占地减半、卡片右下角纵向闲置空间
       被利用）；命中层与图片卡不受影响。静态值（不随悬停派生）：按钮显隐若牵动
       正文回流会造成布局抖动，已否决按卡动态内缩。 -->
  <Thickness x:Key="CardTextReservedRightInset" Left="0" Top="0" Right="64" Bottom="0" />
  <!-- 卡片正文行距唯一数值来源（契约 #25）：显示态两处（正文预览/备注显示行）与
       编辑态（CardTextEditorStyle 经 TextBlock.LineHeight 附加属性）共同引用——
       双击光标锚点要求两态行距同源，行带才能逐像素对齐（就近行映射的确定性前提，
       见 CardTextEditorStyle 注释）。默认值 20=InterfaceFontManager 对默认字体
       （LineSpacing 1.330078）的推导值（ceil(14×1.330078+1)，公式常数=
       DesignTokens.CardTextFontSize/CardTextExtraLeadingPx，锁定测试互锁）；
       用户自定义字体时 InterfaceFontManager 以窗口级槽位注入按该字体度量推导
       的行高与行数上限（更高 em 字体→更大行高，恒≥自然行高不裁切），
       消费者一律 DynamicResource 引用。 -->
  <sys:Double x:Key="CardTextLineHeight">20</sys:Double>
  <!-- 正文/备注可见行数上限（行高倍率资源，默认字体=100(5×20)/40(2×20) 与
       既有几何一致；自定义字体随推导行高等比放大，倍率=DesignTokens
       .CardTextMaxVisibleLines/CardNoteMaxVisibleLines）。 -->
  <sys:Double x:Key="CardTextPreviewMaxHeight">100</sys:Double>
  <sys:Double x:Key="CardNoteMaxHeight">40</sys:Double>
  <CornerRadius x:Key="ShellCornerRadius">8</CornerRadius>
  <!-- 圆角两档阶梯（#30 修订 2026-10-18，Issue #186 D9）：控件 4 / 表面 8，
       数值唯一来源=DesignTokens.ControlCornerRadiusPx / SurfaceCornerRadiusPx
       （锁定测试镜像）；SurfaceCornerRadius 与 CardCornerRadius（=8）收敛同源。
       既有 5/6/7 字面量（识别元素/头部钮/徽章）本次触面之外不强制收编。 -->
  <CornerRadius x:Key="SurfaceCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="HeaderActionCornerRadius">7</CornerRadius>
  <CornerRadius x:Key="PinButtonCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="SelectedCountBadgeCornerRadius">7</CornerRadius>
  <!-- 选择环圆角（识别元素 r5，#30 修订 2026-10-18）：卡片与瓦片勾选钮共用，
       镜像 DesignTokens.CheckboxCornerRadius。 -->
  <CornerRadius x:Key="SelectionRingCornerRadius">5</CornerRadius>
  <converters:BooleanOrConverter x:Key="BooleanOrConverter" />
  <converters:NonEmptyTextConverter x:Key="NonEmptyTextConverter" />

  <ControlTemplate x:Key="TransparentThumbTemplate" TargetType="Thumb">
    <Border Background="{TemplateBinding Background}" />
  </ControlTemplate>

  <Style x:Key="WindowShellStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource WindowShellBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadius}" />
  </Style>

  <Style x:Key="WindowShellOutlineStyle" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1,1,0,1" />
    <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadius}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="HeaderSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
    <Setter Property="CornerRadius" Value="11,0,0,0" />
  </Style>

  <Style x:Key="RailSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource TabRailBrush}" />
  </Style>

  <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="HeaderActionsHostStyle" TargetType="StackPanel">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ActionSurface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource HeaderActionCornerRadius}">
            <Grid>
              <Border x:Name="HoverLayer"
                      Background="{DynamicResource HoverSurfaceBrush}"
                      BorderBrush="{DynamicResource HoverBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource HeaderActionCornerRadius}"
                      Opacity="0"
                      IsHitTestVisible="False"
                      views:FadeAnimation.IsActive="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                      views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                      views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
              <Border x:Name="PressedLayer"
                      Background="{DynamicResource ActiveCategoryBrush}"
                      CornerRadius="{StaticResource HeaderActionCornerRadius}"
                      Opacity="0"
                      IsHitTestVisible="False"
                      views:FadeAnimation.IsActive="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                      views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                      views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.PressFeedbackMs}" />
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 两窗共享的主题控件样式（单一事实来源）：主窗与设置窗都 merge 本字典，
       颜色一律走 DynamicResource 主题键，随 DesignTheme.*.xaml 整本替换重解析。
       样式不放 DesignTheme.*.xaml——那是会被整本替换的纯颜色字典，放样式等于双份。 -->

  <!-- 常规文字输入框：纯 Setter 版（默认模板自带 PART_ContentHost，不自绘）。
       Foreground/CaretBrush/SelectionBrush 补齐主题缺口；SelectionTextBrush 有意不设：
       沿用系统默认的「强调色选区 + 白字」语义（与 OnAccentBrush 约定一致），
       主题样式若再固定选区文字颜色，深浅两套强调色下必有一套对比失效。 -->
  <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <!-- 控件级圆角 4（#30 修订 2026-10-18 圆角阶梯 D9）：纯 Setter 样式经附加
         资源承载（默认模板 Border 读模板内 CornerRadius——纯 Setter 路径下 WPF
         默认 TextBox 模板的圆角由系统主题给 0，这里用模板内自绘保持阶梯同源）。 -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource ControlCornerRadius}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 常规操作按钮（设置窗原 SettingsActionButtonStyle 提升，两窗共用）：
       自绘模板脱离 Aero2 系统画刷，禁用态压暗。 -->
  <Style x:Key="ThemedActionButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource ControlCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 导航按钮（复盘 ‹ › 等）：动作按钮的小方块形态。Focusable 必须为 True——
       键盘可达性与既有回归（复盘失焦恢复收起）都依赖按钮能接收焦点，
       与头部动作按钮（装饰性、不可聚焦）不同。 -->
  <Style x:Key="ThemedNavButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedActionButtonStyle}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Focusable" Value="True" />
  </Style>

  <!-- ＋ 添加两入口菜单项（快捷启动 #30 切片 4）：菜单行形态——透明底、无边框、
       左对齐，悬停 HoverSurfaceBrush；承载于 HeaderBrush 弹层。 -->
  <Style x:Key="LauncherAddMenuButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  CornerRadius="5">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ＋ 添加菜单弹层表面（三个入口与「系统位置」子菜单共用单一来源，#30 扩展）：
       HeaderBrush 弹层＋1px 边框＋表面级圆角 7＋内边距 4；Margin 12 让出阴影透明区，
       阴影为样式内共享单一实例（Effect 不逐元素实例化）。 -->
  <Style x:Key="LauncherAddMenuSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Margin" Value="12" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.25" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ＋ 添加菜单「系统位置」子项（#30 扩展）：行形态与 LauncherAddMenuButtonStyle
       同族（透明底、左对齐、悬停 HoverSurfaceBrush、圆角 5、12,6 内边距），承载于
       MenuItem（原生命中/Click 语义）。 -->
  <Style x:Key="LauncherAddMenuSubmenuItemStyle" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="MenuItemSurface"
                  Background="Transparent"
                  CornerRadius="5"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="MenuItemSurface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ＋ 添加菜单「系统位置」分组项（#30 扩展）：WPF 原生 MenuItem 子菜单（定案不
       改平铺）——行形态与菜单入口同族，右侧 chevron 字形提示下级；子菜单弹层复用
       LauncherAddMenuSurfaceStyle 同一弹层语言。悬停/键盘右箭头展开、Esc/左箭头/选
       项点击收起均为 MenuItem 原生语义；PART_Popup 由 IsSubmenuOpen 驱动。 -->
  <Style x:Key="LauncherAddMenuGroupItemStyle" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource LauncherAddMenuSubmenuItemStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="MenuItemSurface"
                  Background="Transparent"
                  CornerRadius="5"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
              <TextBlock HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Text="&#xE76C;" />
              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Fade"
                     Placement="Right"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Style="{StaticResource LauncherAddMenuSurfaceStyle}">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="MenuItemSurface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
              <Setter TargetName="MenuItemSurface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 搜索类型 chip（ToggleButton）：Aero2 默认模板用系统画刷渲染 chrome、
       忽略主题 Background，必须自绘模板；选中态进入主题强调体系。 -->
  <Style x:Key="ThemedFilterChipStyle" TargetType="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="5">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 常规下拉框（设置窗原 ThemedComboBoxStyle 提升，两窗共用）：
       命中层必须置顶、PART_Popup 与 IsDropDownOpen 双向同步，注释见模板内。 -->
  <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemSurface"
                        Background="Transparent"
                        Padding="10,7"
                        CornerRadius="4"
                        Margin="4,2">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  Margin="10,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />
                <Path Grid.Column="1"
                      Data="M 0 0 L 4 4 L 8 0"
                      Stroke="{DynamicResource SecondaryTextBrush}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False" />
              </Grid>
            </Border>
            <!-- 命中层必须在最顶：不透明 Surface 在上会拦截全部鼠标命中，
                 ToggleButton 收不到点击、下拉无法用鼠标打开。 -->
            <ToggleButton Focusable="False"
                          ClickMode="Press"
                          Background="Transparent"
                          BorderThickness="0"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <!-- PART_Popup + 双向 IsOpen：StaysOpen=False 自行关闭时由部件名与绑定同步回 IsDropDownOpen，
                 避免关闭后状态失步（下次点击变成空操作、需点第二次）。 -->
            <Popup x:Name="PART_Popup"
                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False">
              <Border Background="{DynamicResource HeaderBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Margin="0,3,0,0"
                      MinWidth="{TemplateBinding ActualWidth}">
                <ScrollViewer MaxHeight="150">
                  <ItemsPresenter Margin="2" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CategoryTabContainerStyle" TargetType="Border">
    <Setter Property="Margin" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CategoryActiveLayerStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="views:CategoryFeedbackAnimation.IsActive" Value="{Binding IsActive}" />
    <Setter Property="views:CategoryFeedbackAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
  </Style>

  <Style x:Key="CategoryDropTargetLayerStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource DropTargetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="views:FadeAnimation.IsActive" Value="{Binding IsDropTarget}" />
    <Setter Property="views:FadeAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="views:FadeAnimation.DurationMs"
            Value="{x:Static design:DesignTokens.FadeVisibilityMs}" />
