<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:FloatingTransferStation.Converters"
                    xmlns:models="clr-namespace:FloatingTransferStation.Models"
                    xmlns:views="clr-namespace:FloatingTransferStation.Views">
  <SolidColorBrush x:Key="WindowShellBrush" Color="#F7F8FA" />
  <SolidColorBrush x:Key="TabRailBrush" Color="#EFF1F4" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BorderBrush" Color="#E2E5EA" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1D1D1F" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5F6368" />
  <SolidColorBrush x:Key="AccentBrush" Color="#6D5DFB" />
  <SolidColorBrush x:Key="DangerBrush" Color="#D92D20" />
  <SolidColorBrush x:Key="HeaderBrush" Color="#FBFBFC" />
  <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#F4F5F7" />
  <SolidColorBrush x:Key="HoverBorderBrush" Color="#C9CDD5" />
  <SolidColorBrush x:Key="SelectedCardBrush" Color="#F3F1FF" />
  <SolidColorBrush x:Key="SelectedCardBorderBrush" Color="#8B7CF6" />
  <SolidColorBrush x:Key="ActiveCategoryBrush" Color="#E7E4FF" />
  <SolidColorBrush x:Key="DropTargetBrush" Color="#EAE7FF" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B8BDC7" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#969CA7" />

  <FontFamily x:Key="InterfaceFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
  <GridLength x:Key="CardOperationColumnWidth">30</GridLength>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="HeaderActionCornerRadius">7</CornerRadius>
  <CornerRadius x:Key="PinButtonCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="SelectedCountBadgeCornerRadius">7</CornerRadius>
  <converters:ImageThumbnailConverter x:Key="ImageThumbnailConverter" />

  <ControlTemplate x:Key="TransparentThumbTemplate" TargetType="Thumb">
    <Border Background="{TemplateBinding Background}" />
  </ControlTemplate>

  <Style x:Key="WindowShellStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource WindowShellBrush}" />
    <Setter Property="CornerRadius" Value="12,0,0,12" />
  </Style>

  <Style x:Key="WindowShellOutlineStyle" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1,1,0,1" />
    <Setter Property="CornerRadius" Value="12,0,0,12" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="HeaderSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource HeaderBrush}" />
    <Setter Property="CornerRadius" Value="11,0,0,0" />
  </Style>

  <Style x:Key="RailSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource TabRailBrush}" />
  </Style>

  <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="HeaderActionsHostStyle" TargetType="StackPanel">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ActionSurface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource HeaderActionCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ActionSurface"
                      Property="Background"
                      Value="{StaticResource HoverSurfaceBrush}" />
              <Setter TargetName="ActionSurface"
                      Property="BorderBrush"
                      Value="{StaticResource HoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ActionSurface"
                      Property="Background"
                      Value="{StaticResource ActiveCategoryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CategoryTabContainerStyle" TargetType="Border">
    <Setter Property="Margin" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CategoryActiveLayerStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ActiveCategoryBrush}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="views:CategoryFeedbackAnimation.IsActive" Value="{Binding IsActive}" />
    <Setter Property="views:CategoryFeedbackAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
  </Style>

  <Style x:Key="CategoryDropTargetLayerStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DropTargetBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
        <Setter Property="Opacity" Value="1" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CategoryActiveMarkerStyle" TargetType="Border">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="22" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="0,2,2,0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="views:CategoryFeedbackAnimation.IsActive" Value="{Binding IsActive}" />
    <Setter Property="views:CategoryFeedbackAnimation.AnimationsEnabled"
            Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
  </Style>

  <Style x:Key="CategoryDefaultMarkerStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,3,4,0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Panel.ZIndex" Value="1" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsDefaultCapture}" Value="True">
        <Setter Property="Opacity" Value="1" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CategoryLabelTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsEditingName}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsActive}" Value="True">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CategoryNameEditorStyle" TargetType="TextBox">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="5" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="False" />
    <Setter Property="ToolTip" Value="编辑分类名称" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsEditingName}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="BoardListStyle" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4" />
  </Style>

  <Style x:Key="BoardListItemStyle" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CardContainerStyle" TargetType="Border">
    <Setter Property="Margin" Value="12,4" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Effect" Value="{x:Null}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}"
                   Value="True">
        <Setter Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsKeyboardFocusWithin}"
                   Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}"
                   Value="True">
        <Setter Property="Background" Value="{StaticResource SelectedCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SelectedCardBorderBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StartsNormalRegion}" Value="True">
        <Setter Property="Margin" Value="12,10,12,4" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SelectionButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Visible" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Width="30" Height="30" Background="Transparent">
            <Border x:Name="SelectionSurface"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="{StaticResource SecondaryTextBrush}"
                    BorderThickness="1.4"
                    CornerRadius="5" />
            <Path x:Name="SelectionCheck"
                  Width="9"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M1,3.5 L3.5,6 L8,1"
                  Stroke="White"
                  StrokeThickness="1.7"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Stretch="Fill"
                  Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="SelectionSurface"
                      Property="BorderBrush"
                      Value="{StaticResource AccentBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}"
                         Value="True">
              <Setter TargetName="SelectionSurface"
                      Property="Background"
                      Value="{StaticResource AccentBrush}" />
              <Setter TargetName="SelectionSurface"
                      Property="BorderBrush"
                      Value="{StaticResource AccentBrush}" />
              <Setter TargetName="SelectionCheck"
                      Property="Visibility"
                      Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}"
                   Value="True">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}"
                   Value="True">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PinButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Visible" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ToolTip" Value="置顶" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="PinSurface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource PinButtonCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="PinSurface"
                      Property="Background"
                      Value="{StaticResource HoverSurfaceBrush}" />
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PinSurface"
                      Property="Background"
                      Value="{StaticResource ActiveCategoryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}"
                   Value="True">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsPinned}" Value="True">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="ToolTip" Value="取消置顶" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="StatusOverlayStyle" TargetType="Border">
    <Setter Property="Margin" Value="12" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Background" Value="#FCFCFD" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Visible" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding StatusText}" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="StatusTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CompactStatusPopupStyle" TargetType="Border">
    <Setter Property="MaxWidth" Value="260" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="{StaticResource HeaderBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="HeaderThumbStyle" TargetType="Thumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeNS" />
    <Setter Property="Template" Value="{StaticResource TransparentThumbTemplate}" />
  </Style>

  <Style x:Key="WidthResizeThumbStyle" TargetType="Thumb">
    <Setter Property="Width" Value="7" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template" Value="{StaticResource TransparentThumbTemplate}" />
  </Style>

  <Style x:Key="HeightResizeThumbStyle" TargetType="Thumb">
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Cursor" Value="SizeNS" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template" Value="{StaticResource TransparentThumbTemplate}" />
  </Style>

  <Style x:Key="TransparentScrollRepeatButtonStyle" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SlimScrollThumbStyle" TargetType="Thumb">
    <Setter Property="Width" Value="4" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource ScrollThumbBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbSurface"
                  Background="{TemplateBinding Background}"
                  CornerRadius="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbSurface"
                      Property="Background"
                      Value="{StaticResource ScrollThumbHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Width="8" Background="Transparent">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="True"
                   Orientation="Vertical">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                              Style="{StaticResource TransparentScrollRepeatButtonStyle}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SlimScrollThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                              Style="{StaticResource TransparentScrollRepeatButtonStyle}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate DataType="{x:Type models:BoardItem}">
    <Border Style="{StaticResource CardContainerStyle}">
      <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="{StaticResource CardOperationColumnWidth}" />
          <ColumnDefinition Width="{StaticResource CardOperationColumnWidth}" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="Transparent">
          <Image Height="120"
                 Source="{Binding ImageAbsolutePath, Converter={StaticResource ImageThumbnailConverter}, ConverterParameter=512}"
                 Stretch="Uniform">
            <Image.Style>
              <Style TargetType="Image">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Kind}"
                               Value="{x:Static models:BoardItemKind.Image}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Image.Style>
          </Image>

          <TextBlock Text="{Binding Text}"
                     FontFamily="{StaticResource InterfaceFontFamily}"
                     FontSize="14"
                     FontWeight="Normal"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis"
                     LineHeight="18"
                     LineStackingStrategy="BlockLineHeight"
                     MaxHeight="90">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Kind}"
                               Value="{x:Static models:BoardItemKind.Text}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <Button Grid.Column="1"
                Style="{StaticResource PinButtonStyle}"
                Tag="{Binding}"
                CommandParameter="TogglePin"
                AutomationProperties.Name="置顶或取消置顶"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
          <Viewbox Width="16" Height="16">
            <Path Data="M8,3 L16,3 L14,8 L17,11 L12,11 L12,18 L10,20 L10,11 L5,11 L8,8 Z"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  Stretch="Uniform" />
          </Viewbox>
        </Button>

        <Button Grid.Column="2"
                Style="{StaticResource SelectionButtonStyle}"
                Tag="{Binding}"
                CommandParameter="ToggleSelection"
                ToolTip="选择"
                AutomationProperties.Name="选择"
                HorizontalAlignment="Right"
                VerticalAlignment="Top" />
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
