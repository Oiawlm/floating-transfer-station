<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>悬浮中转站</AssemblyName>
    <RootNamespace>FloatingTransferStation</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FloatingTransferStation.Core\FloatingTransferStation.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 内建插件随构建进入输出目录 plugins/，安装包按发布目录整体打包。 -->
    <Content Include="Plugins\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- 微信二维码位图（页脚关于区，W5 2026-11-05）：路径唯一来源
         ProductIdentity.WeChatQrComponentUri，经 pack URI 编译进程序集。 -->
    <Resource Include="Resources\WeChatQr.png" />
  </ItemGroup>
</Project>
