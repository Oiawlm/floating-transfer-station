                              Checked="GlobalHotkeyToggle_Checked"
                              Unchecked="GlobalHotkeyToggle_Unchecked" />
                  </Grid>
                  <TextBlock x:Name="GlobalHotkeyNoteText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Text="开启后任何界面按组合键展开面板到默认接收分类；默认关闭，组合键被其他软件占用时开启会提示失败。" />
                  <TextBlock x:Name="GlobalHotkeyStatusText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="自动检查更新" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="启动 30 秒后首检，之后每 24 小时一次；连续 2 小时无操作也会检查"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="AutoUpdateCheckToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="自动检查更新"
                              Checked="AutoUpdateCheckToggle_Checked"
                              Unchecked="AutoUpdateCheckToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="检查在后台静默进行；发现新版本即自动「下载 → 校验 → 安装 → 重启」，无需手动确认（手动检查同样如此）。关闭后仅停止自动检查，仍可随时点击标题栏「更新」按钮手动检查。" />
                </StackPanel>
              </Border>
              <!-- 实验性（首个先例，2026-11-03）：正在打磨中的能力按「默认关闭、显式
                   开启」提供——不稳定的边缘体验不默认打扰任何用户；形态随既有卡片
                   语言（CardBrush/BorderBrush/圆角 8），标注「实验性」并在节内说明
                   每项的实验原因。开关即时生效＋原子保存（契约 #5 同路）。 -->
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="实验性" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="记录界面 Markdown 阅读视图"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="ReviewMarkdownViewToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="记录界面 Markdown 阅读视图"
                              Checked="ReviewMarkdownViewToggle_Checked"
                              Unchecked="ReviewMarkdownViewToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="实验性功能，默认关闭。开启后记录界面出现「阅读｜编辑」切换：阅读态把记录内容按 Markdown 渲染成类 Obsidian 的只读视图（标题、列表、粗斜体、代码块、引用、链接等常用语法；链接点击后用浏览器打开，不加载远程图片；不支持的高级语法按原文显示）。默认关闭的原因：渲染子集与排版仍在打磨，编辑器形态（关闭时所见）保持为可靠基准。改动立即生效并自动保存，只影响呈现，不改变记录的保存与合并行为。" />
                  <!-- 实验性第二项（2026-11-05，契约 #57）：三态枚举设置沿仓库
                       「枚举设置一律 ComboBox」先例（置顶分隔/清理时长/垃圾桶行为）；
                       即时生效＋原子保存（契约 #5 唯一管线，禁平行保存路径）。 -->
                  <Grid Background="Transparent" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="分类内子分组"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="SubgroupModeComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              MaxDropDownHeight="240"
                              AutomationProperties.Name="分类内子分组"
                              SelectionChanged="SubgroupModeComboBox_SelectionChanged" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="实验性功能，默认关闭。开启后可在内容分类（重要/待分类）内再分一层子分组：「按钮轨」在分类顶部显示四个分组按钮（单击筛选、双击改名、把卡片拖到按钮上归组），「视觉分组」把同组卡片相邻摆放并用分隔线与组名标出边界。默认关闭的原因：两种形态与分组数据模型仍在打磨。改动立即生效并自动保存；子分组归属保存在卡片数据里，关闭开关不会丢失已归组的内容。" />
                  <!-- 实验性第三项（2026-11-06，契约 #58）：图片拖出为文件——门控
                       既有拖出能力（默认关＝对外剥离文件/位图形态，窗内拖放与
                       剪贴板复制零变化）；即时生效＋原子保存（契约 #5 同路）。 -->
                  <Grid Background="Transparent" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="图片拖出为文件"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <CheckBox x:Name="DragOutAsFileToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="图片拖出为文件"
                              Checked="DragOutAsFileToggle_Checked"
                              Unchecked="DragOutAsFileToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="实验性功能，默认关闭。开启后把图片卡（或纯图片多选）直接拖到文件夹或桌面，即复制出图片文件；只复制，受管图片库与应用内卡片不动。默认关闭的原因：对外拖出在不同目标应用的表现仍在打磨。关闭时窗内整理与剪贴板复制不受影响。改动立即生效并自动保存。" />
                </StackPanel>
              </Border>
            </StackPanel>

