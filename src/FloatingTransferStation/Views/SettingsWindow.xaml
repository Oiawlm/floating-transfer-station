<Window x:Class="FloatingTransferStation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="clr-namespace:FloatingTransferStation.Design;assembly=FloatingTransferStation.Core"
        xmlns:views="clr-namespace:FloatingTransferStation.Views"
        Title="设置"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        Width="{x:Static design:SettingsWindowMetrics.DefaultWidth}"
        Height="{x:Static design:SettingsWindowMetrics.DefaultHeight}"
        MinWidth="{x:Static design:SettingsWindowMetrics.MinWidth}"
        MinHeight="{x:Static design:SettingsWindowMetrics.MinHeight}"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        FontFamily="{DynamicResource InterfaceFontFamily}"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">
  <!-- 复用主窗 Mica 壳技术：整窗玻璃帧承载 DWM 材质，圆角由 DWM 裁剪。
       几何契约（#24，Issue #106）：SizeToContent=Manual + CanResize + 系统级
       8 向缩放（ResizeBorderThickness=6），固定视口由内部 ScrollViewer 承担滚动；
       冻结数值全部来自 SettingsWindowMetrics 单点声明。交互缩放与最大化的
       上限不由 Window.MaxWidth/MaxHeight 声明（1.50.0 教训：属性会把根视觉钳出
       死区），而是经 WM_GETMINMAXINFO 轨道尺寸强制；壳层铺满整个 HWND，
       内容列以 ContentColumnMaxWidth 居中有界。 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  GlassFrameThickness="-1"
                  ResizeBorderThickness="6"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/MainWindowStyles.xaml" />
        <ResourceDictionary Source="../Resources/DesignTheme.Light.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>

      <Style x:Key="RowCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="NoteCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
      </Style>

      <!-- 设置节卡片（契约 #24 设计语言）：既有卡片语言分组，颜色全走主题键。
           页内最后一张卡片用本地 Margin="0" 收尾。 -->
      <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>

      <!-- 左导航项（契约 #24）：RadioButton 原生带 SelectionItem 语义与 UIA peer，
           风格同主窗分类轨——选中态 ActiveCategory 底 + 强调色指示条。W6 焦点视觉
           治理（2026-11-03）：键入焦点不画 Aero2 虚线框（选中态底色与指示条承载视觉）。 -->
      <Style x:Key="SettingsNavItemStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid>
                <Border x:Name="ItemSurface"
                        Background="Transparent"
                        CornerRadius="7" />
                <Border x:Name="SelectionIndicator"
                        Width="3"
                        Margin="0,8"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="1.5"
                        Visibility="Collapsed"
                        IsHitTestVisible="False" />
                <ContentPresenter Margin="16,0,8,0"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="False" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
                  <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="开关" />
        <!-- W6 焦点视觉治理（2026-11-03）：开关键入焦点不画 Aero2 虚线框。 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Width="40" Height="20" Background="Transparent">
                <Border x:Name="Track"
                        Width="40"
                        Height="20"
                        CornerRadius="10"
                        Background="{DynamicResource BorderBrush}"
                        IsHitTestVisible="False" />
                <Border x:Name="Thumb"
                        Width="14"
                        Height="14"
                        CornerRadius="7"
                        HorizontalAlignment="Left"
                        Margin="3,0"
                        Background="{DynamicResource SecondaryTextBrush}"
                        IsHitTestVisible="False" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                  <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource OnAccentBrush}" />
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ThemedComboBoxStyle / ThemedActionButtonStyle 已提升至 MainWindowStyles.xaml
           （两窗共享的单一事实来源）；本字典仅保留设置窗私有样式。 -->

      <Style x:Key="ReadOnlyPathBoxStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Surface"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SettingsShellOutlineStyle" TargetType="Border" BasedOn="{StaticResource WindowShellOutlineStyle}">
        <!-- 独立浮动窗口（非贴右缘停靠）：四边描边补齐左缘。 -->
        <Setter Property="BorderThickness" Value="1" />
      </Style>

      <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedActionButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Height" Value="34" />
      </Style>

      <!-- 页脚联系方式小按钮（W5 2026-11-05）：动作按钮的紧凑文字形态，
           反馈态（已复制/复制失败）由代码后置换 Content 承载，轻档动效走
           FadeAnimation.IsActive 交叉淡入（同既有悬停语言）。 -->
      <Style x:Key="FooterCopyButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedActionButtonStyle}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="56" />
      </Style>

      <!-- 页脚二维码缩略图（W5 2026-11-05）：白底静区是二维码可扫的结构要求
           （主题不变量，非调色板颜色），控件级圆角＋既有描边/悬停语言；
           单击弹设置窗内放大层（不新建窗口）。 -->
      <Style x:Key="WeChatQrThumbStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="放大微信二维码" />
        <Setter Property="ToolTip" Value="单击放大微信二维码，右键复制微信号" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Surface"
                      Background="White"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Padding="3">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 密码输入框（AI 设置的 API Key 行）：与 ThemedTextBoxStyle 同法的纯 Setter 版，
           默认模板自带掩码显示，颜色一律走主题键。 -->
      <Style x:Key="ThemedPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.5" />
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Border x:Name="WindowShell"
          Style="{StaticResource WindowShellStyle}"
          SizeChanged="WindowShell_SizeChanged">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="11,11,0,0">
        <Grid Background="Transparent">
          <Thumb x:Name="HeaderDragRegion"
                 Style="{StaticResource HeaderThumbStyle}"
                 Cursor="SizeAll"
                 DragDelta="HeaderDragRegion_DragDelta"
                 DragCompleted="HeaderDragRegion_DragCompleted" />
          <TextBlock Text="设置"
                     Margin="16,0"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />
          <Button x:Name="CloseButton"
                  Style="{StaticResource HeaderActionButtonStyle}"
                  HorizontalAlignment="Right"
                  Margin="0,0,8,0"
                  ToolTip="关闭设置"
                  AutomationProperties.Name="关闭设置"
                  Click="CloseButton_Click">
            <Viewbox Width="14" Height="14">
              <Path Data="M0.7071068,0 L7,6.2928932 L13.292893,0 L14,0.7071068 L7.7071068,7 L14,13.292893 L13.292893,14 L7,7.7071068 L0.7071068,14 L0,13.292893 L6.2928932,7 L0,0.7071068 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        Stretch="Uniform" />
            </Viewbox>
          </Button>
        </Grid>
      </Border>

      <!-- 双栏主体（契约 #24，分组冻结表）：左导航 5 组 + 右内容页；
           SettingsScrollHost 是全部页共享的唯一滚动视口（x:Name 单一实例），
           页切换只翻 Visibility，可视树直书保证 43 个既有 x:Name 保持在窗口
           同一 namescope（FindName/UIA 全可达）。 -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="148" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource TabRailBrush}">
          <StackPanel x:Name="SettingsNavList"
                      Margin="0,8"
                      KeyboardNavigation.TabNavigation="Continue"
                      PreviewKeyDown="SettingsNavList_PreviewKeyDown">
            <RadioButton x:Name="SettingsNavAppearance"
                         GroupName="SettingsNav"
                         Content="外观"
                         Tag="AppearancePage"
                         IsChecked="True"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="外观"
                         Checked="SettingsNavItem_Checked" />
            <RadioButton x:Name="SettingsNavPanel"
                         GroupName="SettingsNav"
                         Content="面板"
                         Tag="PanelPage"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="面板"
                         Checked="SettingsNavItem_Checked" />
            <RadioButton x:Name="SettingsNavGeneral"
                         GroupName="SettingsNav"
                         Content="通用"
                         Tag="GeneralPage"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="通用"
                         Checked="SettingsNavItem_Checked" />
            <RadioButton x:Name="SettingsNavData"
                         GroupName="SettingsNav"
                         Content="数据与维护"
                         Tag="DataPage"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="数据与维护"
                         Checked="SettingsNavItem_Checked" />
            <RadioButton x:Name="SettingsNavAi"
                         GroupName="SettingsNav"
                         Content="AI"
                         Tag="AiPage"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="AI"
                         Checked="SettingsNavItem_Checked" />
          </StackPanel>
        </Border>
        <!-- 共享滚动视口挂既有 keyed overlay 模板（契约 #23 机制扩展，2026-10-19
             Issue #200）：五内容页高度不同，默认模板的布局滚动条出现/消失会让内容
             列在「全宽」与「全宽−滚动条宽」间跳变——溢出页卡片比不溢出页窄。单格
             叠加让条带悬浮内容之上、永不占布局宽，五页卡片宽度在任何窗口高度下
             逐 DIP 相等；条带 8 DIP 落在内容列 16 DIP 右边距带内，与卡片零相交。
             样式与本窗合并字典中的隐式瘦条 ScrollBar 样式同源（MainWindowStyles）。 -->
        <ScrollViewer x:Name="SettingsScrollHost"
                      Grid.Column="1"
                      Style="{StaticResource OverlayScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <!-- 内容列：720 上限内铺满视口（Stretch＋MaxWidth：槽宽不足取槽宽、
               超出上限取 720 并居中——WPF 对受 Max 钳制的 Stretch 自动按居中落位，
               兼得 #24「720 上限水平居中」）。Center 会让列宽随最宽卡片收窄，
               五页内容不同宽 → 卡片宽度页页不等（2026-10-19 根因修订，Issue #200）。 -->
          <Grid x:Name="SettingsContentHost"
                Margin="16,14,16,16"
                MaxWidth="{x:Static design:SettingsWindowMetrics.ContentColumnMaxWidth}"
                HorizontalAlignment="Stretch">
            <StackPanel x:Name="AppearancePage">
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="主题" Style="{StaticResource SectionTitleStyle}" />
                  <ComboBox x:Name="ThemeComboBox"
                            Style="{StaticResource ThemedComboBoxStyle}"
                            AutomationProperties.Name="主题"
                            SelectionChanged="ThemeComboBox_SelectionChanged" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="界面字体" Style="{StaticResource SectionTitleStyle}" />
                  <ComboBox x:Name="InterfaceFontComboBox"
                            Style="{StaticResource ThemedComboBoxStyle}"
                            AutomationProperties.Name="界面字体"
                            SelectionChanged="InterfaceFontComboBox_SelectionChanged" />
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="选择界面使用的字体，改动立即生效并自动保存；带「（默认）」标注的微软雅黑即应用默认（微软雅黑 UI，缺失时回退微软雅黑）。可选列表只含本机已安装字体（应用不随包分发字体文件）。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="动效" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="启用界面过渡动画"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="AnimationsToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="启用界面过渡动画"
                              Checked="AnimationsToggle_Checked"
                              Unchecked="AnimationsToggle_Unchecked" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="置顶分隔" Style="{StaticResource SectionTitleStyle}" />
                  <ComboBox x:Name="PinnedDividerComboBox"
                            Style="{StaticResource ThemedComboBoxStyle}"
                            AutomationProperties.Name="置顶分隔样式"
                            SelectionChanged="PinnedDividerComboBox_SelectionChanged" />
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="选择置顶区与普通区之间的分隔样式；改动立即生效并自动保存。" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PanelPage" Visibility="Collapsed">
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="标签顺序" Style="{StaticResource SectionTitleStyle}" />
                  <Grid x:Name="CategoryOrderHost" ClipToBounds="True">
                    <StackPanel x:Name="CategoryOrderList" />
                    <Border x:Name="CategoryOrderInsertionIndicator"
                            Height="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="拖拽调整四个标签的显示顺序（重要 / 记录 / 快捷启动 / 待分类）；仅调整顺序，不能增删。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="内容复制" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Ctrl + C 复制已选内容"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="CtrlCCopyToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="Ctrl + C 复制已选内容"
                              Checked="CtrlCCopyToggle_Checked"
                              Unchecked="CtrlCCopyToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="卡片右半左键单击即复制这一张（统一手势，不可关闭）；复制内容与拖出一致，应用自身的复制不会被自动收集重复入库。选中多张卡片后 Ctrl+C：文字按板内顺序合并，图片给出文件组。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="垃圾桶按钮" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="无选择时左键"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="TrashLeftClickComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              AutomationProperties.Name="无选择时左键行为"
                              SelectionChanged="TrashLeftClickComboBox_SelectionChanged" />
                  </Grid>
                  <Grid Background="Transparent" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="无选择时右键"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="TrashRightClickComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              AutomationProperties.Name="无选择时右键行为"
                              SelectionChanged="TrashRightClickComboBox_SelectionChanged" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="有选择时点击垃圾桶始终删除已选内容；两种清空都可 Ctrl+Z 整体撤销。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="卡片备注" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="允许短卡片添加备注"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="ShortCardNotesToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="允许短卡片添加备注"
                              Checked="ShortCardNotesToggle_Checked"
                              Unchecked="ShortCardNotesToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="默认只对正文被截断的长卡出现备注入口；开启后所有文字卡都可以添加备注（AI 整理按钮仍只对长文出现）。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
