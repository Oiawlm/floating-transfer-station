                             Text=""
                             Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="全局快捷键" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Ctrl + Alt + V 唤起面板"
                               Style="{StaticResource RowCaptionStyle}" />
