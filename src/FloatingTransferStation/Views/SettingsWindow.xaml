<Window x:Class="FloatingTransferStation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Transparent"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable, Segoe UI"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">
  <!-- 复用主窗 Mica 壳技术：整窗玻璃帧承载 DWM 材质，圆角由 DWM 裁剪。 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  GlassFrameThickness="-1"
                  ResizeBorderThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/MainWindowStyles.xaml" />
        <ResourceDictionary Source="../Resources/DesignTheme.Light.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>

      <Style x:Key="RowCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="NoteCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
      </Style>

      <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="开关" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Width="40" Height="20" Background="Transparent">
                <Border x:Name="Track"
                        Width="40"
                        Height="20"
                        CornerRadius="10"
                        Background="{DynamicResource BorderBrush}"
                        IsHitTestVisible="False" />
                <Border x:Name="Thumb"
                        Width="14"
                        Height="14"
                        CornerRadius="7"
                        HorizontalAlignment="Left"
                        Margin="3,0"
                        Background="{DynamicResource SecondaryTextBrush}"
                        IsHitTestVisible="False" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                  <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource OnAccentBrush}" />
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ThemedComboBoxStyle / ThemedActionButtonStyle 已提升至 MainWindowStyles.xaml
           （两窗共享的单一事实来源）；本字典仅保留设置窗私有样式。 -->

      <Style x:Key="ReadOnlyPathBoxStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Surface"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedActionButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Height" Value="34" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Border x:Name="WindowShell"
          Style="{StaticResource WindowShellStyle}"
          SizeChanged="WindowShell_SizeChanged">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="11,0,0,0">
        <Grid Background="Transparent">
          <Thumb x:Name="HeaderDragRegion"
                 Style="{StaticResource HeaderThumbStyle}"
                 Cursor="SizeAll"
                 DragDelta="HeaderDragRegion_DragDelta" />
          <TextBlock Text="设置"
                     Margin="16,0"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />
          <Button x:Name="CloseButton"
                  Style="{StaticResource HeaderActionButtonStyle}"
                  HorizontalAlignment="Right"
                  Margin="0,0,8,0"
                  ToolTip="关闭设置"
                  AutomationProperties.Name="关闭设置"
                  Click="CloseButton_Click">
            <Viewbox Width="14" Height="14">
              <Path Data="M0.7071068,0 L7,6.2928932 L13.292893,0 L14,0.7071068 L7.7071068,7 L14,13.292893 L13.292893,14 L7,7.7071068 L0.7071068,14 L0,13.292893 L6.2928932,7 L0,0.7071068 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        Stretch="Uniform" />
            </Viewbox>
          </Button>
        </Grid>
      </Border>

      <!-- 内容高于工作区时窗口已限高（见 code-behind），超出部分在此滚动；
           复用 MainWindowStyles 的全局细滚动条样式。 -->
      <ScrollViewer x:Name="SettingsScrollHost"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14,16,16">
          <TextBlock Text="主题" Style="{StaticResource SectionTitleStyle}" />
          <ComboBox x:Name="ThemeComboBox"
                    Style="{StaticResource ThemedComboBoxStyle}"
                    AutomationProperties.Name="主题"
                    SelectionChanged="ThemeComboBox_SelectionChanged" />

          <TextBlock Text="动效" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,6" />
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="启用界面过渡动画"
                       Style="{StaticResource RowCaptionStyle}" />
            <CheckBox x:Name="AnimationsToggle"
                      Grid.Column="1"
                      Style="{StaticResource ToggleSwitchStyle}"
                      AutomationProperties.Name="启用界面过渡动画"
                      Checked="AnimationsToggle_Checked"
                      Unchecked="AnimationsToggle_Unchecked" />
          </Grid>

          <TextBlock Text="开机自启" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,6" />
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="登录 Windows 时自动运行"
                       Style="{StaticResource RowCaptionStyle}" />
            <CheckBox x:Name="StartupToggle"
                      Grid.Column="1"
                      Style="{StaticResource ToggleSwitchStyle}"
                      AutomationProperties.Name="登录 Windows 时自动运行"
                      Checked="StartupToggle_Checked"
                      Unchecked="StartupToggle_Unchecked" />
          </Grid>
          <TextBlock x:Name="StartupNoteText"
                     Style="{StaticResource NoteCaptionStyle}"
                     Text="运行安装程序更新版本后，自启会重新开启，可在本设置中再次关闭。" />
          <TextBlock x:Name="StartupStatusText"
                     Style="{StaticResource NoteCaptionStyle}"
                     Foreground="{DynamicResource DangerBrush}"
                     Text=""
                     Visibility="Collapsed" />

          <TextBlock Text="全局快捷键" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,6" />
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Ctrl + Alt + V 唤起面板"
                       Style="{StaticResource RowCaptionStyle}" />
            <CheckBox x:Name="GlobalHotkeyToggle"
                      Grid.Column="1"
                      Style="{StaticResource ToggleSwitchStyle}"
                      AutomationProperties.Name="Ctrl + Alt + V 唤起面板"
                      Checked="GlobalHotkeyToggle_Checked"
                      Unchecked="GlobalHotkeyToggle_Unchecked" />
          </Grid>
          <TextBlock x:Name="GlobalHotkeyNoteText"
                     Style="{StaticResource NoteCaptionStyle}"
                     Text="开启后任何界面按组合键展开面板到默认接收分类；默认关闭，组合键被其他软件占用时开启会提示失败。" />
          <TextBlock x:Name="GlobalHotkeyStatusText"
                     Style="{StaticResource NoteCaptionStyle}"
                     Foreground="{DynamicResource DangerBrush}"
                     Text=""
                     Visibility="Collapsed" />

          <TextBlock Text="内容复制" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,6" />
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="右键卡片右半复制到剪贴板"
                       Style="{StaticResource RowCaptionStyle}" />
            <CheckBox x:Name="RightClickCopyToggle"
                      Grid.Column="1"
                      Style="{StaticResource ToggleSwitchStyle}"
                      AutomationProperties.Name="右键卡片右半复制到剪贴板"
                      Checked="RightClickCopyToggle_Checked"
                      Unchecked="RightClickCopyToggle_Unchecked" />
          </Grid>
          <Grid Background="Transparent" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Ctrl + C 复制已选内容"
                       Style="{StaticResource RowCaptionStyle}" />
            <CheckBox x:Name="CtrlCCopyToggle"
                      Grid.Column="1"
                      Style="{StaticResource ToggleSwitchStyle}"
                      AutomationProperties.Name="Ctrl + C 复制已选内容"
                      Checked="CtrlCCopyToggle_Checked"
                      Unchecked="CtrlCCopyToggle_Unchecked" />
          </Grid>
          <TextBlock Style="{StaticResource NoteCaptionStyle}"
                     Text="复制内容与拖出一致；应用自身的复制不会被自动收集重复入库。选中多张卡片后 Ctrl+C：文字按板内顺序合并，图片给出文件组。" />

          <TextBlock Text="垃圾桶按钮" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,6" />
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="无选择时左键"
                       Style="{StaticResource RowCaptionStyle}"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="TrashLeftClickComboBox"
                      Grid.Column="1"
                      Style="{StaticResource ThemedComboBoxStyle}"
                      AutomationProperties.Name="无选择时左键行为"
                      SelectionChanged="TrashLeftClickComboBox_SelectionChanged" />
          </Grid>
          <Grid Background="Transparent" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="无选择时右键"
                       Style="{StaticResource RowCaptionStyle}"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="TrashRightClickComboBox"
                      Grid.Column="1"
                      Style="{StaticResource ThemedComboBoxStyle}"
                      AutomationProperties.Name="无选择时右键行为"
                      SelectionChanged="TrashRightClickComboBox_SelectionChanged" />
          </Grid>
          <TextBlock Style="{StaticResource NoteCaptionStyle}"
                     Text="有选择时点击垃圾桶始终删除已选内容；两种清空都可 Ctrl+Z 整体撤销。" />

          <TextBlock Text="自动清理" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,6" />
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="自动清理非置顶卡片"
                       Style="{StaticResource RowCaptionStyle}" />
            <CheckBox x:Name="AutoCleanupToggle"
                      Grid.Column="1"
                      Style="{StaticResource ToggleSwitchStyle}"
                      AutomationProperties.Name="自动清理非置顶卡片"
                      Checked="AutoCleanupToggle_Checked"
                      Unchecked="AutoCleanupToggle_Unchecked" />
          </Grid>
          <TextBlock Style="{StaticResource NoteCaptionStyle}"
                     Text="开启后每 24 小时自动清理一次各分类中非置顶的卡片（无论创建时间）；置顶卡片与「复盘」内容不受影响，清理后可 Ctrl+Z 撤销（仅本次运行内）。首次清理在开启 24 小时后进行。" />

          <TextBlock Text="数据目录" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,6" />
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DataDirectoryText"
                     Grid.Column="0"
                     Style="{StaticResource ReadOnlyPathBoxStyle}"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="数据目录" />
            <Button x:Name="ChangeDataDirectoryButton"
                    Grid.Column="1"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Content="更改…"
                    Margin="0,0,8,0"
                    ToolTip="更改内容存储位置"
                    AutomationProperties.Name="更改内容存储位置"
                    Click="ChangeDataDirectoryButton_Click" />
            <Button x:Name="OpenDataDirectoryButton"
                    Grid.Column="2"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Content="打开"
                    ToolTip="在资源管理器中打开数据目录"
                    AutomationProperties.Name="在资源管理器中打开数据目录"
                    Click="OpenDataDirectoryButton_Click" />
          </Grid>
          <TextBlock Style="{StaticResource NoteCaptionStyle}"
                     Text="更改时选择一个父文件夹，将在其中创建并管理「悬浮中转站\Data」；内容完整迁移并登记后应用自动重启，旧目录在下次启动确认安全后清理。" />
          <TextBlock x:Name="DataDirectoryStatusText"
                     Style="{StaticResource NoteCaptionStyle}"
                     Foreground="{DynamicResource DangerBrush}"
                     Text=""
                     Visibility="Collapsed" />

          <TextBlock Text="插件" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,6" />
          <StackPanel x:Name="PluginListPanel" />
          <TextBlock x:Name="PluginHelpText" Style="{StaticResource NoteCaptionStyle}" />
          <TextBlock x:Name="PluginStatusText"
                     Style="{StaticResource NoteCaptionStyle}"
                     Foreground="{DynamicResource DangerBrush}"
                     Text=""
                     Visibility="Collapsed" />
          <Grid Background="Transparent" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PluginDirectoryText"
                     Grid.Column="0"
                     Style="{StaticResource ReadOnlyPathBoxStyle}"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="插件目录" />
            <Button x:Name="ChangePluginDirectoryButton"
                    Grid.Column="1"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Content="更改…"
                    Margin="0,0,8,0"
                    ToolTip="更改插件目录"
                    AutomationProperties.Name="更改插件目录"
                    Click="ChangePluginDirectoryButton_Click" />
            <Button x:Name="ResetPluginDirectoryButton"
                    Grid.Column="2"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Content="恢复默认"
                    Margin="0,0,8,0"
                    ToolTip="恢复默认插件目录（数据目录下 plugins）"
                    AutomationProperties.Name="恢复默认插件目录"
                    Click="ResetPluginDirectoryButton_Click" />
            <Button x:Name="OpenPluginDirectoryButton"
                    Grid.Column="3"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Content="打开"
                    ToolTip="在资源管理器中打开插件目录"
                    AutomationProperties.Name="在资源管理器中打开插件目录"
                    Click="OpenPluginDirectoryButton_Click" />
          </Grid>
          <TextBlock x:Name="PluginDirectoryNoteText"
                     Style="{StaticResource NoteCaptionStyle}"
                     Text="插件目录可改为任意文件夹，保存后重启生效；插件的启用状态仍保存在数据目录。" />

          <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,6" />
          <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13">
            <Run x:Name="AppNameRun" FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="VersionRun" Foreground="{DynamicResource SecondaryTextBrush}" />
          </TextBlock>
          <TextBlock FontSize="12" Margin="0,4,0,0">
            <Hyperlink x:Name="RepoLink"
                       NavigateUri="https://github.com/Oiawlm/floating-transfer-station"
                       Foreground="{DynamicResource AccentBrush}"
                       RequestNavigate="RepoLink_RequestNavigate">GitHub 仓库与更新记录</Hyperlink>
          </TextBlock>

          <Button x:Name="ExitButton"
                  Style="{StaticResource ExitButtonStyle}"
                  Content="退出悬浮中转站"
                  Margin="0,20,0,0"
                  ToolTip="保存全部内容后退出"
                  AutomationProperties.Name="退出悬浮中转站"
                  Click="ExitButton_Click" />
        </StackPanel>
      </ScrollViewer>

      <Border Grid.RowSpan="2"
              Panel.ZIndex="10"
              Style="{StaticResource WindowShellOutlineStyle}" />
    </Grid>
  </Border>
</Window>
