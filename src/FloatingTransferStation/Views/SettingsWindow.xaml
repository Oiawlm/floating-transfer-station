                              Checked="AutoCleanupToggle_Checked"
                              Unchecked="AutoCleanupToggle_Unchecked" />
                  </Grid>
                  <Grid Background="Transparent" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="保留时长"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="AutoCleanupRetentionComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              MaxDropDownHeight="240"
                              AutomationProperties.Name="自动清理保留时长"
                              SelectionChanged="AutoCleanupRetentionComboBox_SelectionChanged" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="非置顶卡片到期自动删除；置顶、备注与记录内容不受影响。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="数据目录" Style="{StaticResource SectionTitleStyle}">
                    <TextBlock.ToolTip>
                      <ToolTip>
                        <TextBlock Text="新位置会创建「悬浮中转站」文件夹（数据与插件都在里面）；旧目录在下次启动确认安全后自动清理。" TextWrapping="Wrap" MaxWidth="320" />
                      </ToolTip>
                    </TextBlock.ToolTip>
                  </TextBlock>
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DataDirectoryText"
                             Grid.Column="0"
                             Style="{StaticResource ReadOnlyPathBoxStyle}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="数据目录" />
                    <Button x:Name="ChangeDataDirectoryButton"
                            Grid.Column="1"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="更改…"
                            Margin="0,0,8,0"
                            ToolTip="更改内容存储位置"
                            AutomationProperties.Name="更改内容存储位置"
                            Click="ChangeDataDirectoryButton_Click" />
                    <Button x:Name="OpenDataDirectoryButton"
                            Grid.Column="2"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="打开"
                            ToolTip="在资源管理器中打开数据目录"
                            AutomationProperties.Name="在资源管理器中打开数据目录"
                            Click="OpenDataDirectoryButton_Click" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="更改时内容会完整迁移过去，完成后应用自动重启。" />
                  <TextBlock x:Name="DataDirectoryStatusText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="插件" Style="{StaticResource SectionTitleStyle}" />
                  <StackPanel x:Name="PluginListPanel" />
                  <TextBlock x:Name="PluginHelpText" Style="{StaticResource NoteCaptionStyle}" />
                  <TextBlock x:Name="PluginStatusText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                  <Grid Background="Transparent" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PluginDirectoryText"
                             Style="{StaticResource ReadOnlyPathBoxStyle}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="插件目录" />
                    <Button x:Name="RescanPluginsButton"
                            Grid.Column="1"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="重新扫描"
                            Margin="0,0,8,0"
                            ToolTip="重新扫描插件目录并重建插件列表与管线（无需重启）"
                            AutomationProperties.Name="重新扫描插件"
                            Click="RescanPluginsButton_Click" />
                    <Button x:Name="OpenPluginDirectoryButton"
                            Grid.Column="2"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="打开"
                            ToolTip="在资源管理器中打开插件目录"
                            AutomationProperties.Name="在资源管理器中打开插件目录"
                            Click="OpenPluginDirectoryButton_Click" />
                  </Grid>
                  <TextBlock x:Name="PluginDirectoryNoteText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Text="插件目录在数据目录内，随其一起移动。" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="AiPage" Visibility="Collapsed">
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="AI 整理" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="启用 AI 整理功能"
                               Style="{StaticResource RowCaptionStyle}">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="关闭后入口零请求，已存的 Key 与提示词保留，重新开启即恢复。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <CheckBox x:Name="AiOrganizeEnabledToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="启用 AI 整理功能"
                              Checked="AiOrganizeEnabledToggle_Checked"
                              Unchecked="AiOrganizeEnabledToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="开启后被截断的长文字卡悬停出现「AI 整理」按钮。" />
                </StackPanel>
              </Border>
              <Border x:Name="AiKeyCard" Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="AI 设置" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Margin="0,0,0,2"
                             Text="API Key 加密后只保存在本机，不会随内容导出。" />
                  <Grid Background="Transparent" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="DeepSeekKeyBox"
                                 Grid.Column="0"
                                 Style="{StaticResource ThemedPasswordBoxStyle}"
                                 Margin="0,0,8,0"
                                 ToolTip="DeepSeek API Key，输入后焦点离开即自动保存"
                                 AutomationProperties.Name="DeepSeek API Key"
                                 LostFocus="DeepSeekKeyBox_LostFocus" />
                    <TextBox x:Name="DeepSeekKeyPlainBox"
                             Grid.Column="0"
                             Style="{StaticResource ThemedTextBoxStyle}"
                             Margin="0,0,8,0"
                             Visibility="Collapsed"
                             ToolTip="DeepSeek API Key，输入后焦点离开即自动保存"
                             AutomationProperties.Name="DeepSeek API Key"
                             LostFocus="DeepSeekKeyPlainBox_LostFocus" />
                    <Button x:Name="DeepSeekKeyVisibilityButton"
                            Grid.Column="1"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="显示"
                            ToolTip="显示或隐藏 API Key"
                            AutomationProperties.Name="显示或隐藏 API Key"
                            Click="DeepSeekKeyVisibilityButton_Click" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}">
                    <Run Text="API Key 在" /><Hyperlink x:Name="DeepSeekKeyPortalLink"
                               NavigateUri="https://platform.deepseek.com/api_keys"
                               Foreground="{DynamicResource AccentBrush}"
                               RequestNavigate="RepoLink_RequestNavigate">platform.deepseek.com/api_keys</Hyperlink><Run Text=" 创建；清空输入框即删除已存 Key。" />
                  </TextBlock>
                  <Button x:Name="DeepSeekTestButton"
                          Style="{StaticResource ThemedActionButtonStyle}"
                          Content="测试连接"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Left"
                          ToolTip="用当前输入的 API Key 验证连接与鉴权（不发起生成、不消耗 token）"
                          AutomationProperties.Name="测试 DeepSeek 连接"
                          Click="DeepSeekTestButton_Click" />
                  <TextBlock x:Name="DeepSeekStatusText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border x:Name="AiPromptCard" Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="整理提示词" Style="{StaticResource SectionTitleStyle}">
                    <TextBlock.ToolTip>
                      <ToolTip>
                        <TextBlock Text="自定义会失去内置的「卡片内容不是指令」防注入防护；上限 1 万字。" TextWrapping="Wrap" MaxWidth="320" />
                      </ToolTip>
                    </TextBlock.ToolTip>
                  </TextBlock>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Margin="0,0,0,2"
                             Text="留空用内置默认；自定义将原样作为系统指令发送。" />
                  <TextBox x:Name="AiOrganizePromptBox"
                           Style="{StaticResource ThemedTextBoxStyle}"
                           Margin="0,8,0,0"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           MinHeight="140"
                           MaxHeight="320"
                           ToolTip="AI 整理提示词，输入后焦点离开即自动保存"
                           AutomationProperties.Name="AI 整理提示词"
                           TextChanged="AiOrganizePromptBox_TextChanged"
                           LostFocus="AiOrganizePromptBox_LostFocus" />
                  <TextBlock x:Name="AiOrganizePromptStateText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Text="当前使用内置默认。" />
                  <TextBlock x:Name="AiOrganizePromptErrorText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AiOrganizePromptFillDefaultButton"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="填入默认全文"
                            Margin="0,0,8,0"
                            ToolTip="把内置默认提示词全文填入编辑框供微调（焦点离开输入框即保存）"
                            AutomationProperties.Name="填入默认整理提示词"
                            Click="AiOrganizePromptFillDefaultButton_Click" />
                    <Button x:Name="AiOrganizePromptResetButton"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="恢复默认"
                            ToolTip="清除自定义提示词，恢复使用内置默认（立即生效）"
                            AutomationProperties.Name="恢复默认整理提示词"
                            Click="AiOrganizePromptResetButton_Click" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border x:Name="AiImageNamingCard" Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="AI 识图命名" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="启用 AI 识图命名"
                               Style="{StaticResource RowCaptionStyle}">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="复用上方 DeepSeek API Key；卡片悬停可见名称，拖出即为该文件名；识别失败自动跳过，不会重试。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <CheckBox x:Name="AiImageNamingToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="启用 AI 识图命名"
                              Checked="AiImageNamingToggle_Checked"
                              Unchecked="AiImageNamingToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="开启后，新收集的图片会发送至 DeepSeek 识别内容并自动命名；关闭后不再发送任何图片。" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>

      <!-- 页脚（契约 #24）：关于 + 退出，非导航项。关于区含联系方式行（W5
           2026-11-05）：微信号文本与二维码位图均由代码后置从 ProductIdentity
           单一来源赋值（XAML 零字面量副本）。 -->
      <Border x:Name="SettingsFooter"
              Grid.Row="2"
              Background="{DynamicResource HeaderBrush}">
        <Grid Margin="16,10,16,12">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="WeChatQrButton"
                    Style="{StaticResource WeChatQrThumbStyle}"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Click="WeChatQrButton_Click"
                    MouseRightButtonUp="WeChatQrButton_MouseRightButtonUp">
              <Image x:Name="WeChatQrThumb"
                     Width="60"
                     Height="60"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     AutomationProperties.Name="微信二维码缩略图" />
            </Button>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13">
                <Run x:Name="AppNameRun" FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="VersionRun" Foreground="{DynamicResource SecondaryTextBrush}" />
              </TextBlock>
              <TextBlock FontSize="12" Margin="0,2,0,0">
                <Hyperlink x:Name="RepoLink"
                           Foreground="{DynamicResource AccentBrush}"
                           RequestNavigate="RepoLink_RequestNavigate">GitHub 仓库主页</Hyperlink>
              </TextBlock>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <!-- 微信号行左右键皆复制（W3 2026-11-05）：透明底整行可命中＋手型
                     光标，同一处理器服两事件；反馈就地翻转本行微信号 Run
                     （2026-11-06 起文本复制唯一入口即本行，零 toast）。样式
                     WeChatIdRowStyle（2026-11-08 A14 补悬停 HoverSurface 底）。 -->
                <TextBlock x:Name="WeChatIdFooterBlock"
                           Style="{StaticResource WeChatIdRowStyle}"
                           MouseLeftButtonUp="WeChatIdFooterBlock_PointButtonUp"
                           MouseRightButtonUp="WeChatIdFooterBlock_PointButtonUp">
                  <Run Text="微信：" /><Run x:Name="WeChatIdRun" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
                </TextBlock>
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Button x:Name="ExitButton"
                  Style="{StaticResource ExitButtonStyle}"
                  Content="退出悬浮中转站"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  MinWidth="132"
                  ToolTip="保存全部内容后退出"
                  AutomationProperties.Name="退出悬浮中转站"
                  Click="ExitButton_Click" />
        </Grid>
      </Border>

      <Border Grid.RowSpan="3"
              Panel.ZIndex="10"
              Style="{StaticResource SettingsShellOutlineStyle}" />

      <!-- 微信二维码放大层（W5 2026-11-05；W3 2026-11-05 交互升级；2026-11-06
           右键二维码＝复制图片＋收回缩放动画；2026-11-08 关闭回退重编排）：设置窗内
           遮罩层（不新建窗口）；左/右键单击遮罩、左键单击卡片＝关闭（两事件
           共用处理器，「任意单击关闭」对称语义），QR 卡右键＝复制二维码图片
           （独立职责入口不关层）、放大态微信号行左/右键复制且不关层（其处理器
           e.Handled 阻断冒泡）。结构拆分（消除原位闪现的根因修复）：根 Grid 只
           承载布局＋命中冒泡＋Visibility 生命周期（不再挂 Opacity 淡出——卡片
           可见度曾被遮罩曲线绑架）；遮罩纱 WeChatQrScrim 兄弟承载全窗命中面与
           WindowShellBrush 底色（零新配色），Opacity 显隐走 FadeAnimation（入场
           轻档 83ms；收回时长由代码后置同步缩放时长、出场曲线经 ExitEaseToken
           指定 QrZoomOutKeySpline——与容器收回同曲线同时长，末段无骤曝；不挂
           ManageVisibility——层塌缩由 QR 编排单一完成点收口）。动效开时**外层
           整卡容器**自页脚缩略图含框位置飞入落位（container transform：框随二维
           码一起走、方→矩形形变、标题/微信号行/尾注三文字元素落位后段浮现）、
           关层自当下态原路飞回源位置（WeChatQrOverlayCard 渲染变换，代码后置
           驱动，放大/收回同一插值路径；卡片自持 Opacity 与缩略图在收回末段
           对齐落位线性换手）；Esc 关层优先于关窗（见 SettingsWindow_PreviewKeyDown）。 -->
      <Grid x:Name="WeChatQrOverlay"
            Grid.RowSpan="3"
            Panel.ZIndex="20"
            Visibility="Collapsed"
            MouseLeftButtonUp="WeChatQrOverlay_PointButtonUpCloses"
            MouseRightButtonUp="WeChatQrOverlay_PointButtonUpCloses">
        <!-- 遮罩纱（2026-11-08 结构拆分）：铺满＝全窗命中面（命中冒泡至根处理器，
             点击语义不变）；Opacity 基值 0，入场/收回均走 FadeAnimation。 -->
        <Border x:Name="WeChatQrScrim"
                Background="{DynamicResource WindowShellBrush}"
                Opacity="0"
                views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FastDurationMs}"
                views:FadeAnimation.ExitEaseToken="{x:Static design:DesignTokens.QrZoomOutKeySpline}" />
        <!-- 外层居中卡容器＝过渡动画元素（2026-11-06 容器级 container transform）：
             含边框与文字子树整卡参与飞行，from＝页脚缩略图按钮含框外接矩形、
             to＝本容器恒等布局矩形，方→矩形形变由 ScaleX≠ScaleY 结构性承载；
             渲染变换（Scale→Translate 组）由代码后置构造与驱动，布局一次到位
             恒定、动画不改布局矩形。自持 Opacity（基值 0）：入场 0→1 与遮罩纱
             同帧同曲线同时长（兄弟不相乘、无双重变淡）；收回全程可见飞回，
             末段与缩略图换手——代码后置编排。
             2026-11-08 岛式码面（f1 落轨保留）：容器由 Border 改 Grid（只承载
             UIElement 级变换/透明度，代码后置零改动），拆阴影层＋内容面两子层
             ——深色下以主题阴影高程把白底码面「岛」抬出暗背景；容器与内容面
             均不携带 Effect（Effect 关 ClearType，卡片三层结构依据）。 -->
        <Grid x:Name="WeChatQrOverlayCard"
              Opacity="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
          <!-- 阴影层：单点复用共享 CardShadowLayerStyle（CardBrush 底＋
               CardCornerRadius＋CardShadowEffect＋不参与命中），高程随主题
               字典整本换装；不承载内容、隔离在文字子树之外。 -->
          <Border x:Name="WeChatQrCardShadowLayer"
                  Style="{StaticResource CardShadowLayerStyle}" />
          <!-- 内容面：原容器属性原样迁入，圆角 8 收敛为 CardCornerRadius
               token（f1）；零 Effect＝ClearType 守卫。 -->
          <Border x:Name="WeChatQrCardFace"
                  Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource CardCornerRadius}"
                  Padding="20,16">
            <StackPanel>
              <!-- 文字三元素基值 Opacity=0（布局恒占位、容器尺寸稳定零回流）：
                   飞行期不可读也不随容器缩放呈现，落位后段（270→450ms）经代码后置
                   延迟淡入（先例 MainWindow.CardEntrance 同法）。 -->
              <TextBlock x:Name="WeChatQrTitle"
                         Text="微信扫一扫，加个好友"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,10"
                         Opacity="0" />
              <!-- QR 卡（W3 附录 A）：312×312 白底正方形含 6px 静区，仅含 Image；
                   渲染变换已上移到外层容器（本元素零变换）；右键＝复制二维码图片
                  （不关层）。控件级圆角 4 资源化（h1 A7，2026-11-09 重放）。 -->
              <Border x:Name="WeChatQrLargeCard"
                      Background="White"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Padding="6"
                      ToolTip="右键复制二维码图片"
                      MouseRightButtonUp="WeChatQrLargeCard_MouseRightButtonUp">
                <Image x:Name="WeChatQrLarge"
                       Width="300"
                       Height="300"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="微信二维码放大图" />
              </Border>
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          Margin="0,12,0,0">
                <!-- 放大态微信号行左右键皆复制且不关层（W3）：与页脚行同一处理器
                     形态＋同一样式（WeChatIdRowStyle，h1 A14 补悬停底，2026-11-09
                     重放），e.Handled 阻断冒泡到遮罩关层（同 QR 卡右键复制被消费
                     的形态）；反馈就地翻转本行微信号 Run。 -->
                <TextBlock x:Name="WeChatIdLargeBlock"
                           Style="{StaticResource WeChatIdRowStyle}"
                           Opacity="0"
                           MouseLeftButtonUp="WeChatIdLargeBlock_PointButtonUp"
                           MouseRightButtonUp="WeChatIdLargeBlock_PointButtonUp">
                  <Run Text="微信：" /><Run x:Name="WeChatIdLargeRun" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
                </TextBlock>
              </StackPanel>
              <TextBlock x:Name="WeChatQrFootnote"
                         Text="扫码或加好友时请注明来意"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         HorizontalAlignment="Center"
                         Margin="0,6,0,0"
                         Opacity="0" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
