                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="登录 Windows 时自动运行"
                              Checked="StartupToggle_Checked"
                              Unchecked="StartupToggle_Unchecked" />
                  </Grid>
                  <TextBlock x:Name="StartupNoteText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Text="运行安装程序更新版本后，自启会重新开启，可在本设置中再次关闭。" />
