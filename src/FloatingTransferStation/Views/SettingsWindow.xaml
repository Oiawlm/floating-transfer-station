                             Text="当前使用内置默认。" />
                  <TextBlock x:Name="AiOrganizePromptErrorText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AiOrganizePromptFillDefaultButton"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="填入默认全文"
                            Margin="0,0,8,0"
                            ToolTip="把内置默认提示词全文填入编辑框供微调（焦点离开输入框即保存）"
                            AutomationProperties.Name="填入默认整理提示词"
                            Click="AiOrganizePromptFillDefaultButton_Click" />
                    <Button x:Name="AiOrganizePromptResetButton"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="恢复默认"
                            ToolTip="清除自定义提示词，恢复使用内置默认（立即生效）"
                            AutomationProperties.Name="恢复默认整理提示词"
                            Click="AiOrganizePromptResetButton_Click" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>

      <!-- 页脚（契约 #24）：关于 + 退出，非导航项。关于区含联系方式行（W5
           2026-11-05）：微信号文本与二维码位图均由代码后置从 ProductIdentity
           单一来源赋值（XAML 零字面量副本）。 -->
      <Border x:Name="SettingsFooter"
              Grid.Row="2"
              Background="{DynamicResource HeaderBrush}">
        <Grid Margin="16,10,16,12">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="WeChatQrButton"
                    Style="{StaticResource WeChatQrThumbStyle}"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Click="WeChatQrButton_Click"
                    MouseRightButtonUp="WeChatQrButton_MouseRightButtonUp">
              <Image x:Name="WeChatQrThumb"
                     Width="60"
                     Height="60"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     AutomationProperties.Name="微信二维码缩略图" />
            </Button>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13">
                <Run x:Name="AppNameRun" FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="VersionRun" Foreground="{DynamicResource SecondaryTextBrush}" />
              </TextBlock>
              <TextBlock FontSize="12" Margin="0,2,0,0">
                <Hyperlink x:Name="RepoLink"
                           Foreground="{DynamicResource AccentBrush}"
                           RequestNavigate="RepoLink_RequestNavigate">GitHub 仓库主页</Hyperlink>
              </TextBlock>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <!-- 微信号行左右键皆复制（W3 2026-11-05）：透明底整行可命中＋手型
                     光标，同一处理器服两事件；反馈就地在相邻复制按钮（零 toast）。 -->
                <TextBlock x:Name="WeChatIdFooterBlock"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Background="Transparent"
                           Cursor="Hand"
                           ToolTip="复制微信号"
                           MouseLeftButtonUp="WeChatIdFooterBlock_PointButtonUp"
                           MouseRightButtonUp="WeChatIdFooterBlock_PointButtonUp">
                  <Run Text="微信：" /><Run x:Name="WeChatIdRun" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
                </TextBlock>
                <Button x:Name="WeChatCopyButton"
                        Style="{StaticResource FooterCopyButtonStyle}"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Content="复制"
                        ToolTip="复制微信号到剪贴板"
                        AutomationProperties.Name="复制微信号"
                        Click="WeChatCopyButton_Click" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Button x:Name="ExitButton"
                  Style="{StaticResource ExitButtonStyle}"
                  Content="退出悬浮中转站"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  MinWidth="132"
                  ToolTip="保存全部内容后退出"
                  AutomationProperties.Name="退出悬浮中转站"
                  Click="ExitButton_Click" />
        </Grid>
      </Border>

      <Border Grid.RowSpan="3"
              Panel.ZIndex="10"
              Style="{StaticResource SettingsShellOutlineStyle}" />

      <!-- 微信二维码放大层（W5 2026-11-05；W3 2026-11-05 交互升级）：设置窗内
           遮罩层（不新建窗口），遮罩用既有 WindowShellBrush 键（零新配色）；
           左/右键单击遮罩或卡片非按钮区域＝关闭（两事件共用处理器，「任意单击
           关闭」对称语义），复制按钮是独立职责入口不关闭、放大态微信号行左/右
           键复制且不关层（其处理器 e.Handled 阻断冒泡）；显隐走 FadeAnimation
           统一管理（轻档 83ms，动效关闭立即切换），动效开时 QR 卡自页脚缩略图
           源位置缩放入场（WeChatQrLargeCard 渲染变换，代码后置驱动）；
           Esc 关层优先于关窗（见 SettingsWindow_PreviewKeyDown）。 -->
      <Grid x:Name="WeChatQrOverlay"
            Grid.RowSpan="3"
            Panel.ZIndex="20"
            Background="{DynamicResource WindowShellBrush}"
            Visibility="Collapsed"
            Opacity="0"
            views:FadeAnimation.ManageVisibility="True"
            views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.FastDurationMs}"
            MouseLeftButtonUp="WeChatQrOverlay_PointButtonUpCloses"
            MouseRightButtonUp="WeChatQrOverlay_PointButtonUpCloses">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,16">
          <StackPanel>
            <TextBlock Text="微信扫一扫，加个好友"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10" />
            <!-- QR 卡＝缩放入场动画元素（W3 附录 A）：312×312 白底正方形含 6px
                 静区，仅含 Image；渲染变换（Scale→Translate 组）由代码后置构造
                 与驱动，布局一次到位恒定。 -->
            <Border x:Name="WeChatQrLargeCard"
                    Background="White"
                    CornerRadius="4"
                    Padding="6">
              <Image x:Name="WeChatQrLarge"
                     Width="300"
                     Height="300"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     AutomationProperties.Name="微信二维码放大图" />
            </Border>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0">
              <!-- 放大态微信号行左右键皆复制且不关层（W3）：与页脚行同一处理器
                   形态，e.Handled 阻断冒泡到遮罩关层（与复制按钮被 Button 消费
                   同型）；反馈就地在相邻复制按钮。 -->
              <TextBlock x:Name="WeChatIdLargeBlock"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Background="Transparent"
                         Cursor="Hand"
                         ToolTip="复制微信号"
                         MouseLeftButtonUp="WeChatIdLargeBlock_PointButtonUp"
                         MouseRightButtonUp="WeChatIdLargeBlock_PointButtonUp">
                <Run Text="微信：" /><Run x:Name="WeChatIdLargeRun" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
              </TextBlock>
              <Button x:Name="WeChatCopyLargeButton"
                      Style="{StaticResource FooterCopyButtonStyle}"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Content="复制"
                      ToolTip="复制微信号到剪贴板"
                      AutomationProperties.Name="复制微信号"
                      Click="WeChatCopyButton_Click" />
            </StackPanel>
            <TextBlock Text="扫码或加好友时请注明来意"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
