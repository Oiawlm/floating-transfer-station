<Window x:Class="FloatingTransferStation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="clr-namespace:FloatingTransferStation.Design;assembly=FloatingTransferStation.Core"
        Title="设置"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        Width="{x:Static design:SettingsWindowMetrics.DefaultWidth}"
        Height="{x:Static design:SettingsWindowMetrics.DefaultHeight}"
        MinWidth="{x:Static design:SettingsWindowMetrics.MinWidth}"
        MinHeight="{x:Static design:SettingsWindowMetrics.MinHeight}"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable, Segoe UI"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">
  <!-- 复用主窗 Mica 壳技术：整窗玻璃帧承载 DWM 材质，圆角由 DWM 裁剪。
       几何契约（#24，Issue #106）：SizeToContent=Manual + CanResize + 系统级
       8 向缩放（ResizeBorderThickness=6），固定视口由内部 ScrollViewer 承担滚动；
       冻结数值全部来自 SettingsWindowMetrics 单点声明。交互缩放与最大化的
       上限不由 Window.MaxWidth/MaxHeight 声明（1.50.0 教训：属性会把根视觉钳出
       死区），而是经 WM_GETMINMAXINFO 轨道尺寸强制；壳层铺满整个 HWND，
       内容列以 ContentColumnMaxWidth 居中有界。 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  GlassFrameThickness="-1"
                  ResizeBorderThickness="6"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/MainWindowStyles.xaml" />
        <ResourceDictionary Source="../Resources/DesignTheme.Light.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>

      <Style x:Key="RowCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="NoteCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
      </Style>

      <!-- 设置节卡片（契约 #24 设计语言）：既有卡片语言分组，颜色全走主题键。
           页内最后一张卡片用本地 Margin="0" 收尾。 -->
      <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>

      <!-- 左导航项（契约 #24）：RadioButton 原生带 SelectionItem 语义与 UIA peer，
           风格同主窗分类轨——选中态 ActiveCategory 底 + 强调色指示条。 -->
      <Style x:Key="SettingsNavItemStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid>
                <Border x:Name="ItemSurface"
                        Background="Transparent"
                        CornerRadius="7" />
                <Border x:Name="SelectionIndicator"
                        Width="3"
                        Margin="0,8"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="1.5"
                        Visibility="Collapsed"
                        IsHitTestVisible="False" />
                <ContentPresenter Margin="16,0,8,0"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="False" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
                  <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="开关" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Width="40" Height="20" Background="Transparent">
                <Border x:Name="Track"
                        Width="40"
                        Height="20"
                        CornerRadius="10"
                        Background="{DynamicResource BorderBrush}"
                        IsHitTestVisible="False" />
                <Border x:Name="Thumb"
                        Width="14"
                        Height="14"
                        CornerRadius="7"
                        HorizontalAlignment="Left"
                        Margin="3,0"
                        Background="{DynamicResource SecondaryTextBrush}"
                        IsHitTestVisible="False" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                  <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource OnAccentBrush}" />
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ThemedComboBoxStyle / ThemedActionButtonStyle 已提升至 MainWindowStyles.xaml
           （两窗共享的单一事实来源）；本字典仅保留设置窗私有样式。 -->

      <Style x:Key="ReadOnlyPathBoxStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Surface"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SettingsShellOutlineStyle" TargetType="Border" BasedOn="{StaticResource WindowShellOutlineStyle}">
        <!-- 独立浮动窗口（非贴右缘停靠）：四边描边补齐左缘。 -->
        <Setter Property="BorderThickness" Value="1" />
      </Style>

      <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedActionButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Height" Value="34" />
      </Style>

      <!-- 密码输入框（AI 设置的 API Key 行）：与 ThemedTextBoxStyle 同法的纯 Setter 版，
           默认模板自带掩码显示，颜色一律走主题键。 -->
      <Style x:Key="ThemedPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.5" />
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Border x:Name="WindowShell"
          Style="{StaticResource WindowShellStyle}"
          SizeChanged="WindowShell_SizeChanged">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="11,11,0,0">
        <Grid Background="Transparent">
          <Thumb x:Name="HeaderDragRegion"
                 Style="{StaticResource HeaderThumbStyle}"
                 Cursor="SizeAll"
                 DragDelta="HeaderDragRegion_DragDelta"
                 DragCompleted="HeaderDragRegion_DragCompleted" />
          <TextBlock Text="设置"
                     Margin="16,0"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />
          <Button x:Name="CloseButton"
                  Style="{StaticResource HeaderActionButtonStyle}"
                  HorizontalAlignment="Right"
                  Margin="0,0,8,0"
                  ToolTip="关闭设置"
                  AutomationProperties.Name="关闭设置"
                  Click="CloseButton_Click">
            <Viewbox Width="14" Height="14">
              <Path Data="M0.7071068,0 L7,6.2928932 L13.292893,0 L14,0.7071068 L7.7071068,7 L14,13.292893 L13.292893,14 L7,7.7071068 L0.7071068,14 L0,13.292893 L6.2928932,7 L0,0.7071068 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        Stretch="Uniform" />
            </Viewbox>
          </Button>
        </Grid>
      </Border>

      <!-- 双栏主体（契约 #24，分组冻结表）：左导航 5 组 + 右内容页；
           SettingsScrollHost 是全部页共享的唯一滚动视口（x:Name 单一实例），
           页切换只翻 Visibility，可视树直书保证 43 个既有 x:Name 保持在窗口
           同一 namescope（FindName/UIA 全可达）。 -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="148" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource TabRailBrush}">
          <StackPanel x:Name="SettingsNavList"
                      Margin="0,8"
                      KeyboardNavigation.TabNavigation="Continue"
                      PreviewKeyDown="SettingsNavList_PreviewKeyDown">
            <RadioButton x:Name="SettingsNavAppearance"
                         GroupName="SettingsNav"
                         Content="外观"
                         Tag="AppearancePage"
                         IsChecked="True"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="外观"
                         Checked="SettingsNavItem_Checked" />
            <RadioButton x:Name="SettingsNavPanel"
                         GroupName="SettingsNav"
                         Content="面板"
                         Tag="PanelPage"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="面板"
                         Checked="SettingsNavItem_Checked" />
            <RadioButton x:Name="SettingsNavGeneral"
                         GroupName="SettingsNav"
                         Content="通用"
                         Tag="GeneralPage"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="通用"
                         Checked="SettingsNavItem_Checked" />
            <RadioButton x:Name="SettingsNavData"
                         GroupName="SettingsNav"
                         Content="数据与维护"
                         Tag="DataPage"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="数据与维护"
                         Checked="SettingsNavItem_Checked" />
            <RadioButton x:Name="SettingsNavAi"
                         GroupName="SettingsNav"
                         Content="AI"
                         Tag="AiPage"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="AI"
                         Checked="SettingsNavItem_Checked" />
          </StackPanel>
        </Border>
        <!-- 共享滚动视口挂既有 keyed overlay 模板（契约 #23 机制扩展，2026-10-19
             Issue #200）：五内容页高度不同，默认模板的布局滚动条出现/消失会让内容
             列在「全宽」与「全宽−滚动条宽」间跳变——溢出页卡片比不溢出页窄。单格
             叠加让条带悬浮内容之上、永不占布局宽，五页卡片宽度在任何窗口高度下
             逐 DIP 相等；条带 8 DIP 落在内容列 16 DIP 右边距带内，与卡片零相交。
             样式与本窗合并字典中的隐式瘦条 ScrollBar 样式同源（MainWindowStyles）。 -->
        <ScrollViewer x:Name="SettingsScrollHost"
                      Grid.Column="1"
                      Style="{StaticResource OverlayScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <!-- 内容列：720 上限内铺满视口（Stretch＋MaxWidth：槽宽不足取槽宽、
               超出上限取 720 并居中——WPF 对受 Max 钳制的 Stretch 自动按居中落位，
               兼得 #24「720 上限水平居中」）。Center 会让列宽随最宽卡片收窄，
               五页内容不同宽 → 卡片宽度页页不等（2026-10-19 根因修订，Issue #200）。 -->
          <Grid x:Name="SettingsContentHost"
                Margin="16,14,16,16"
                MaxWidth="{x:Static design:SettingsWindowMetrics.ContentColumnMaxWidth}"
                HorizontalAlignment="Stretch">
            <StackPanel x:Name="AppearancePage">
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="主题" Style="{StaticResource SectionTitleStyle}" />
                  <ComboBox x:Name="ThemeComboBox"
                            Style="{StaticResource ThemedComboBoxStyle}"
                            AutomationProperties.Name="主题"
                            SelectionChanged="ThemeComboBox_SelectionChanged" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="动效" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="启用界面过渡动画"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="AnimationsToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="启用界面过渡动画"
                              Checked="AnimationsToggle_Checked"
                              Unchecked="AnimationsToggle_Unchecked" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="置顶分隔" Style="{StaticResource SectionTitleStyle}" />
                  <ComboBox x:Name="PinnedDividerComboBox"
                            Style="{StaticResource ThemedComboBoxStyle}"
                            AutomationProperties.Name="置顶分隔样式"
                            SelectionChanged="PinnedDividerComboBox_SelectionChanged" />
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="选择置顶区与普通区之间的分隔样式；改动立即生效并自动保存。" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PanelPage" Visibility="Collapsed">
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="标签顺序" Style="{StaticResource SectionTitleStyle}" />
                  <Grid x:Name="CategoryOrderHost" ClipToBounds="True">
                    <StackPanel x:Name="CategoryOrderList" />
                    <Border x:Name="CategoryOrderInsertionIndicator"
                            Height="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="拖拽调整四个标签的显示顺序（图片 / 复盘 / 启动 / 待分类）；仅调整顺序，不能增删。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="内容复制" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Ctrl + C 复制已选内容"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="CtrlCCopyToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="Ctrl + C 复制已选内容"
                              Checked="CtrlCCopyToggle_Checked"
                              Unchecked="CtrlCCopyToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="卡片右半左键单击即复制这一张（统一手势，不可关闭）；复制内容与拖出一致，应用自身的复制不会被自动收集重复入库。选中多张卡片后 Ctrl+C：文字按板内顺序合并，图片给出文件组。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="垃圾桶按钮" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="无选择时左键"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="TrashLeftClickComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              AutomationProperties.Name="无选择时左键行为"
                              SelectionChanged="TrashLeftClickComboBox_SelectionChanged" />
                  </Grid>
                  <Grid Background="Transparent" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="无选择时右键"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="TrashRightClickComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              AutomationProperties.Name="无选择时右键行为"
                              SelectionChanged="TrashRightClickComboBox_SelectionChanged" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="有选择时点击垃圾桶始终删除已选内容；两种清空都可 Ctrl+Z 整体撤销。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="卡片备注" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="允许短卡片添加备注"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="ShortCardNotesToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="允许短卡片添加备注"
                              Checked="ShortCardNotesToggle_Checked"
                              Unchecked="ShortCardNotesToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="默认只对正文被截断的长卡出现备注入口；开启后所有文字卡都可以添加备注（AI 整理按钮仍只对长文出现）。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="启动·列数" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="启动面瓦片列数"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="LauncherColumnStrategyComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              AutomationProperties.Name="启动器列数策略"
                              SelectionChanged="LauncherColumnStrategyComboBox_SelectionChanged" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="自适应＝列数随面板宽度在 3–6 列间自动增减（默认）；固定列数不随宽度变化，瓦片宽按剩余空间摊分，窄面板配大列数会压缩瓦片。改动立即生效并自动保存。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="启动·自动发现" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="自动发现新安装的应用"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="LauncherDiscoveryToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="自动发现新安装的应用"
                              Checked="LauncherDiscoveryToggle_Checked"
                              Unchecked="LauncherDiscoveryToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="监视开始菜单（用户＋公共）与下方文件夹，新装应用进入启动面「发现 N」待确认清单——多选添加或忽略，绝不自动上屏；忽略会被持久记住。" />
                  <TextBlock Text="监视文件夹"
                             Style="{StaticResource RowCaptionStyle}"
                             Margin="0,10,0,0" />
                  <StackPanel x:Name="LauncherDiscoveryFolderList" MinHeight="4" />
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LauncherDiscoveryFolderInput"
                             Style="{StaticResource ThemedTextBoxStyle}"
                             Height="32"
                             FontSize="12"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="监视文件夹路径" />
                    <Button x:Name="LauncherDiscoveryFolderBrowseButton"
                            Grid.Column="1"
                            Content="浏览…"
                            FontSize="12"
                            Height="32"
                            Padding="12,0"
                            Margin="8,0,0,0"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            AutomationProperties.Name="浏览监视文件夹"
                            Click="LauncherDiscoveryFolderBrowse_Click" />
                    <Button x:Name="LauncherDiscoveryFolderAddButton"
                            Grid.Column="2"
                            Content="添加"
                            FontSize="12"
                            Height="32"
                            Padding="12,0"
                            Margin="8,0,0,0"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            AutomationProperties.Name="添加监视文件夹"
                            Click="LauncherDiscoveryFolderAdd_Click" />
                  </Grid>
                  <TextBlock x:Name="LauncherDiscoveryFolderStatus"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="文件夹需存在且为完整路径；.lnk 全收，.exe 自动过滤卸载器/更新器等辅助程序；开关与文件夹改动立即生效并自动保存。" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="开机自启" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="登录 Windows 时自动运行"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="StartupToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="登录 Windows 时自动运行"
                              Checked="StartupToggle_Checked"
                              Unchecked="StartupToggle_Unchecked" />
                  </Grid>
                  <TextBlock x:Name="StartupNoteText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Text="运行安装程序更新版本后，自启会重新开启，可在本设置中再次关闭。" />
                  <TextBlock x:Name="StartupStatusText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="全局快捷键" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Ctrl + Alt + V 唤起面板"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="GlobalHotkeyToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="Ctrl + Alt + V 唤起面板"
                              Checked="GlobalHotkeyToggle_Checked"
                              Unchecked="GlobalHotkeyToggle_Unchecked" />
                  </Grid>
                  <TextBlock x:Name="GlobalHotkeyNoteText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Text="开启后任何界面按组合键展开面板到默认接收分类；默认关闭，组合键被其他软件占用时开启会提示失败。" />
                  <TextBlock x:Name="GlobalHotkeyStatusText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="自动检查更新" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="启动 30 秒后检查，之后每 24 小时一次"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="AutoUpdateCheckToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="自动检查更新"
                              Checked="AutoUpdateCheckToggle_Checked"
                              Unchecked="AutoUpdateCheckToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="检查在后台静默进行；发现新版本时标题栏「更新」按钮会点亮，点击即可自动下载安装。关闭后仍可随时点击该按钮手动检查。" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="DataPage" Visibility="Collapsed">
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="自动清理" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="自动清理非置顶卡片"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="AutoCleanupToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="自动清理非置顶卡片"
                              Checked="AutoCleanupToggle_Checked"
                              Unchecked="AutoCleanupToggle_Unchecked" />
                  </Grid>
                  <Grid Background="Transparent" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="保留时长"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="AutoCleanupRetentionComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              MaxDropDownHeight="240"
                              AutomationProperties.Name="自动清理保留时长"
                              SelectionChanged="AutoCleanupRetentionComboBox_SelectionChanged" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="每张非置顶卡片入库满所选时长即自动删除；置顶卡片与「复盘」内容不受影响；可 Ctrl+Z 撤销（仅本次运行内）；每小时检查一次，改短时长后已超龄的卡片在下次检查时清理；默认 24 小时。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="数据目录" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DataDirectoryText"
                             Grid.Column="0"
                             Style="{StaticResource ReadOnlyPathBoxStyle}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="数据目录" />
                    <Button x:Name="ChangeDataDirectoryButton"
                            Grid.Column="1"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="更改…"
                            Margin="0,0,8,0"
                            ToolTip="更改内容存储位置"
                            AutomationProperties.Name="更改内容存储位置"
                            Click="ChangeDataDirectoryButton_Click" />
                    <Button x:Name="OpenDataDirectoryButton"
                            Grid.Column="2"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="打开"
                            ToolTip="在资源管理器中打开数据目录"
                            AutomationProperties.Name="在资源管理器中打开数据目录"
                            Click="OpenDataDirectoryButton_Click" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="更改时选择一个父文件夹，将在其中创建并管理「悬浮中转站\Data」；内容完整迁移并登记后应用自动重启，旧目录在下次启动确认安全后清理。" />
                  <TextBlock x:Name="DataDirectoryStatusText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="插件" Style="{StaticResource SectionTitleStyle}" />
                  <StackPanel x:Name="PluginListPanel" />
                  <TextBlock x:Name="PluginHelpText" Style="{StaticResource NoteCaptionStyle}" />
                  <TextBlock x:Name="PluginStatusText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                  <Grid Background="Transparent" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PluginDirectoryText"
                             Grid.Column="0"
                             Style="{StaticResource ReadOnlyPathBoxStyle}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="插件目录" />
                    <Button x:Name="ChangePluginDirectoryButton"
                            Grid.Column="1"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="更改…"
                            Margin="0,0,8,0"
                            ToolTip="更改插件目录"
                            AutomationProperties.Name="更改插件目录"
                            Click="ChangePluginDirectoryButton_Click" />
                    <Button x:Name="ResetPluginDirectoryButton"
                            Grid.Column="2"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="恢复默认"
                            Margin="0,0,8,0"
                            ToolTip="恢复默认插件目录（数据目录下 plugins）"
                            AutomationProperties.Name="恢复默认插件目录"
                            Click="ResetPluginDirectoryButton_Click" />
                    <Button x:Name="RescanPluginsButton"
                            Grid.Column="3"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="重新扫描"
                            Margin="0,0,8,0"
                            ToolTip="重新扫描插件目录并重建插件列表与管线（无需重启）"
                            AutomationProperties.Name="重新扫描插件"
                            Click="RescanPluginsButton_Click" />
                    <Button x:Name="OpenPluginDirectoryButton"
                            Grid.Column="4"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="打开"
                            ToolTip="在资源管理器中打开插件目录"
                            AutomationProperties.Name="在资源管理器中打开插件目录"
                            Click="OpenPluginDirectoryButton_Click" />
                  </Grid>
                  <TextBlock x:Name="PluginDirectoryNoteText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Text="插件目录可改为任意文件夹，保存后重启生效；插件的启用状态仍保存在数据目录。" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="AiPage" Visibility="Collapsed">
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="AI 整理" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="启用 AI 整理功能"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="AiOrganizeEnabledToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="启用 AI 整理功能"
                              Checked="AiOrganizeEnabledToggle_Checked"
                              Unchecked="AiOrganizeEnabledToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="关闭后卡片上的 AI 整理按钮不再出现，整理入口不再发起任何请求；已保存的 API Key 与自定义提示词原样保留，仅停用不删除。改动立即生效并自动保存。" />
                </StackPanel>
              </Border>
              <Border x:Name="AiKeyCard" Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="AI 设置" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Margin="0,0,0,2"
                             Text="配置 DeepSeek 官方 API，供后续 AI 功能整理剪贴板与卡片内容。API Key 经系统加密后仅保存在本机，不会随内容导出。" />
                  <Grid Background="Transparent" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="DeepSeekKeyBox"
                                 Grid.Column="0"
                                 Style="{StaticResource ThemedPasswordBoxStyle}"
                                 Margin="0,0,8,0"
                                 ToolTip="DeepSeek API Key，输入后焦点离开即自动保存"
                                 AutomationProperties.Name="DeepSeek API Key"
                                 LostFocus="DeepSeekKeyBox_LostFocus" />
                    <TextBox x:Name="DeepSeekKeyPlainBox"
                             Grid.Column="0"
                             Style="{StaticResource ThemedTextBoxStyle}"
                             Margin="0,0,8,0"
                             Visibility="Collapsed"
                             ToolTip="DeepSeek API Key，输入后焦点离开即自动保存"
                             AutomationProperties.Name="DeepSeek API Key"
                             LostFocus="DeepSeekKeyPlainBox_LostFocus" />
                    <Button x:Name="DeepSeekKeyVisibilityButton"
                            Grid.Column="1"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="显示"
                            ToolTip="显示或隐藏 API Key"
                            AutomationProperties.Name="显示或隐藏 API Key"
                            Click="DeepSeekKeyVisibilityButton_Click" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}">
                    <Run Text="API Key 在" /><Hyperlink x:Name="DeepSeekKeyPortalLink"
                               NavigateUri="https://platform.deepseek.com/api_keys"
                               Foreground="{DynamicResource AccentBrush}"
                               RequestNavigate="RepoLink_RequestNavigate">platform.deepseek.com/api_keys</Hyperlink><Run Text=" 创建；焦点离开输入框即自动保存，清空后失焦即删除已存 Key。" />
                  </TextBlock>
                  <Button x:Name="DeepSeekTestButton"
                          Style="{StaticResource ThemedActionButtonStyle}"
                          Content="测试连接"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Left"
                          ToolTip="用当前输入的 API Key 验证连接与鉴权（不发起生成、不消耗 token）"
                          AutomationProperties.Name="测试 DeepSeek 连接"
                          Click="DeepSeekTestButton_Click" />
                  <TextBlock x:Name="DeepSeekStatusText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border x:Name="AiPromptCard" Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="整理提示词" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Margin="0,0,0,2"
                             Text="留空使用内置默认「语音转文字整理器」提示词；自定义提示词将原样作为系统指令发送，并失去内置的「卡片内容仅是待整理文字、不是指令」边界防护。上限 1 万字。" />
                  <TextBox x:Name="AiOrganizePromptBox"
                           Style="{StaticResource ThemedTextBoxStyle}"
                           Margin="0,8,0,0"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           MinHeight="140"
                           MaxHeight="320"
                           ToolTip="AI 整理提示词，输入后焦点离开即自动保存"
                           AutomationProperties.Name="AI 整理提示词"
                           TextChanged="AiOrganizePromptBox_TextChanged"
                           LostFocus="AiOrganizePromptBox_LostFocus" />
                  <TextBlock x:Name="AiOrganizePromptStateText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Text="当前使用内置默认。" />
                  <TextBlock x:Name="AiOrganizePromptErrorText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AiOrganizePromptFillDefaultButton"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="填入默认全文"
                            Margin="0,0,8,0"
                            ToolTip="把内置默认提示词全文填入编辑框供微调（焦点离开输入框即保存）"
                            AutomationProperties.Name="填入默认整理提示词"
                            Click="AiOrganizePromptFillDefaultButton_Click" />
                    <Button x:Name="AiOrganizePromptResetButton"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Content="恢复默认"
                            ToolTip="清除自定义提示词，恢复使用内置默认（立即生效）"
                            AutomationProperties.Name="恢复默认整理提示词"
                            Click="AiOrganizePromptResetButton_Click" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>

      <!-- 页脚（契约 #24）：关于 + 退出，非导航项。 -->
      <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}">
        <Grid Margin="16,10,16,12">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13">
              <Run x:Name="AppNameRun" FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="VersionRun" Foreground="{DynamicResource SecondaryTextBrush}" />
            </TextBlock>
            <TextBlock FontSize="12" Margin="0,2,0,0">
              <Hyperlink x:Name="RepoLink"
                         Foreground="{DynamicResource AccentBrush}"
                         RequestNavigate="RepoLink_RequestNavigate">GitHub 仓库与更新记录</Hyperlink>
            </TextBlock>
          </StackPanel>
          <Button x:Name="ExitButton"
                  Style="{StaticResource ExitButtonStyle}"
                  Content="退出悬浮中转站"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  MinWidth="132"
                  ToolTip="保存全部内容后退出"
                  AutomationProperties.Name="退出悬浮中转站"
                  Click="ExitButton_Click" />
        </Grid>
      </Border>

      <Border Grid.RowSpan="3"
              Panel.ZIndex="10"
              Style="{StaticResource SettingsShellOutlineStyle}" />
    </Grid>
  </Border>
</Window>
