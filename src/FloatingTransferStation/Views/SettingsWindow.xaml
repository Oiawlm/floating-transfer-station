                <StackPanel>
                  <TextBlock Text="自动清理" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="自动清理非置顶卡片"
                               Style="{StaticResource RowCaptionStyle}">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="删除可 Ctrl+Z 撤销（仅本次运行内）；改短时长后，超龄卡片在下次检查时清理。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <CheckBox x:Name="AutoCleanupToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
