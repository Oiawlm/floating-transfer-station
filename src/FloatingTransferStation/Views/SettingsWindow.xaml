<Window x:Class="FloatingTransferStation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="clr-namespace:FloatingTransferStation.Design;assembly=FloatingTransferStation.Core"
        xmlns:views="clr-namespace:FloatingTransferStation.Views"
        Title="设置"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        Width="{x:Static design:SettingsWindowMetrics.DefaultWidth}"
        Height="{x:Static design:SettingsWindowMetrics.DefaultHeight}"
        MinWidth="{x:Static design:SettingsWindowMetrics.MinWidth}"
        MinHeight="{x:Static design:SettingsWindowMetrics.MinHeight}"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        FontFamily="{DynamicResource InterfaceFontFamily}"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">
  <!-- 复用主窗 Mica 壳技术：整窗玻璃帧承载 DWM 材质，圆角由 DWM 裁剪。
       几何契约（#24，Issue #106）：SizeToContent=Manual + CanResize + 系统级
       8 向缩放（ResizeBorderThickness=6），固定视口由内部 ScrollViewer 承担滚动；
       冻结数值全部来自 SettingsWindowMetrics 单点声明。交互缩放与最大化的
       上限不由 Window.MaxWidth/MaxHeight 声明（1.50.0 教训：属性会把根视觉钳出
       死区），而是经 WM_GETMINMAXINFO 轨道尺寸强制；壳层铺满整个 HWND，
       内容列以 ContentColumnMaxWidth 居中有界。 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  GlassFrameThickness="-1"
                  ResizeBorderThickness="6"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/MainWindowStyles.xaml" />
        <ResourceDictionary Source="../Resources/DesignTheme.Light.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- ToolTip 全局外观（2026-11-07 文案精简批，O1 裁决）：原生 ToolTip＋本窗隐式样式统一；
           颜色全走主题键、圆角 ControlCornerRadius；长文案由挂接点 TextBlock 自管换行（R1）。 -->
      <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToolTip">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>

      <Style x:Key="RowCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="NoteCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
      </Style>

      <!-- 设置节卡片（契约 #24 设计语言）：既有卡片语言分组，颜色全走主题键。
           页内最后一张卡片用本地 Margin="0" 收尾。 -->
      <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SurfaceCornerRadius}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Style.Triggers>
          <!-- 整卡禁用态（契约 #57 修订：置灰非隐藏）——卡级不透明度统一覆盖标题/
               文字/行（含代码后置构造的行标签与把手）与卡面；卡级档=CardDisabledOpacity
               0.6（2026-11-08 视觉语言收敛入 token，DesignTokens 单一源）；钮自身
               0.4 触发器保留，叠加 ≈0.24 已裁定可接受。 -->
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="{x:Static design:DesignTokens.CardDisabledOpacity}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- 左导航项（契约 #24）：RadioButton 原生带 SelectionItem 语义与 UIA peer，
           风格同主窗分类轨——选中态 ActiveCategory 底 + 强调色指示条。W6 焦点视觉
           治理（2026-11-03）：键入焦点不画 Aero2 虚线框（选中态底色与指示条承载视觉）。 -->
      <Style x:Key="SettingsNavItemStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid>
                <Border x:Name="ItemSurface"
                        Background="Transparent"
                        CornerRadius="{StaticResource HeaderActionCornerRadius}" />
                <Border x:Name="SelectionIndicator"
                        Width="3"
                        Margin="0,8"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="1.5"
                        Visibility="Collapsed"
                        IsHitTestVisible="False" />
                <ContentPresenter Margin="16,0,8,0"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="False" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource ActiveCategoryBrush}" />
                  <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="开关" />
        <!-- W6 焦点视觉治理（2026-11-03）：开关键入焦点不画 Aero2 虚线框。 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Width="40" Height="20" Background="Transparent">
                <!-- Track 圆角=高一半（胶囊派生规则）、Thumb=高一半（圆形派生规则），
                     两者均不入圆角阶梯（design.md §四登记）。 -->
                <Border x:Name="Track"
                        Width="40"
                        Height="20"
                        CornerRadius="10"
                        Background="{DynamicResource BorderBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        IsHitTestVisible="False" />
                <Border x:Name="Thumb"
                        Width="14"
                        Height="14"
                        CornerRadius="7"
                        HorizontalAlignment="Left"
                        Margin="3,0"
                        Background="{DynamicResource SecondaryTextBrush}"
                        IsHitTestVisible="False" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <!-- 「仅描边」轻 hover 支系（同 ComboBox/QR 缩略钮）：悬停只换描边，
                       不换底不位移（2026-11-08 视觉语言收敛 A13 补齐开关悬停反馈）。 -->
                  <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                  <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource OnAccentBrush}" />
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="{x:Static design:DesignTokens.ControlDisabledOpacity}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ThemedComboBoxStyle / ThemedActionButtonStyle 已提升至 MainWindowStyles.xaml
           （两窗共享的单一事实来源）；本字典仅保留设置窗私有样式。 -->

      <Style x:Key="ReadOnlyPathBoxStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Surface"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{StaticResource ControlCornerRadius}">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SettingsShellOutlineStyle" TargetType="Border" BasedOn="{StaticResource WindowShellOutlineStyle}">
        <!-- 独立浮动窗口（非贴右缘停靠）：四边描边补齐左缘。 -->
        <Setter Property="BorderThickness" Value="1" />
      </Style>

      <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedActionButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Height" Value="34" />
      </Style>

      <!-- 页脚二维码缩略图（W5 2026-11-05；2026-11-06 右键改复制二维码图片；
           2026-11-08 岛式码面：模板根 Grid＋派生阴影层高程）：
           白底静区是二维码可扫的结构要求（主题不变量，非调色板颜色），控件级
           圆角＋既有描边/悬停语言；单击弹设置窗内放大层（不新建窗口）。 -->
      <!-- 缩略图阴影层（岛式高程）：派生自共享 CardShadowLayerStyle，仅覆写
           Background=White（码面白，可扫性主题不变量）与控件档圆角；
           Effect/IsHitTestVisible/命中隔离语义单点继承，零魔数零第二份。 -->
      <Style x:Key="WeChatQrThumbShadowLayerStyle" TargetType="Border" BasedOn="{StaticResource CardShadowLayerStyle}">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
      </Style>
      <Style x:Key="WeChatQrThumbStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="放大微信二维码" />
        <Setter Property="ToolTip" Value="单击放大微信二维码，右键复制二维码图片；白底为保证扫码识别" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="WeChatQrThumbShadowLayer"
                        Style="{StaticResource WeChatQrThumbShadowLayerStyle}" />
                <Border x:Name="Surface"
                        Background="White"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="3">
                  <ContentPresenter />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 密码输入框（AI 设置的 API Key 行）：与 ThemedTextBoxStyle 同法的纯 Setter 版，
           默认模板自带掩码显示，颜色一律走主题键。 -->
      <Style x:Key="ThemedPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="{x:Static design:DesignTokens.ControlDisabledOpacity}" />
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- 微信号复制行（2026-11-08 视觉语言收敛 A14：页脚行与放大层行共用）——
           手型光标＋悬停 HoverSurface 瞬切底（单表面轻控件「瞬切」支系），反馈色
           仍由代码后置翻转 Run 前景；左右键复制语义不变。 -->
      <Style x:Key="WeChatIdRowStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="复制微信号" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Border x:Name="WindowShell"
          Style="{StaticResource WindowShellStyle}"
          SizeChanged="WindowShell_SizeChanged">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="11,11,0,0">
        <Grid Background="Transparent">
          <Thumb x:Name="HeaderDragRegion"
                 Style="{StaticResource HeaderThumbStyle}"
                 Cursor="SizeAll"
                 DragDelta="HeaderDragRegion_DragDelta"
                 DragCompleted="HeaderDragRegion_DragCompleted" />
          <TextBlock Text="设置"
                     Margin="16,0"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />
          <Button x:Name="CloseButton"
                  Style="{StaticResource HeaderActionButtonStyle}"
                  HorizontalAlignment="Right"
                  Margin="0,0,8,0"
                  ToolTip="关闭设置"
                  AutomationProperties.Name="关闭设置"
                  Click="CloseButton_Click">
            <Viewbox Width="14" Height="14">
              <Path Data="M0.7071068,0 L7,6.2928932 L13.292893,0 L14,0.7071068 L7.7071068,7 L14,13.292893 L13.292893,14 L7,7.7071068 L0.7071068,14 L0,13.292893 L6.2928932,7 L0,0.7071068 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        Stretch="Uniform" />
            </Viewbox>
          </Button>
        </Grid>
      </Border>

      <!-- 双栏主体（契约 #24，分组冻结表）：左导航 5 组 + 右内容页；
           SettingsScrollHost 是全部页共享的唯一滚动视口（x:Name 单一实例），
           页切换只翻 Visibility，可视树直书保证 43 个既有 x:Name 保持在窗口
           同一 namescope（FindName/UIA 全可达）。 -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="148" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource TabRailBrush}">
          <StackPanel x:Name="SettingsNavList"
                      Margin="0,8"
                      KeyboardNavigation.TabNavigation="Continue"
                      PreviewKeyDown="SettingsNavList_PreviewKeyDown">
            <RadioButton x:Name="SettingsNavAppearance"
                         GroupName="SettingsNav"
                         Content="外观"
                         Tag="AppearancePage"
                         IsChecked="True"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="外观"
                         Checked="SettingsNavItem_Checked" />
            <RadioButton x:Name="SettingsNavPanel"
                         GroupName="SettingsNav"
                         Content="面板"
                         Tag="PanelPage"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="面板"
                         Checked="SettingsNavItem_Checked" />
            <RadioButton x:Name="SettingsNavGeneral"
                         GroupName="SettingsNav"
                         Content="通用"
                         Tag="GeneralPage"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="通用"
                         Checked="SettingsNavItem_Checked" />
            <RadioButton x:Name="SettingsNavData"
                         GroupName="SettingsNav"
                         Content="数据与维护"
                         Tag="DataPage"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="数据与维护"
                         Checked="SettingsNavItem_Checked" />
            <RadioButton x:Name="SettingsNavAi"
                         GroupName="SettingsNav"
                         Content="AI"
                         Tag="AiPage"
                         Style="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="AI"
                         Checked="SettingsNavItem_Checked" />
          </StackPanel>
        </Border>
        <!-- 共享滚动视口挂既有 keyed overlay 模板（契约 #23 机制扩展，2026-10-19
             Issue #200）：五内容页高度不同，默认模板的布局滚动条出现/消失会让内容
             列在「全宽」与「全宽−滚动条宽」间跳变——溢出页卡片比不溢出页窄。单格
             叠加让条带悬浮内容之上、永不占布局宽，五页卡片宽度在任何窗口高度下
             逐 DIP 相等；条带 8 DIP 落在内容列 16 DIP 右边距带内，与卡片零相交。
             样式与本窗合并字典中的隐式瘦条 ScrollBar 样式同源（MainWindowStyles）。 -->
        <ScrollViewer x:Name="SettingsScrollHost"
                      Grid.Column="1"
                      Style="{StaticResource OverlayScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <!-- 内容列：720 上限内铺满视口（Stretch＋MaxWidth：槽宽不足取槽宽、
               超出上限取 720 并居中——WPF 对受 Max 钳制的 Stretch 自动按居中落位，
               兼得 #24「720 上限水平居中」）。Center 会让列宽随最宽卡片收窄，
               五页内容不同宽 → 卡片宽度页页不等（2026-10-19 根因修订，Issue #200）。 -->
          <Grid x:Name="SettingsContentHost"
                Margin="16,14,16,16"
                MaxWidth="{x:Static design:SettingsWindowMetrics.ContentColumnMaxWidth}"
                HorizontalAlignment="Stretch">
            <StackPanel x:Name="AppearancePage">
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="主题" Style="{StaticResource SectionTitleStyle}" />
                  <ComboBox x:Name="ThemeComboBox"
                            Style="{StaticResource ThemedComboBoxStyle}"
                            AutomationProperties.Name="主题"
                            SelectionChanged="ThemeComboBox_SelectionChanged" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="界面字体" Style="{StaticResource SectionTitleStyle}">
                    <TextBlock.ToolTip>
                      <ToolTip>
                        <TextBlock Text="改动立即生效并自动保存；列表只含本机已安装字体，应用不随包分发字体文件。" TextWrapping="Wrap" MaxWidth="320" />
                      </ToolTip>
                    </TextBlock.ToolTip>
                  </TextBlock>
                  <ComboBox x:Name="InterfaceFontComboBox"
                            Style="{StaticResource ThemedComboBoxStyle}"
                            AutomationProperties.Name="界面字体"
                            SelectionChanged="InterfaceFontComboBox_SelectionChanged" />
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="「（默认）」即应用默认（微软雅黑）。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="动效" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="启用界面过渡动画"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="AnimationsToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="启用界面过渡动画"
                              Checked="AnimationsToggle_Checked"
                              Unchecked="AnimationsToggle_Unchecked" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="置顶分隔" Style="{StaticResource SectionTitleStyle}" />
                  <ComboBox x:Name="PinnedDividerComboBox"
                            Style="{StaticResource ThemedComboBoxStyle}"
                            AutomationProperties.Name="置顶分隔样式"
                            SelectionChanged="PinnedDividerComboBox_SelectionChanged" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PanelPage" Visibility="Collapsed">
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="标签顺序" Style="{StaticResource SectionTitleStyle}" />
                  <Grid x:Name="CategoryOrderHost" ClipToBounds="True">
                    <StackPanel x:Name="CategoryOrderList" />
                    <Border x:Name="CategoryOrderInsertionIndicator"
                            Height="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="拖拽调整标签顺序。" />
                </StackPanel>
              </Border>
              <!-- 子分组顺序（契约 #57 修订，#21「标签顺序」节模式镜像）：每个内容
                   分类一个小节（标题＝分类名，四行槽序编辑；行全部代码后置构造，
                   XAML 无硬编码行）；门控＝SubgroupDisplay≠Off——整卡代码后置置灰
                   非隐藏（SetSubgroupOrderAvailability，照 SetAiOrganizeAreasAvailability
                   先例），关闭态说明行切为引导句。 -->
              <Border x:Name="SubgroupOrderCard" Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="子分组顺序" Style="{StaticResource SectionTitleStyle}">
                    <TextBlock.ToolTip>
                      <ToolTip>
                        <TextBlock Text="顺序只影响分组按钮与分组显示，不改卡片归属；重置窗口设置不会清除。拖动把手或用上移/下移按钮，Esc 取消拖动。" TextWrapping="Wrap" MaxWidth="320" />
                      </ToolTip>
                    </TextBlock.ToolTip>
                  </TextBlock>
                  <TextBlock x:Name="SubgroupOrderTitleCustomerOriginal" Style="{StaticResource RowCaptionStyle}" Margin="0,2,0,0" />
                  <Grid ClipToBounds="True">
                    <StackPanel x:Name="SubgroupOrderListCustomerOriginal" />
                    <Border x:Name="SubgroupOrderIndicatorCustomerOriginal"
                            Height="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />
                  </Grid>
                  <TextBlock x:Name="SubgroupOrderTitleInbox" Style="{StaticResource RowCaptionStyle}" Margin="0,10,0,0" />
                  <Grid ClipToBounds="True">
                    <StackPanel x:Name="SubgroupOrderListInbox" />
                    <Border x:Name="SubgroupOrderIndicatorInbox"
                            Height="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />
                  </Grid>
                  <TextBlock x:Name="SubgroupOrderNote"
                             Style="{StaticResource NoteCaptionStyle}"
                             Text="调整每个分类内四个分组的显示顺序。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="内容复制" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Ctrl + C 复制已选内容"
                               Style="{StaticResource RowCaptionStyle}">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="卡片右半左键单击＝复制这一张（固定手势）；复制的内容不会被自动收集重复入库。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <CheckBox x:Name="CtrlCCopyToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="Ctrl + C 复制已选内容"
                              Checked="CtrlCCopyToggle_Checked"
                              Unchecked="CtrlCCopyToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="选中多张后 Ctrl+C：文字按板内顺序合并，图片给出文件组。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="垃圾桶按钮" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="无选择时左键"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="TrashLeftClickComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              AutomationProperties.Name="无选择时左键行为"
                              SelectionChanged="TrashLeftClickComboBox_SelectionChanged" />
                  </Grid>
                  <Grid Background="Transparent" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="无选择时右键"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="TrashRightClickComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              AutomationProperties.Name="无选择时右键行为"
                              SelectionChanged="TrashRightClickComboBox_SelectionChanged" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="两种清空都可 Ctrl+Z 整体撤销。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="卡片备注" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="允许短卡片添加备注"
                               Style="{StaticResource RowCaptionStyle}">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="备注入口默认只出现在被截断的长文字卡上；AI 整理按钮不受此开关影响。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <CheckBox x:Name="ShortCardNotesToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="允许短卡片添加备注"
                              Checked="ShortCardNotesToggle_Checked"
                              Unchecked="ShortCardNotesToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="开启后短文字卡也能添加备注。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="启动·列数" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="启动面瓦片列数"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="范围 3–6 列；固定列数不随宽度变化，窄面板配大列数会压缩瓦片。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <ComboBox x:Name="LauncherColumnStrategyComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              AutomationProperties.Name="启动器列数策略"
                              SelectionChanged="LauncherColumnStrategyComboBox_SelectionChanged" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="自适应＝列数随面板宽度自动调整（默认）。" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="启动·自动发现" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="自动发现新安装的应用"
                               Style="{StaticResource RowCaptionStyle}">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="监视开始菜单与下方文件夹；忽略的项会被记住，不再提醒。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <CheckBox x:Name="LauncherDiscoveryToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="自动发现新安装的应用"
                              Checked="LauncherDiscoveryToggle_Checked"
                              Unchecked="LauncherDiscoveryToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="新装应用进入「发现 N」清单，确认后才上屏。" />
                  <TextBlock Text="监视文件夹"
                             Style="{StaticResource RowCaptionStyle}"
                             Margin="0,10,0,0" />
                  <StackPanel x:Name="LauncherDiscoveryFolderList" MinHeight="4" />
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LauncherDiscoveryFolderInput"
                             Style="{StaticResource ThemedTextBoxStyle}"
                             Height="32"
                             FontSize="12"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="监视文件夹路径" />
                    <Button x:Name="LauncherDiscoveryFolderBrowseButton"
                            Grid.Column="1"
                            Content="浏览…"
                            FontSize="12"
                            Height="32"
                            Padding="12,0"
                            Margin="8,0,0,0"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            AutomationProperties.Name="浏览监视文件夹"
                            Click="LauncherDiscoveryFolderBrowse_Click" />
                    <!-- 通用动词「添加」＝独立窗各自单点（此处为添加监视文件夹；
                         与网页地址输入/选择器同词不同动作，不跨窗资源化——S3 豁免）。 -->
                    <Button x:Name="LauncherDiscoveryFolderAddButton"
                            Grid.Column="2"
                            Content="添加"
                            FontSize="12"
                            Height="32"
                            Padding="12,0"
                            Margin="8,0,0,0"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            AutomationProperties.Name="添加监视文件夹"
                            Click="LauncherDiscoveryFolderAdd_Click" />
                  </Grid>
                  <TextBlock x:Name="LauncherDiscoveryFolderStatus"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <TextBlock Text="开机自启" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="登录 Windows 时自动运行"
                               Style="{StaticResource RowCaptionStyle}" />
                    <CheckBox x:Name="StartupToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="登录 Windows 时自动运行"
                              Checked="StartupToggle_Checked"
                              Unchecked="StartupToggle_Unchecked" />
                  </Grid>
                  <TextBlock x:Name="StartupNoteText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Text="运行安装程序更新版本后，自启会重新开启，可在本设置中再次关闭。" />
                  <TextBlock x:Name="StartupStatusText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="全局快捷键" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Ctrl + Alt + V 唤起面板"
                               Style="{StaticResource RowCaptionStyle}">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="展开到默认接收分类；组合键被其他软件占用时开启会就地提示失败。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <CheckBox x:Name="GlobalHotkeyToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="Ctrl + Alt + V 唤起面板"
                              Checked="GlobalHotkeyToggle_Checked"
                              Unchecked="GlobalHotkeyToggle_Unchecked" />
                  </Grid>
                  <TextBlock x:Name="GlobalHotkeyNoteText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Text="开启后任何界面都能用组合键展开面板。" />
                  <TextBlock x:Name="GlobalHotkeyStatusText"
                             Style="{StaticResource NoteCaptionStyle}"
                             Foreground="{DynamicResource DangerBrush}"
                             Text=""
                             Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="自动检查更新" Style="{StaticResource SectionTitleStyle}" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="自动检查并安装更新"
                               Style="{StaticResource RowCaptionStyle}">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="启动 30 秒首检，之后每 24 小时一次，闲置 2 小时也会检查；关闭后仍可点标题栏「更新」手动检查。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <CheckBox x:Name="AutoUpdateCheckToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="自动检查更新"
                              Checked="AutoUpdateCheckToggle_Checked"
                              Unchecked="AutoUpdateCheckToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="发现新版本会自动下载、安装并重启，无需确认。" />
                </StackPanel>
              </Border>
              <!-- 实验性（首个先例，2026-11-03）：正在打磨的能力按成熟度定默认态——
                   日常可用的默认开启（2026-11-07 起，存量经一次性偏好迁移统一收敛），
                   边缘体验默认关闭、显式开启；形态随既有卡片
                   语言（CardBrush/BorderBrush/圆角 8），标注「实验性」并在节内说明
                   每项的实验原因。开关即时生效＋原子保存（契约 #5 同路）。 -->
              <Border Style="{StaticResource SettingsCardStyle}" Margin="0">
                <StackPanel>
                  <TextBlock Text="实验性" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="以下能力仍在打磨，按成熟度各定默认态（各项默认值与打磨原因见行悬停说明）；调整立即生效并自动保存。" />
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="记录界面 Markdown 阅读视图"
                               Style="{StaticResource RowCaptionStyle}">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="阅读态按 Markdown 渲染成只读视图；链接用浏览器打开，不加载远程图片。默认开启：渲染与排版仍在打磨，不合意可关闭。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <CheckBox x:Name="ReviewMarkdownViewToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="记录界面 Markdown 阅读视图"
                              Checked="ReviewMarkdownViewToggle_Checked"
                              Unchecked="ReviewMarkdownViewToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="开启后记录界面出现「阅读｜编辑」切换。" />
                  <!-- 实验性第二项（2026-11-05，契约 #57）：三态枚举设置沿仓库
                       「枚举设置一律 ComboBox」先例（置顶分隔/清理时长/垃圾桶行为）；
                       即时生效＋原子保存（契约 #5 唯一管线，禁平行保存路径）。 -->
                  <Grid Background="Transparent" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="分类内子分组"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="实验性功能，默认关闭：交互仍在打磨。开启后内容分类顶部出现分组按钮；推荐先在按钮轨拖卡归组，再切视觉分组浏览。关闭或切换形态不影响卡片与归属。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <ComboBox x:Name="SubgroupModeComboBox"
                              Grid.Column="1"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              MaxDropDownHeight="240"
                              AutomationProperties.Name="分类内子分组"
                              SelectionChanged="SubgroupModeComboBox_SelectionChanged" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="按钮轨：悬停筛选、单击设收集落点、拖卡归组；视觉分组：同组相邻显示。" />
                  <!-- 实验性第三项（2026-11-06，契约 #58；2026-11-07 起默认开启，
                       存量经一次性偏好迁移统一收敛）：图片拖出为文件——门控
                       既有拖出能力（关闭＝对外剥离文件/位图形态，窗内拖放与
                       剪贴板复制零变化）；即时生效＋原子保存（契约 #5 同路）。 -->
                  <Grid Background="Transparent" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="图片拖出为文件"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="只复制不移动，应用内卡片保留；关闭时窗内整理与复制不受影响。默认开启：拖到不同软件的表现仍在打磨，不合意可关闭。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <CheckBox x:Name="DragOutAsFileToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="图片拖出为文件"
                              Checked="DragOutAsFileToggle_Checked"
                              Unchecked="DragOutAsFileToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="开启后图片卡可直接拖出为图片文件。" />
                  <!-- 实验性第四项（2026-11-08 批次 d1，契约 #62）：子分组轨点击
                       切换——悬停误触治理（R13）：开启后按钮轨悬停只高亮（驻留
                       显示分组内卡片数），点击切换分组、Ctrl+单击设收集落点；
                       关闭＝悬停即切换、单击设收集落点（现状）。即时生效＋原子
                       保存（契约 #5 同路）。 -->
                  <Grid Background="Transparent" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="子分组轨点击切换"
                               Style="{StaticResource RowCaptionStyle}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center">
                      <TextBlock.ToolTip>
                        <ToolTip>
                          <TextBlock Text="实验性功能，默认关闭：分组按钮横在卡片与顶部按钮之间，悬停即切换会误触。开启后悬停只高亮（停顿显示分组内卡片数），点击才切换分组、再点取消，Ctrl+单击设收集落点，「全部」查看全部分类内容。关闭＝悬停即切换、单击设收集落点。" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                      </TextBlock.ToolTip>
                    </TextBlock>
                    <CheckBox x:Name="SubgroupRailClickSwitchToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="子分组轨点击切换"
                              Checked="SubgroupRailClickSwitchToggle_Checked"
                              Unchecked="SubgroupRailClickSwitchToggle_Unchecked" />
                  </Grid>
                  <TextBlock Style="{StaticResource NoteCaptionStyle}"
                             Text="开启后按钮轨悬停只高亮，点击切换分组、Ctrl+单击设收集落点。" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="DataPage" Visibility="Collapsed">
