<Window x:Class="FloatingTransferStation.Views.InstalledAppPickerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加已安装应用"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{DynamicResource DialogSurfaceBrush}"
        Width="380"
        Height="480"
        MinWidth="320"
        MinHeight="360"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable, Segoe UI"
        PreviewKeyDown="PickerWindow_PreviewKeyDown">
  <!-- 快捷启动 #30 切片 4：已安装应用选择器（AppsFolder 枚举结果的会话内挑选面）。
       固定尺寸不可缩放；打开时枚举、关闭即弃（结果只由确认按钮回传 AUMID 清单）。
       壳技术（#30 修订 2026-10-18，Issue #186 D8）：不透明 DialogSurfaceBrush＋1px
       边框＋DWM 圆角/阴影唯一来源（GlassFrameThickness=0）；主按钮「添加 N 项」
       N=0 禁用（ConfirmButton 状态由代码承载）；搜索过滤保留勾选。 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  GlassFrameThickness="0"
                  ResizeBorderThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/MainWindowStyles.xaml" />
        <ResourceDictionary Source="../Resources/DesignTheme.Light.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Border Style="{StaticResource DialogShellStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 标题行：拖拽区 + 标题 + 关闭（D8 内边距 24 由壳承载，标题行负边距回贴）。 -->
      <Grid Grid.Row="0"
            Margin="-24,0,-24,0"
            Background="Transparent"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <TextBlock Text="添加已安装应用"
                   Margin="24,0,0,0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />
        <Button x:Name="CloseButton"
                Style="{StaticResource HeaderActionButtonStyle}"
                HorizontalAlignment="Right"
                Margin="0,0,8,0"
                ToolTip="关闭"
                AutomationProperties.Name="关闭已安装应用选择器"
                Click="CloseButton_Click">
          <Viewbox Width="14" Height="14">
            <Path Data="M0.7071068,0 L7,6.2928932 L13.292893,0 L14,0.7071068 L7,7.7071068 L14,13.292893 L13.292893,14 L7,7.7071068 L0.7071068,14 L0,13.292893 L6.2928932,7 L0,0.7071068 Z"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  Stretch="Uniform" />
          </Viewbox>
        </Button>
      </Grid>

      <!-- 搜索框：区域文化不区分大小写的包含匹配（D8：高 36 圆角 4）。 -->
      <Grid Grid.Row="1" Margin="0,4,0,8">
        <TextBox x:Name="PickerSearchBox"
                 Style="{StaticResource ThemedTextBoxStyle}"
                 Height="36"
                 FontSize="13"
                 Padding="10,0"
                 AutomationProperties.Name="搜索已安装应用"
                 TextChanged="PickerSearchBox_TextChanged" />
        <TextBlock x:Name="PickerSearchHint"
                   Text="搜索应用"
                   FontSize="13"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="10,0,0,0"
                   IsHitTestVisible="False" />
      </Grid>

      <!-- 应用列表：多选复选行；已添加条目带灰字标记（重复添加走既有去重脉冲）。 -->
      <ScrollViewer Grid.Row="2"
                    Style="{StaticResource OverlayScrollViewerStyle}"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="PickerList"
                      Focusable="False"
                     ToggleButton.Checked="PickerList_Checked"
                     ToggleButton.Unchecked="PickerList_Checked">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="8,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding App.DisplayName}" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding App.DisplayName}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="{Binding App.DisplayName}" />
                <TextBlock Grid.Column="2"
                           Margin="8,0,4,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="已添加"
                           Visibility="{Binding AlreadyAddedTextVisibility}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 空态提示（无匹配 / 枚举为空共用，代码切换文案）。 -->
      <TextBlock x:Name="PickerEmptyHint"
                 Grid.Row="2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="12"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="没有匹配的应用"
                 Visibility="Collapsed" />

      <!-- 底部动作行（D8：按钮右对齐、间距 8、高 32；主按钮「添加 N 项」）。 -->
      <Grid Grid.Row="3" Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="取消"
                  FontSize="12"
                  Height="32"
                  Padding="14,0"
                  Margin="0,0,8,0"
                  Style="{StaticResource ThemedActionButtonStyle}"
                  AutomationProperties.Name="取消添加已安装应用"
                  Click="CancelButton_Click" />
          <Button x:Name="PickerConfirmButton"
                  Content="添加"
                  FontSize="12"
                  Height="32"
                  Padding="14,0"
                  Style="{StaticResource ThemedActionButtonStyle}"
                  AutomationProperties.Name="确认添加已安装应用"
                  Click="ConfirmButton_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
