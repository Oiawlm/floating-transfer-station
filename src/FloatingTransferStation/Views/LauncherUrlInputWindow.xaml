<Window x:Class="FloatingTransferStation.Views.LauncherUrlInputWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加网页地址"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Transparent"
        Width="360"
        SizeToContent="Height"
        MinWidth="300"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable, Segoe UI"
        PreviewKeyDown="UrlInputWindow_PreviewKeyDown">
  <!-- 快捷启动网页条目（#30 修订，Issue #179）：网页地址输入对话框。单行输入＋内联
       错误＋确定/取消（Enter=确定、Esc=取消、上限 2048）；零网络（不做可达性探测）。
       归一化唯一经 Core LauncherUrlInput，确认回传规范形结果（LauncherUrlNormalization），
       取消/关闭/Esc 回传 null。壳技术同已安装应用选择器（Mica 玻璃帧 + DWM 圆角）。 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  GlassFrameThickness="-1"
                  ResizeBorderThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/MainWindowStyles.xaml" />
        <ResourceDictionary Source="../Resources/DesignTheme.Light.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Border Background="{DynamicResource WindowShellBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Margin="6">
    <Border.Effect>
      <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.3" />
    </Border.Effect>
    <Grid Margin="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 标题行：拖拽区 + 标题 + 关闭。 -->
      <Grid Grid.Row="0"
            Background="Transparent"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <TextBlock Text="添加网页地址"
                   Margin="14,0,0,0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />
        <Button x:Name="CloseButton"
                Style="{StaticResource HeaderActionButtonStyle}"
                HorizontalAlignment="Right"
                Margin="0,0,8,0"
                ToolTip="关闭"
                AutomationProperties.Name="关闭网页地址输入"
                Click="CloseButton_Click">
          <Viewbox Width="14" Height="14">
            <Path Data="M0.7071068,0 L7,6.2928932 L13.292893,0 L14,0.7071068 L7.7071068,7 L14,13.292893 L13.292893,14 L7,7.7071068 L0.7071068,14 L0,13.292893 L6.2928932,7 L0,0.7071068 Z"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  Stretch="Uniform" />
          </Viewbox>
        </Button>
      </Grid>

      <!-- 单行输入（上限 2048，无协议输入自动补 https://）。 -->
      <Grid Grid.Row="1" Margin="12,4,12,4">
        <TextBox x:Name="UrlInputBox"
                 Style="{StaticResource ThemedTextBoxStyle}"
                 Height="30"
                 FontSize="13"
                 MaxLength="2048"
                 AutomationProperties.Name="网页地址"
                 TextChanged="UrlInputBox_TextChanged" />
        <TextBlock x:Name="UrlInputHint"
                   Text="例如 github.com"
                   FontSize="13"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="10,0,0,0"
                   IsHitTestVisible="False" />
      </Grid>

      <!-- 内联错误（Core 归一化拒绝文案；确认未通过时显示，不关窗）。 -->
      <TextBlock x:Name="UrlErrorText"
                 Grid.Row="2"
                 Margin="14,0,12,0"
                 FontSize="12"
                 Foreground="{DynamicResource DangerBrush}"
                 TextWrapping="Wrap"
                 Visibility="Collapsed" />

      <!-- 底部动作行（Enter=确定经 IsDefault）。 -->
      <Grid Grid.Row="3" Margin="12,8,12,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="取消"
                  FontSize="12"
                  Padding="14,5"
                  Margin="0,0,8,0"
                  Style="{StaticResource ThemedActionButtonStyle}"
                  AutomationProperties.Name="取消添加网页地址"
                  Click="CancelButton_Click" />
          <Button x:Name="UrlConfirmButton"
                  Content="确定"
                  FontSize="12"
                  Padding="14,5"
                  IsDefault="True"
                  Style="{StaticResource ThemedActionButtonStyle}"
                  AutomationProperties.Name="确认添加网页地址"
                  Click="ConfirmButton_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
