<Window x:Class="FloatingTransferStation.Views.LauncherUrlInputWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加网页地址"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{DynamicResource DialogSurfaceBrush}"
        Width="360"
        SizeToContent="Height"
        MinWidth="300"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable, Segoe UI"
        PreviewKeyDown="UrlInputWindow_PreviewKeyDown">
  <!-- 快捷启动网页条目（#30 修订，Issue #179；壳统一 2026-10-18，Issue #186 D8）：
       网页地址输入对话框。单行输入＋内联错误＋「添加」/取消（Enter=添加、Esc=取消、
       上限 2048）；零网络（不做可达性探测）。归一化唯一经 Core LauncherUrlInput，
       确认回传规范形结果（LauncherUrlNormalization），取消/关闭/Esc 回传 null。
       壳技术（D8）：不透明 DialogSurfaceBrush＋1px 边框＋DWM 圆角/阴影唯一来源
       （GlassFrameThickness=0——撤透明背景、Margin 6 假圆角与手工阴影三件套）。 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  GlassFrameThickness="0"
                  ResizeBorderThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/MainWindowStyles.xaml" />
        <ResourceDictionary Source="../Resources/DesignTheme.Light.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Border Style="{StaticResource DialogShellStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 标题行：拖拽区 + 标题 + 关闭（D8 内边距 24 由壳承载，标题行负边距回贴）。 -->
      <Grid Grid.Row="0"
            Margin="-24,0,-24,0"
            Background="Transparent"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <TextBlock Text="添加网页地址"
                   Margin="24,0,0,0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />
        <Button x:Name="CloseButton"
                Style="{StaticResource HeaderActionButtonStyle}"
                HorizontalAlignment="Right"
                Margin="0,0,8,0"
                ToolTip="关闭"
                AutomationProperties.Name="关闭网页地址输入"
                Click="CloseButton_Click">
          <Viewbox Width="14" Height="14">
            <Path Data="M0.7071068,0 L7,6.2928932 L13.292893,0 L14,0.7071068 L7,7.7071068 L14,13.292893 L13.292893,14 L7,7.7071068 L0.7071068,14 L0,13.292893 L6.2928932,7 L0,0.7071068 Z"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  Stretch="Uniform" />
          </Viewbox>
        </Button>
      </Grid>

      <!-- 单行输入（上限 2048，无协议输入自动补 https://；D8：高 36 圆角 4）。 -->
      <Grid Grid.Row="1" Margin="0,4,0,4">
        <TextBox x:Name="UrlInputBox"
                 Style="{StaticResource ThemedTextBoxStyle}"
                 Height="36"
                 FontSize="13"
                 Padding="10,0"
                 MaxLength="2048"
                 AutomationProperties.Name="网页地址"
                 TextChanged="UrlInputBox_TextChanged" />
        <TextBlock x:Name="UrlInputHint"
                   Text="例如 github.com"
                   FontSize="13"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="10,0,0,0"
                   IsHitTestVisible="False" />
      </Grid>

      <!-- 内联错误（Core 归一化拒绝文案；确认未通过时显示，不关窗）。 -->
      <TextBlock x:Name="UrlErrorText"
                 Grid.Row="2"
                 Margin="0,0,0,0"
                 FontSize="12"
                 Foreground="{DynamicResource DangerBrush}"
                 TextWrapping="Wrap"
                 Visibility="Collapsed" />

      <!-- 底部动作行（Enter=添加经 IsDefault；D8：按钮右对齐、间距 8）。 -->
      <Grid Grid.Row="3" Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="取消"
                  FontSize="12"
                  Height="32"
                  Padding="14,0"
                  Margin="0,0,8,0"
                  Style="{StaticResource ThemedActionButtonStyle}"
                  AutomationProperties.Name="取消添加网页地址"
                  Click="CancelButton_Click" />
          <Button x:Name="UrlConfirmButton"
                  Content="添加"
                  FontSize="12"
                  Height="32"
                  Padding="14,0"
                  IsDefault="True"
                  Style="{StaticResource ThemedActionButtonStyle}"
                  AutomationProperties.Name="确认添加网页地址"
                  Click="ConfirmButton_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
