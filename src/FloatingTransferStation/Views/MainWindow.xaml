<Window x:Class="FloatingTransferStation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:design="clr-namespace:FloatingTransferStation.Design;assembly=FloatingTransferStation.Core"
        xmlns:models="clr-namespace:FloatingTransferStation.Models;assembly=FloatingTransferStation.Core"
        xmlns:vm="clr-namespace:FloatingTransferStation.ViewModels;assembly=FloatingTransferStation.Core"
        xmlns:views="clr-namespace:FloatingTransferStation.Views"
        mc:Ignorable="d"
        Title="悬浮中转站"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI"
        SizeToContent="Manual"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        MouseEnter="Root_MouseEnter"
        MouseLeave="Root_MouseLeave">
  <!-- 玻璃帧铺满整窗承载 DWM 材质（Mica）；圆角由 DWM 裁剪，内容层另有同步自裁剪。 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  GlassFrameThickness="-1"
                  ResizeBorderThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static views:MainWindow.BatchPinCommand}"
                    CanExecute="BatchPinCommand_CanExecute"
                    Executed="BatchPinCommand_Executed" />
    <CommandBinding Command="ApplicationCommands.SelectAll"
                    CanExecute="SelectAllCommand_CanExecute"
                    Executed="SelectAllCommand_Executed" />
  </Window.CommandBindings>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/MainWindowStyles.xaml" />
        <ResourceDictionary Source="../Resources/DesignTheme.Light.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="LauncherTileAppIconTemplate">
        <!-- 应用/打包应用图标槽（#30 既有链路原样迁入模板）：占位字形（提取在途/失败
             时可见）+ Image 经 Loaded 走 STA 图标管线异步回填。 -->
        <Grid>
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="28"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="&#xE8FD;" />
          <Image Width="48"
                 Height="48"
                 Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Loaded="LauncherTileIcon_Loaded"
                 Source="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="LauncherTileUrlGlyphTemplate">
        <!-- Url 瓦片静态地球字形（#30 修订，Issue #179）：模板层按 Kind 分支，不请求
             favicon、不触达图标管线；前景动态资源随主题，尺寸对齐既有图标槽 48。 -->
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="28"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="&#xE774;" />
      </DataTemplate>
      <DataTemplate x:Key="CategoryTabTemplate"
                    DataType="{x:Type vm:CategoryViewModel}">
        <Border x:Name="TabSurface"
                Style="{StaticResource CategoryTabContainerStyle}"
                Tag="{Binding Category}"
                AllowDrop="True"
                MouseEnter="CategoryTab_MouseEnter"
                MouseLeave="CategoryTab_MouseLeave"
                MouseLeftButtonDown="CategoryTab_MouseLeftButtonDown"
                MouseLeftButtonUp="CategoryTab_MouseLeftButtonUp"
                DragEnter="CategoryTab_DragEnter"
                DragLeave="CategoryTab_DragLeave"
                DragOver="CategoryTab_DragOver"
                Drop="CategoryTab_Drop">
          <Grid Background="Transparent">
            <Border x:Name="TabHoverLayer"
                    Background="{DynamicResource HoverSurfaceBrush}"
                    CornerRadius="8"
                    Opacity="0"
                    IsHitTestVisible="False"
                    views:FadeAnimation.IsActive="{Binding IsMouseOver, ElementName=TabSurface}"
                    views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                    views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.HoverFeedbackMs}" />
            <Border Style="{StaticResource CategoryActiveLayerStyle}" />
            <Border Style="{StaticResource CategoryDropTargetLayerStyle}" />
            <Border Style="{StaticResource CategoryActiveMarkerStyle}" />
            <TextBlock Text="◎"
                       Style="{StaticResource CategoryDefaultMarkerStyle}" />
            <TextBlock Text="{Binding DisplayName}"
                       Style="{StaticResource CategoryLabelTextStyle}" />
            <TextBox Text="{Binding DraftName, UpdateSourceTrigger=Explicit}"
                     Style="{StaticResource CategoryNameEditorStyle}"
                     TextChanged="CategoryNameEditor_TextChanged"
                     KeyDown="CategoryNameEditor_KeyDown"
                     LostKeyboardFocus="CategoryNameEditor_LostKeyboardFocus" />
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <!-- 内容层由 LayoutRoot 承载：边缘裁切启用时按裁切量右内缩，
       使可见内容完整落在屏幕内；WindowShell 仍铺满整窗承载 Mica 与四角裁剪。 -->
  <Border x:Name="WindowShell"
          Style="{StaticResource WindowShellStyle}"
          SizeChanged="WindowShell_SizeChanged">
    <Grid x:Name="LayoutRoot" Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="58" />
      </Grid.ColumnDefinitions>

      <Grid x:Name="PanelContentHost"
            Grid.Column="0"
            Background="Transparent"
            RenderTransformOrigin="0.5,0.5">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPanelExpanded}" Value="False">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.RenderTransform>
          <TranslateTransform x:Name="PanelContentTransform" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="44" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderSurface"
                Grid.Row="0"
                Style="{StaticResource HeaderSurfaceStyle}">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="112" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Thumb x:Name="HeaderDragRegion"
                   Grid.Column="0"
                   Width="112"
                   Style="{StaticResource HeaderThumbStyle}"
                   DragDelta="HeaderThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted" />
            <TextBlock Text="{Binding ActivePanel.DisplayName}"
                       Grid.Column="0"
                       Margin="14,0"
                       Style="{StaticResource HeaderTitleStyle}" />

            <Border x:Name="HeaderActionRegion"
                    Grid.Column="1"
                    Background="Transparent"
                    Cursor="Arrow"
                    MouseEnter="HeaderActionRegion_MouseEnter"
                    MouseLeave="HeaderActionRegion_MouseLeave">
              <Grid>
              <StackPanel x:Name="HeaderActions"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          Style="{StaticResource HeaderActionsHostStyle}">
                <Button x:Name="UpdateButton"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        ToolTip="检查更新"
                        AutomationProperties.Name="检查更新"
                        Click="UpdateButton_Click">
                  <!-- 「横杠+向上箭头」填充图标：直译「升入新版本」；填充规范=Viewbox 16×16 +
                       Path Fill 绑定按钮前景（与齿轮/图钉同一规范，自动纳入
                       HeaderActionIcons_AreCenteredAndOpticallyConsistent 全量扫描）。
                       几何铺满 20×20 网格跨度（与齿轮 19.2 同量级）：Viewbox 渲染尺寸跟随
                       缩放后的子内容（探针实测），非正方形跨度会让墨迹宽高失衡；
                       双态文案与强调色由 MainWindow.Updates 按“本地版本 < 远端版本”派生。 -->
                  <Viewbox Width="16" Height="16">
                    <Path Data="M12,2 L20.5,10.5 L15.2,10.5 L15.2,17 L8.8,17 L8.8,10.5 L3.5,10.5 Z M2,19.4 L22,19.4 L22,22 L2,22 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          Stretch="Uniform" />
                  </Viewbox>
                </Button>

                <Button x:Name="PanelHoldButton"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        ToolTip="保持展开，暂停自动收起"
                        AutomationProperties.Name="保持展开，暂停自动收起"
                        Click="PanelHoldButton_Click">
                  <!-- 「贴缘面板」语汇：全高竖线=屏幕右缘，左侧垂直居中的扁长方形=展开的面板，
                       面板贴住右缘即保持展开（应用「面板贴屏幕右缘」布局的微缩图）；
                       长方形右长边由竖线兼任、墨迹高约为竖线三分之一。
                       描边图标显式 14.5×14.5 + 1.5 描边，与恢复默认按钮同一规范。 -->
                  <Path Data="M10.5,0 L10.5,14.5 M10.5,5 L4,5 L4,9.5 L10.5,9.5"
                        Width="14.5"
                        Height="14.5"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" />
                </Button>

                <Button x:Name="EdgeHideButton"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        ToolTip="一次性移出屏幕：鼠标离开后收进屏幕边缘，移回原位自动展开"
                        AutomationProperties.Name="一次性移出屏幕：鼠标离开后收进屏幕边缘，移回原位自动展开"
                        Click="EdgeHideButton_Click">
                  <!-- 「箭头收入右缘」语汇（→|）：箭头指向右缘竖线，直译一次性贴边隐藏；
                       描边图标显式 14.5×14.5 + 1.5 描边（光学足印约 16 DIP），与贴缘面板/搜索/恢复默认按钮同一规范。 -->
                  <Path Data="M3,12 L15,12 M11,8 L15,12 L11,16 M19,5 L19,19"
                        Width="14.5"
                        Height="14.5"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" />
                </Button>

                <Button x:Name="SearchButton"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        ToolTip="搜索当前分类"
                        AutomationProperties.Name="搜索当前分类"
                        AutomationProperties.AccessKey="Ctrl+F"
                        Click="SearchButton_Click">
                  <!-- 放大镜描边图标:与贴缘面板/恢复按钮同一 14.5×14.5 + 1.5 描边规范。 -->
                  <Path Data="M10.25,3.25 C6.38,3.25 3.25,6.38 3.25,10.25 C3.25,14.12 6.38,17.25 10.25,17.25 C14.12,17.25 17.25,14.12 17.25,10.25 C17.25,6.38 14.12,3.25 10.25,3.25 Z M15,15 L20.75,20.75"
                        Width="14.5"
                        Height="14.5"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" />
                </Button>

                <Button x:Name="SettingsButton"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        ToolTip="设置"
                        AutomationProperties.Name="设置"
                        Click="SettingsButton_Click">
                  <Viewbox Width="16" Height="16">
                    <Path Data="M19.14,12.94 C19.18,12.64 19.2,12.32 19.2,12 C19.2,11.68 19.18,11.36 19.13,11.06 L21.16,9.48 C21.34,9.34 21.39,9.07 21.28,8.87 L19.36,5.55 C19.24,5.33 18.99,5.26 18.77,5.33 L16.38,6.29 C15.88,5.91 15.35,5.59 14.76,5.35 L14.4,2.81 C14.36,2.57 14.16,2.4 13.92,2.4 L10.08,2.4 C9.84,2.4 9.65,2.57 9.61,2.81 L9.25,5.35 C8.66,5.59 8.12,5.92 7.63,6.29 L5.24,5.33 C5.02,5.25 4.77,5.33 4.65,5.55 L2.74,8.87 C2.62,9.08 2.66,9.34 2.86,9.48 L4.89,11.06 C4.84,11.36 4.8,11.68 4.8,12 C4.8,12.32 4.82,12.64 4.87,12.94 L2.84,14.52 C2.66,14.66 2.61,14.93 2.72,15.13 L4.64,18.45 C4.76,18.67 5.01,18.74 5.23,18.67 L7.62,17.71 C8.12,18.09 8.65,18.41 9.24,18.65 L9.6,21.19 C9.64,21.43 9.84,21.6 10.08,21.6 L13.92,21.6 C14.16,21.6 14.36,21.43 14.39,21.19 L14.75,18.65 C15.34,18.41 15.88,18.09 16.37,17.71 L18.76,18.67 C18.98,18.75 19.23,18.67 19.35,18.45 L21.27,15.13 C21.39,14.91 21.34,14.66 21.15,14.52 L19.14,12.94 Z M12,15.6 C10.02,15.6 8.4,13.98 8.4,12 C8.4,10.02 10.02,8.4 12,8.4 C13.98,8.4 15.6,10.02 15.6,12 C15.6,13.98 13.98,15.6 12,15.6 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          Stretch="Uniform" />
                  </Viewbox>
                </Button>

                <Button x:Name="ResetWindowButton"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        ToolTip="恢复默认尺寸和位置"
                        AutomationProperties.Name="恢复默认尺寸和位置"
                        Click="ResetWindowButton_Click">
                  <!-- 描边图标不走 Viewbox：Viewbox 会把几何放大到满 16×16 并同步放大描边，
                       光学足印与描边粗细失控；显式 14.5×14.5 + 1.5 描边使墨迹约 16 DIP，
                       与齿轮等填充图标的光学尺寸一致。 -->
                  <Path Data="M4,9 L4,4 L9,4 M15,9 L15,4 L10,4 M4,10 L4,15 L9,15 M15,10 L15,15 L10,15"
                        Width="14.5"
                        Height="14.5"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" />
                </Button>

                <Button x:Name="BatchPinButton"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        ToolTip="置顶已选内容"
                        AutomationProperties.Name="置顶已选内容"
                        AutomationProperties.AccessKey="Ctrl+P"
                        Foreground="{DynamicResource AccentBrush}"
                        Visibility="Collapsed"
                        Click="BatchPinButton_Click">
                  <Viewbox Width="16" Height="16">
                    <Path Data="M10.1221,3.13715 C10.7326,1.91616 12.3599,1.65208 13.3251,2.61737 L17.382,6.67419 C18.3472,7.63947 18.0832,9.26676 16.8622,9.87726 L13.4037,11.6065 C13.0751,11.7708 12.8183,12.0499 12.6818,12.391 L11.2459,15.981 C10.9792,16.6476 10.1179,16.8244 9.61027,16.3167 L7,13.7064 L3.70711,16.9993 L3,17 L3,16.2922 L6.29289,12.9993 L3.68262,10.3891 C3.17498,9.88142 3.35177,9.02011 4.01834,8.75348 L7.60829,7.3175 C7.94939,7.18106 8.22855,6.92419 8.39285,6.5956 L10.1221,3.13715 Z M12.618,3.32447 C12.1354,2.84183 11.3217,2.97387 11.0165,3.58437 L9.28727,7.04282 C9.01345,7.59046 8.54818,8.01858 7.97968,8.24598 L4.38973,9.68196 L10.3174,15.6096 L11.7534,12.0197 C11.9808,11.4512 12.4089,10.9859 12.9565,10.7121 L16.415,8.98283 C17.0255,8.67758 17.1575,7.86394 16.6749,7.3813 L12.618,3.32447 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          Stretch="Uniform" />
                  </Viewbox>
                </Button>

                <Button x:Name="DeleteContentButton"
                        ToolTip="左键清空非置顶，右键清空全部"
                        AutomationProperties.Name="左键清空非置顶，右键清空全部"
                        Foreground="{DynamicResource DangerBrush}"
                        Click="DeleteContentButton_Click"
                        MouseRightButtonUp="DeleteContentButton_MouseRightButtonUp">
                  <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource HeaderActionButtonStyle}">
                      <Setter Property="Padding" Value="5" />
                      <!-- IsEnabled 按激活表面由代码侧管理（#30 修订 2026-10-18，
                           Issue #186）：内容桶=无内容禁用（UpdatePanelSurface）；
                           启动表面=有选择启用「删除已选 N 项」（原 DataTrigger 以
                           ActivePanel.Items.Count 判定，启动分类 board 集合恒空＝
                           启动多选垃圾桶被结构性禁用，实机点不动）。 -->
                    </Style>
                  </Button.Style>
                  <!-- 图标始终居中（与其他头部按钮同一 16×16 网格规范）；
                       计数徽章仍锚定内容格右下角，出现时覆盖图标右下象限，图标位置不随徽章显隐跳动。 -->
                  <Grid Width="20" Height="20">
                    <Viewbox Width="16"
                             Height="16"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                      <Path Data="M8.5,4 L11.5,4 C11.5,3.17157 10.8284,2.5 10,2.5 C9.17157,2.5 8.5,3.17157 8.5,4 Z M7.5,4 C7.5,2.61929 8.61929,1.5 10,1.5 C11.3807,1.5 12.5,2.61929 12.5,4 L17.5,4 C17.7761,4 18,4.22386 18,4.5 C18,4.77614 17.7761,5 17.5,5 L16.4456,5 L15.2521,15.3439 C15.0774,16.8576 13.7957,18 12.2719,18 L7.72813,18 C6.20431,18 4.92256,16.8576 4.7479,15.3439 L3.55437,5 L2.5,5 C2.22386,5 2,4.77614 2,4.5 C2,4.22386 2.22386,4 2.5,4 L7.5,4 Z M5.74131,15.2292 C5.85775,16.2384 6.71225,17 7.72813,17 L12.2719,17 C13.2878,17 14.1422,16.2384 14.2587,15.2292 L15.439,5 L4.56101,5 Z M8.5,7.5 C8.77614,7.5 9,7.72386 9,8 L9,14 C9,14.2761 8.77614,14.5 8.5,14.5 C8.22386,14.5 8,14.2761 8,14 L8,8 C8,7.72386 8.22386,7.5 8.5,7.5 Z M12,8 C12,7.72386 11.7761,7.5 11.5,7.5 C11.2239,7.5 11,7.72386 11,8 L11,14 C11,14.2239 11.2239,14.5 11.5,14.5 C11.7761,14.5 12,14.2761 12,14 L12,8 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          Stretch="Uniform" />
                    </Viewbox>
                      <Border x:Name="SelectedCountBadge"
                              Width="14"
                              Height="14"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Background="{DynamicResource AccentBrush}"
                              CornerRadius="{StaticResource SelectedCountBadgeCornerRadius}"
                              IsHitTestVisible="False"
                              Opacity="0"
                              Visibility="Collapsed">
                      <Viewbox Margin="2"
                               Stretch="Uniform"
                               StretchDirection="DownOnly">
                        <TextBlock x:Name="SelectedCountText"
                                   Foreground="{DynamicResource OnAccentBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   TextOptions.TextFormattingMode="Display"
                                   TextAlignment="Center" />
                      </Viewbox>
                    </Border>
                  </Grid>
                </Button>
              </StackPanel>

              <!-- 搜索态头部：与 HeaderActions 同区互斥显示（代码后置切换可见性）。
                   输入框 + 类型 chip（都不选或都选 = 全部）+ 清空 + 关闭。 -->
              <Grid x:Name="SearchBar"
                    Visibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Margin="6,0,8,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="110" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,6,0">
                  <TextBox x:Name="SearchInput"
                           Style="{StaticResource ThemedTextBoxStyle}"
                           Height="24"
                           VerticalContentAlignment="Center"
                           Padding="6,0"
                           FontSize="12"
                           TextChanged="SearchInput_TextChanged"
                           PreviewKeyDown="SearchInput_PreviewKeyDown" />
                  <TextBlock x:Name="SearchInputHint"
                             Text="搜索当前分类"
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Visibility="Collapsed" />
                </Grid>
                <ToggleButton x:Name="SearchImageChip"
                              Grid.Column="1"
                              Content="图片"
                              FontSize="11"
                              Padding="6,1"
                              Margin="0,0,4,0"
                              Style="{StaticResource ThemedFilterChipStyle}"
                              Click="SearchChip_Click" />
                <ToggleButton x:Name="SearchTextChip"
                              Grid.Column="2"
                              Content="文本"
                              FontSize="11"
                              Padding="6,1"
                              Margin="0,0,6,0"
                              Style="{StaticResource ThemedFilterChipStyle}"
                              Click="SearchChip_Click" />
                <Button x:Name="SearchClearButton"
                        Grid.Column="3"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        ToolTip="清空条件"
                        AutomationProperties.Name="清空条件"
                        Margin="0,0,2,0"
                        Click="SearchClearButton_Click">
                  <Path Data="M4,4 L12,12 M12,4 L4,12"
                        Width="12"
                        Height="12"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                </Button>
                <Button x:Name="SearchCloseButton"
                        Grid.Column="4"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        ToolTip="退出搜索"
                        AutomationProperties.Name="退出搜索"
                        Click="SearchCloseButton_Click">
                  <Path Data="M5,5 L15,15 M15,5 L5,15"
                        Width="12"
                        Height="12"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                </Button>
              </Grid>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <ListBox x:Name="BoardList"
                 Grid.Row="1"
                 ItemsSource="{Binding ActivePanel.Items}"
                 ItemContainerStyle="{StaticResource BoardListItemStyle}"
                 Style="{StaticResource BoardListStyle}"
                 SelectionMode="Multiple"
                 SelectionChanged="BoardList_SelectionChanged"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="BoardList_PreviewMouseLeftButtonDown"
                 PreviewMouseLeftButtonUp="BoardList_PreviewMouseLeftButtonUp"
                 PreviewMouseMove="BoardList_PreviewMouseMove"
                 PreviewDragOver="BoardList_PreviewDragOver"
                 PreviewDragLeave="BoardList_PreviewDragLeave"
                 PreviewDrop="BoardList_PreviewDrop"
                 ButtonBase.Click="BoardList_ButtonClick"
                 PreviewMouseRightButtonDown="BoardList_PreviewMouseRightButtonDown"
                 PreviewMouseRightButtonUp="BoardList_PreviewMouseRightButtonUp"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.Resources>
            <!-- 作用域隐式样式：BoardList 模板内部生成的 ScrollViewer 改用 overlay 模板
                 （单格叠加，滚动条悬浮内容之上不占布局列），viewport 几何与滚动条可见性
                 解耦——卡片几何不再随滚动条出现/消失漂移。keyed 样式 + 列表作用域挂接，
                 不做全局隐式样式（避免波及复盘编辑器等其余 ScrollViewer 表面）。 -->
            <Style TargetType="ScrollViewer" BasedOn="{StaticResource OverlayScrollViewerStyle}" />
          </ListBox.Resources>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>

        <!-- 搜索空态：无匹配时居中提示 + 一键清空（代码后置切换可见性）。 -->
        <Border x:Name="SearchEmptyHint"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="Transparent"
                IsHitTestVisible="True">
          <StackPanel Orientation="Vertical"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <TextBlock Text="无匹配结果"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />
            <Button x:Name="SearchClearFilterButton"
                    Content="清空筛选"
                    FontSize="12"
                    Padding="10,3"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Click="SearchClearFilterButton_Click" />
          </StackPanel>
        </Border>

        <!-- 内容桶空态引导（契约 #33，复用 LauncherEmptyState 先例：图标＋标题＋
             副文案，内容区垂直居中，无 CTA——内容桶的进入路径是复制/拖入，无显式
             添加动作）。可见性与文案由 UpdatePanelSurface 表面单点＋激活桶集合
             变化管理；文案按 (BoardCategory, IsDefaultCapture) 二维矩阵派生（默认
             接收桶＝复制自动收集，非默认桶＝拖入收集）。纯信息性：IsHitTestVisible=
             False 让拖放与点击命中穿透回 BoardList（兄弟层不截获隧道事件）。搜索态
             让位给 SearchEmptyHint（无匹配语义）。 -->
        <StackPanel x:Name="BoardEmptyState"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
          <TextBlock HorizontalAlignment="Center"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     FontSize="36"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="&#xE8C8;" />
          <TextBlock x:Name="BoardEmptyStateTitle"
                     Margin="0,10,0,2"
                     HorizontalAlignment="Center"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     Text="还没有内容" />
          <TextBlock x:Name="BoardEmptyStateHint"
                     HorizontalAlignment="Center"
                     FontSize="12"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="把内容拖到这里即可收集" />
        </StackPanel>

        <Border x:Name="ReviewContentHost"
                Grid.Row="1"
                Padding="12,8,12,10"
                Background="Transparent"
                Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- 日期导航仅保留 ‹ › 一步切一天（原日期下拉对绝大多数用户只有一项，已移除；
                 日期文本靠右对齐保持原下拉区域的位置语义）。 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="ReviewPreviousButton"
                      Grid.Column="0"
                      Style="{StaticResource ThemedNavButtonStyle}"
                      ToolTip="上一天"
                      AutomationProperties.Name="上一天"
                      Click="ReviewPreviousButton_Click">
                <!-- 日期导航用矢量 chevron 替代字符 ‹ ›：文本 ContentPresenter 居中的是
                     行框（ascent/descent 空白）与字宽，不是字形墨迹，符号必然偏离按钮
                     中心。几何按最终尺寸绘制并让含描边墨迹贴住原点（墨迹盒恰为
                     0,0–8,15，光学足印 15×8 DIP 与头部描边图标同量级）：WPF 对
                     Stretch=None 的 Shape 不把几何重定位到元素原点（元素=几何右下角
                     +半描边），墨迹贴原点时元素布局尺寸=墨迹盒且墨迹对称充满元素，
                     ContentPresenter 居中的就是墨迹本身——几何居中=视觉居中；
                     Stretch=Uniform 在纵横比与画布不一致时元素盒与墨迹盒不对称，弃用。
                     右向为左向几何的镜像。 -->
                <Path Data="M7.25,0.75 L0.75,7.5 L7.25,14.25"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
              </Button>
              <Button x:Name="ReviewNextButton"
                      Grid.Column="1"
                      Style="{StaticResource ThemedNavButtonStyle}"
                      Margin="4,0,0,0"
                      ToolTip="下一天"
                      AutomationProperties.Name="下一天"
                      Click="ReviewNextButton_Click">
                <Path Data="M0.75,0.75 L7.25,7.5 L0.75,14.25"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
              </Button>
              <TextBlock x:Name="ReviewDateState"
                         Grid.Column="2"
                         Margin="8,0,0,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Text="今天" />
            </Grid>
            <TextBox x:Name="ReviewEditor"
                     Grid.Row="1"
                     Style="{StaticResource ThemedTextBoxStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalContentAlignment="Top"
                     Padding="12"
                     FontSize="14"
                 TextOptions.TextFormattingMode="Display"
                 TextChanged="ReviewEditor_TextChanged"
                 KeyDown="ReviewEditor_KeyDown"
                 LostKeyboardFocus="ReviewEditor_LostKeyboardFocus"
                 AutomationProperties.Name="每日复盘编辑器" />
            <TextBlock x:Name="ReviewStatus"
                       Grid.Row="2"
                       Margin="2,8,2,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="今天还没有复盘内容。" />
          </Grid>
        </Border>

        <!-- 快捷启动表面（#30 修订 2026-10-18，Issue #186）：瓦片网格宿主，与 BoardList
             同格互斥（UpdatePanelSurface 三态分发）。工具行 40 DIP（右：＋添加；对齐
             图片/待分类卡片范式后无编辑模式——改名/删除/拖拽由瓦片常态手势承载）；
             内容区为空态或瓦片网格；文件拖入分流与放置态（2px accent 描边 + 8% 填充
             + 「松开以添加」）。 -->
        <Border x:Name="LauncherContentHost"
                Grid.Row="1"
                Padding="12,8,12,10"
                Background="Transparent"
                Visibility="Collapsed"
                AllowDrop="True"
                MouseLeftButtonDown="LauncherSurface_MouseLeftButtonDown"
                DragEnter="LauncherSurface_DragEnter"
                DragOver="LauncherSurface_DragOver"
                DragLeave="LauncherSurface_DragLeave"
                Drop="LauncherSurface_Drop">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 工具行：仅保留＋添加（编辑模式已移除，#30 修订 2026-10-18，Issue #186）。 -->
            <Grid x:Name="LauncherToolbar" Grid.Row="0" Height="40" Margin="0,0,0,4">
              <Button x:Name="LauncherAddButton"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Content="＋ 添加"
                      FontSize="12"
                      Padding="10,3"
                      Style="{StaticResource ThemedActionButtonStyle}"
                      AutomationProperties.Name="添加启动项"
                      Click="LauncherAddButton_Click" />
            </Grid>

            <!-- ＋ 添加两入口菜单（#30 切片 4）：应用文件… / 已安装应用…；定位锚点在
                 打开时按发起按钮（工具行＋或空态 CTA）指定，右对齐经 HorizontalOffset 校正。
                 Opened/Closed 接状态机覆盖交互 hold：菜单是独立 HWND，指针移入即假
                 MouseLeave，打开期间收起链被抑制、关闭后按指针几何位置重估。 -->
            <Popup x:Name="LauncherAddMenu"
                   Grid.Row="0"
                   PlacementTarget="{Binding ElementName=LauncherAddButton}"
                   Placement="Bottom"
                   VerticalOffset="2"
                   StaysOpen="False"
                   PopupAnimation="Fade"
                   AllowsTransparency="True"
                   Focusable="False"
                   Opened="LauncherAddMenu_Opened"
                   Closed="LauncherAddMenu_Closed">
              <Border Background="{DynamicResource HeaderBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="7"
                      Padding="4"
                      Margin="12">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.25" />
                </Border.Effect>
                <StackPanel>
                  <Button x:Name="LauncherAddFileMenuButton"
                          Content="应用文件…"
                          Style="{StaticResource LauncherAddMenuButtonStyle}"
                          AutomationProperties.Name="添加应用文件"
                          Click="LauncherAddFileMenu_Click" />
                  <Button x:Name="LauncherAddInstalledMenuButton"
                          Content="已安装应用…"
                          Style="{StaticResource LauncherAddMenuButtonStyle}"
                          AutomationProperties.Name="添加已安装应用"
                          Click="LauncherAddInstalledMenu_Click" />
                  <Button x:Name="LauncherAddUrlMenuButton"
                          Content="网页地址…"
                          Style="{StaticResource LauncherAddMenuButtonStyle}"
                          AutomationProperties.Name="添加网页地址"
                          Click="LauncherAddUrlMenu_Click" />
                </StackPanel>
              </Border>
            </Popup>

            <!-- 空态：内容区垂直居中（插图 + 标题 + 副文案 + CTA，CTA 与工具行＋同一入口）。 -->
            <StackPanel x:Name="LauncherEmptyState"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Visible">
              <TextBlock HorizontalAlignment="Center"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         FontSize="36"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Text="&#xE71D;" />
              <TextBlock Margin="0,10,0,2"
                         HorizontalAlignment="Center"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         Text="还没有启动项" />
              <TextBlock Margin="0,0,0,12"
                         HorizontalAlignment="Center"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Text="把 .exe 或快捷方式拖到这里，或点右上角 ＋ 添加" />
              <Button HorizontalAlignment="Center"
                      Content="添加应用"
                      FontSize="12"
                      Padding="14,5"
                      Style="{StaticResource ThemedActionButtonStyle}"
                      AutomationProperties.Name="添加应用"
                      Click="LauncherAddButton_Click" />
            </StackPanel>

            <!-- 瓦片网格：垂直滚动 + overlay 瘦条（契约 #23 口径，不占布局宽）；不虚拟化
                 （有界性以 200 上限承载）。拉伸填充单一几何源（#30 修订 2026-10-18，
                 Issue #186）：列数/瓦片宽由 LauncherTilePanel 内经 LauncherGridMath 从
                 视口宽现算并自行排版（行满排总宽=视口、无死区、末行左对齐），网格不设
                 Width、不居中——ScrollChanged 回写自身 Width 的自引用结构已消灭。 -->
            <ScrollViewer x:Name="LauncherScroll"
                          Grid.Row="1"
                          Style="{StaticResource OverlayScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="LauncherScroll_ScrollChanged"
                          Visibility="Collapsed">
              <ItemsControl x:Name="LauncherTileGrid"
                            HorizontalAlignment="Stretch"
                            Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <views:LauncherTilePanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type models:LauncherItem}">
                    <!-- 瓦片几何（高 100、沟道 8、宽=视口摊分）由 LauncherTilePanel 排版
                         承载（DesignTokens 同源经 LauncherGridMath）；瓦片根不再自带
                         Width/Height/Margin。悬停 167ms/-2px 与按压 83ms/0.96 走既有
                         动画体系；启动确认/失败描边/重复脉冲为代码驱动的场景动画。
                         分区手势（#30 修订 2026-10-18，Issue #186）：启动区（图标格，
                         Tag=LauncherLaunchZone）单击=启动；名称带（Tag=LauncherNameZone）
                         单击=聚焦、双击=就地改名；右上勾选钮多选。区域判定沿可视树
                         Tag 路径（与卡片对半分区同机制族，CardGestureZones）。 -->
                    <Border x:Name="TileRoot"
                            Padding="6,8,6,8"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            RenderTransformOrigin="0.5,0.5"
                            MouseEnter="LauncherTile_MouseEnter"
                            MouseLeave="LauncherTile_MouseLeave"
                            MouseLeftButtonDown="LauncherTile_MouseLeftButtonDown"
                            MouseLeftButtonUp="LauncherTile_MouseLeftButtonUp"
                            PreviewMouseMove="LauncherTile_PreviewMouseMove"
                            ContextMenuOpening="LauncherTile_ContextMenuOpening"
                            GiveFeedback="LauncherTile_GiveFeedback"
                            QueryContinueDrag="LauncherTile_QueryContinueDrag">
                      <Border.RenderTransform>
                        <TransformGroup>
                          <TranslateTransform />
                          <ScaleTransform />
                        </TransformGroup>
                      </Border.RenderTransform>
                      <Border.ContextMenu>
                        <!-- 查看态瓦片右键均可用；端点禁用在 Opening 时按当前
                             下标设定；打开期间挂覆盖交互 Menu hold（不自动收起）。
                             终序（#30 修订 2026-10-18，Issue #186）：打开/重命名/
                             编辑目标…/上移/下移/删除（删除独立分组）。 -->
                        <ContextMenu x:Name="TileContextMenu"
                                     Style="{StaticResource LauncherTileContextMenuStyle}"
                                     Opened="LauncherTile_ContextMenuOpened"
                                     Closed="LauncherTile_ContextMenuClosed">
                          <MenuItem x:Name="TileMenuOpen"
                                    Header="打开"
                                    Style="{StaticResource LauncherContextMenuItemStyle}"
                                    AutomationProperties.Name="打开启动项"
                                    Click="LauncherTileMenuOpen_Click" />
                          <MenuItem x:Name="TileMenuRename"
                                    Header="重命名"
                                    Style="{StaticResource LauncherContextMenuItemStyle}"
                                    AutomationProperties.Name="重命名启动项"
                                    Click="LauncherTileMenuRename_Click" />
                          <MenuItem x:Name="TileMenuEditTarget"
                                    Header="编辑目标…"
                                    Style="{StaticResource LauncherContextMenuItemStyle}"
                                    AutomationProperties.Name="编辑启动项目标"
                                    Click="LauncherTileMenuEditTarget_Click" />
                          <MenuItem x:Name="TileMenuMoveUp"
                                    Header="上移"
                                    Style="{StaticResource LauncherContextMenuItemStyle}"
                                    AutomationProperties.Name="上移启动项"
                                    Click="LauncherTileMenuMoveUp_Click" />
                          <MenuItem x:Name="TileMenuMoveDown"
                                    Header="下移"
                                    Style="{StaticResource LauncherContextMenuItemStyle}"
                                    AutomationProperties.Name="下移启动项"
                                    Click="LauncherTileMenuMoveDown_Click" />
                          <Separator Style="{StaticResource LauncherContextMenuSeparatorStyle}" />
                          <MenuItem x:Name="TileMenuDelete"
                                    Header="删除"
                                    Style="{StaticResource LauncherContextMenuDangerItemStyle}"
                                    AutomationProperties.Name="删除启动项"
                                    Click="LauncherTileMenuDelete_Click" />
                        </ContextMenu>
                      </Border.ContextMenu>
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                          <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding LaunchFailed}" Value="True">
                              <!-- 失败灰态：2px 危险色描边常显 + 图标 50% + 警告角标。 -->
                              <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                              <!-- 多选态（#30 修订 2026-10-18）：选中底色对齐卡片范式
                                   （SelectedCardBrush），焦点描边（accent）独立并存。 -->
                              <Setter Property="Background" Value="{DynamicResource SelectedCardBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"
                              Width="48"
                              Height="48"
                              Margin="0,0,0,6"
                              HorizontalAlignment="Center"
                              Background="Transparent"
                              Tag="{x:Static views:CardGestureZones.LauncherLaunchZone}">
                          <!-- 启动区（#30 修订 2026-10-18）：单击=启动（选择非空时挂起改
                               toggle）；拖拽仅从此区发起。图标槽按 Kind 分支（#30 修订，
                               Issue #179）：应用/打包应用走既有「占位字形 + Image 提取链」
                               模板；Url 渲染静态地球字形——模板选择保证 Url 分支不实例化
                               Image，图标管线零触达（URL 的 IconKey 是非空垃圾哈希，且
                               NormalizeTarget 是 DedupKey 组成部分，两条既有陷阱由此
                               根治）。失败灰态在瓦片 Border 层 DataTrigger 统一覆盖，
                               两分支同受。 -->
                          <ContentControl Focusable="False"
                                          Content="{Binding}">
                            <ContentControl.Style>
                              <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource LauncherTileAppIconTemplate}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Kind}" Value="Url">
                                    <Setter Property="ContentTemplate" Value="{StaticResource LauncherTileUrlGlyphTemplate}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </ContentControl.Style>
                          </ContentControl>
                        </Grid>
                        <!-- 名称带（#30 修订 2026-10-18）：底部整带命中，单击=不启动仅
                             聚焦、双击=就地改名（DoubleClickWindow 系统时限）；悬停轻微
                             底色提示可双击；选择非空时单击改 toggle。 -->
                        <Border x:Name="TileNameBand"
                                Grid.Row="1"
                                Padding="0,2,0,2"
                                CornerRadius="4"
                                Tag="{x:Static views:CardGestureZones.LauncherNameZone}">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="Transparent" />
                              <Style.Triggers>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsEditingName}" Value="False" />
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid>
                            <!-- 名称 12px 两行（行高 16、CharacterEllipsis、tooltip 全名）；
                                 就地改名时被编辑器（DraftName 两行对齐）替换。 -->
                            <TextBlock x:Name="TileNameText"
                                       MaxHeight="32"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       LineHeight="16"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="{Binding DisplayName}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding ToolTipText}" />
                            <!-- 就地改名编辑器（名称带双击/F2/菜单进入；Enter 提交/
                                 Esc 取消/失焦提交；空提交=回退原名；IME 组合守卫与
                                 卡片编辑同族；Explicit 绑定修复保持——1.49.1 键入
                                 不生效根因修复，契约锁定）。 -->
                            <TextBox x:Name="TileNameEditor"
                                     MaxHeight="32"
                                     FontSize="12"
                                     TextBlock.LineHeight="16"
                                     TextBlock.LineStackingStrategy="BlockLineHeight"
                                     MaxLength="64"
                                     Padding="2,0"
                                     Text="{Binding DraftName, UpdateSourceTrigger=Explicit}"
                                     TextAlignment="Center"
                                     TextWrapping="Wrap"
                                     Visibility="Collapsed"
                                     LostFocus="LauncherTileNameEditor_LostFocus"
                                     PreviewKeyDown="LauncherTileNameEditor_PreviewKeyDown" />
                          </Grid>
                        </Border>
                        <!-- 警告角标（失败灰态）。 -->
                        <Border x:Name="TileFailedBadge"
                                Width="16"
                                Height="16"
                                Margin="0,0,2,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource DangerBrush}"
                                CornerRadius="8"
                                Visibility="Collapsed">
                          <TextBlock HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="11"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource OnAccentBrush}"
                                     Text="!" />
                        </Border>
                        <!-- 右上勾选钮（#30 修订 2026-10-18，Issue #186）：多选入口，
                             悬停∨选中∨键盘聚焦可见（视觉复用 SelectionButtonStyle，
                             绑定面按瓦片改写）；点击 toggle 该瓦片选中。 -->
                        <Button x:Name="TileSelectButton"
                                Margin="0,1,1,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="LauncherTileSelectButton_Click"
                                Style="{StaticResource LauncherTileSelectionButtonStyle}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- 放置态：松开以添加（2px accent 描边 + 8% 填充，描边层 167ms 淡入）。 -->
            <Border x:Name="LauncherDropHighlight"
                    Grid.Row="1"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Opacity="0"
                    IsHitTestVisible="False">
              <Border Background="{DynamicResource AccentBrush}" Opacity="0.08" CornerRadius="6" />
            </Border>
            <TextBlock x:Name="LauncherDropHint"
                       Grid.Row="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="松开以添加"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />

            <!-- 删除安全网事务（#30 §三.7）：单条最新删除记录 + 4s 撤销提示条；
                 新删除替换旧记录（旧的不可再恢复，计时重置）；切标签/面板收起一起销毁。 -->
            <Border x:Name="LauncherUndoToast"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,6"
                    Padding="12,6"
                    Background="{DynamicResource StatusSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                    views:FadeAnimation.ManageVisibility="True"
                    views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.NormalDurationMs}">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="LauncherUndoToastText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="已删除" />
                <Button Margin="10,0,0,0"
                        Padding="8,2"
                        FontSize="12"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Content="撤销"
                        AutomationProperties.Name="撤销删除启动项"
                        Click="LauncherUndoToast_Click" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Canvas Grid.Row="1"
                Background="Transparent"
                IsHitTestVisible="False">
          <Border x:Name="InsertionIndicator"
                  Canvas.Left="0"
                  Canvas.Top="0"
                  Width="{Binding ActualWidth, ElementName=BoardList}"
                  Height="2"
                  Background="{DynamicResource AccentBrush}"
                  CornerRadius="1"
                  IsHitTestVisible="False"
                  Opacity="0"
                  Visibility="Collapsed"
                  views:FadeAnimation.AnimationsEnabled="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                  views:FadeAnimation.DurationMs="{x:Static design:DesignTokens.PressFeedbackMs}" />
        </Canvas>

        <Border x:Name="StatusOverlay"
                Grid.Row="1"
                Panel.ZIndex="2"
                Style="{StaticResource StatusOverlayStyle}">
          <TextBlock Text="{Binding StatusText}"
                     Style="{StaticResource StatusTextStyle}" />
        </Border>

        <Thumb Grid.RowSpan="2"
               Style="{StaticResource WidthResizeThumbStyle}"
               DragDelta="WidthThumb_DragDelta"
               DragCompleted="ResizeThumb_DragCompleted" />
        <Thumb Grid.Row="1"
               Style="{StaticResource HeightResizeThumbStyle}"
               DragDelta="HeightThumb_DragDelta"
               DragCompleted="ResizeThumb_DragCompleted" />
      </Grid>

      <Border x:Name="CategoryRail"
              Grid.Column="1"
              AllowDrop="True"
              DragEnter="CategoryRail_DragEnter"
              DragLeave="CategoryRail_DragLeave"
              DragOver="CategoryRail_DragOver"
              Drop="CategoryRail_Drop">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource RailSurfaceStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCategoryRailVisible}" Value="False">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <ItemsControl ItemsSource="{Binding Categories}"
                      ItemTemplate="{StaticResource CategoryTabTemplate}"
                      Background="Transparent">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="4" Columns="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Border>

      <ContentControl x:Name="CollapsedCategoryHandle"
                      Grid.Column="1"
                      Content="{Binding DefaultCapturePanel}"
                      ContentTemplate="{StaticResource CategoryTabTemplate}"
                      Background="{DynamicResource TabRailBrush}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                  <Border Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCollapsedCategoryHandleVisible}" Value="False">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>

      <Popup x:Name="CompactStatusPopup"
             PlacementTarget="{Binding ElementName=CategoryRail}"
             Placement="Left"
             HorizontalOffset="-8"
             AllowsTransparency="True"
             PopupAnimation="None"
             StaysOpen="True"
             IsHitTestVisible="False"
             Focusable="False">
        <Border Style="{StaticResource CompactStatusPopupStyle}">
          <TextBlock Text="{Binding StatusText}"
                     Style="{StaticResource StatusTextStyle}" />
        </Border>
      </Popup>

      <Border Grid.ColumnSpan="2"
              Panel.ZIndex="10"
              Style="{StaticResource WindowShellOutlineStyle}" />
    </Grid>
  </Border>
</Window>
