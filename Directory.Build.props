<Project>
  <PropertyGroup>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</Version>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!--
    SixLabors.ImageSharp 已知漏洞公告评审结论（2026-10-08 评审，2026-10-27 增补）：
    2026-10-27 增补：GHSA-v76p-62qx-wwq2（高危 CVSS 7.5，CVE-2026-106118，tiled TIFF
    fax 压缩【解码】越界堆写）——官方补丁版本 3.2.0/4.1.1 均已启用构建期许可强制
    （Six Labors Split License 免费线止于 3.1.x），升级＝购买/授权决策（维护者红线：
    不自行申请或绕过密钥校验）。本应用 .tif/.tiff 在图片输入白名单（拖入可达，
    影响类＝内存破坏，高于既往接受的 DoS 级），按 2026-10-08 框架经评审暂时接受
    风险并抑制：与已发行 1.62.0 同一二进制依赖、不因本次发行引入回归；既有
    ImageInputLimits（64 MiB/6400 万像素/512 MiB 缓冲）对攻击文件尺寸构成部分约束。
    解除路径（待裁决，见 observations OBS-20261027C）：①Six Labors 授权 → 升级
    3.2.0+；②产品决策移除 .tif/.tiff 白名单条目（向量转不可达）；③迁移他库。
    下列公告的修复版本均为 ImageSharp 4.1.2，而 4.x 为商业授权（构建期强制 license key），
    3.x 无对应补丁，经评审暂时接受风险并在此集中抑制（对全部工程生效）：
    - GHSA-jjfr-hcj7-qf5w / GHSA-j9gm-c75j-xc9q（高危，TIFF CCITT T6/T4 编码器越界写）：
      本应用唯一输出编码是 PNG（ImageNormalizer.SaveAsPngAsync / WPF PngBitmapEncoder），
      从不编码 TIFF，向量不可达。
    - GHSA-j3p4-wp97-rph4（高危，HistogramEqualization 未校验亮度索引）：全仓无任何
      Histogram 操作调用，向量不可达。
    - GHSA-wmxv-xphr-5c9g（中危，BigTIFF IFD 解码不进展循环）与 GHSA-gwg2-r3hj-4w44
      （中危，ICC CLUT 解析按未校验维度分配内存）：仅恶意拖入图片可触发，影响均为
      DoS 级（解码线程空转 / 过量分配），无内存破坏或数据泄露；既有编码长度与尺寸
      上限（ImageInputLimits）提供部分约束。待 ImageSharp 4 授权或迁移方案确定后
      解除抑制。
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
  </ItemGroup>
</Project>
